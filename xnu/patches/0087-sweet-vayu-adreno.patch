+/* kgsl_hfi.h */
+struct hfi_qhdr {
+	uint32_t status, start_addr, type, queue_size, msg_size, drop_cnt;
+	uint32_t rx_wm, tx_wm, rx_req, tx_req, read_index, write_index;
+};
+struct hfi_qtbl {
+	uint32_t version, size, qhdr0_offset, qhdr_size, num_q, num_active_q;
+	struct hfi_qhdr q[4];
+};
+#define HFI_QUEUE_AT(i)         (((uint32_t)sizeof(struct hfi_qtbl) + 15u) / 16u * 16u + 4096u * (i))
