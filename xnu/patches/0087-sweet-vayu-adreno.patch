--- /dev/null
+++ b/bsd/dev/sweet_adreno.c
@@ -0,0 +1,315 @@
+/*
+ * SWEET vayu (SM8150, Adreno 640): GPU bring-up, milestone 1 - is the GPU block reachable.
+ * Steps after HakiOS hakios.adreno.c (oosexgang/hackios-xnu-kernel, APSL 2.0, steps 1-6 and 11),
+ * with the numbers of this SoC: vayu device tree (kgsl-3d0@2c00000 chipid 0x06040001, gmu@2c6a000,
+ * gpucc@2c90000, gpu_cx_gdsc 0x2c9106c, kgsl-smmu@2ca0000, kgsl-hyp pas-id 13) and the vendor
+ * 4.14 kernel (drivers/clk/qcom/gcc-sm8150.c, gpucc-sm8150.c, drivers/gpu/msm kgsl a6xx).
+ *
+ * Boot-arg sweetgpu=N runs steps 1..N (default 0: off); sweetgpudelay=S start delay (40 s, so
+ * iOS is up first). Each step is announced and followed by a 3 s pause so the persistent log
+ * (ufslogsecs) holds the last line if an access hangs the SoC.
+ *   1 read: GCC GPU branch clocks, GPU_CC clocks, both GPU GDSCs
+ *   2 GCC: vote the GPLL0 outputs for the GPU, enable cfg-ahb, memnoc, snoc-dvm, ddrss-axi
+ *   3 GPU_CC: cxo, ahb; CX GDSC on (clear SW_COLLAPSE, wait PWR_ON)
+ *   4 GPU_CC: GMU clock 200 MHz from GPLL0 main div (/1.5), cx-gmu and cx-snoc-dvm branches
+ *   5 GMU: always-on counter read twice 20 ms apart - about 19.2 MHz means the block is alive
+ *     (an Adreno has no chip-id register; identity is the device tree's)
+ *   6 SMMU (MMU-500): ID registers 0..2 - the hypervisor may emulate or refuse them
+ *   7 TrustZone: is "is call available" available; PAS is-supported for image 13 (zap shader)
+ * Nothing powers GX, starts the GMU or changes a voltage; the CX rail is the SoC's, already on.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach declaration not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+void sweet_adreno_init(void);
+
+#define GPU_GCC_PA      0x00100000u
+#define GPU_GCC_SIZE    0x00090000u
+#define GPU_CC_PA       0x02c90000u
+#define GPU_CC_SIZE     0x00009000u
+#define GPU_GMU_PA      0x02c6a000u
+#define GPU_GMU_SIZE    0x00030000u
+#define GPU_SMMU_PA     0x02ca0000u
+#define GPU_SMMU_SIZE   0x00010000u
+
+/* gcc-sm8150.c */
+#define GCC_APCS_VOTE2          0x52004u        /* BIT(15) gpu_gpll0, BIT(16) gpu_gpll0_div */
+#define GCC_GPU_CFG_AHB         0x71004u
+#define GCC_GPU_MEMNOC_GFX      0x7100cu
+#define GCC_GPU_SNOC_DVM_GFX    0x71018u
+#define GCC_DDRSS_GPU_AXI       0x71154u
+/* gpucc-sm8150.c */
+#define GPUCC_GX_GDSCR          0x100cu
+#define GPUCC_CX_GDSCR          0x106cu
+#define GPUCC_AHB               0x1078u
+#define GPUCC_CX_SNOC_DVM       0x108cu
+#define GPUCC_CX_GMU            0x1098u
+#define GPUCC_CXO               0x109cu
+#define GPUCC_GMU_RCG_CMD       0x1120u         /* cfg at +4 */
+/* clk-branch / gdsc / clk-rcg2 bits */
+#define CBCR_CLK_OFF            (1u << 31)
+#define CBCR_HW_CTL             (1u << 1)
+#define CBCR_ENABLE             (1u << 0)
+#define GDSC_PWR_ON             (1u << 31)
+#define GDSC_SW_COLLAPSE        (1u << 0)
+#define RCG_UPDATE              (1u << 0)
+/* GMU registers: kgsl a6xx_reg.h word offsets from the GPU base, GMU block starts at word 0x1a800 */
+#define GMU_REG(w)              (((w) - 0x1a800u) * 4u)
+#define GMU_AO_COUNTER_L        GMU_REG(0x1f888u)
+#define GMU_AO_COUNTER_H        GMU_REG(0x1f889u)
+#define GMU_CM3_SYSRESET        GMU_REG(0x1f800u)
+/* qcom_scm-smc.c, as HakiOS */
+#define SCM_FAST                (1ull << 31)
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(s, c)          ((uint64_t)(s) << 8 | (c))
+#define SCM_IS_CALL_AVAILABLE   SCM_CALL(6, 1)
+#define SCM_PAS_IS_SUPPORTED    SCM_CALL(2, 7)
+#define SCM_ONE_VALUE           1
+#define SCM_INTERRUPTED         1
+#define PAS_GPU                 13
+
+static vm_offset_t gcc, gpucc, gmu, smmu;
+static unsigned step_now;
+static int gpu_chan;
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&gpu_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Announce a step and give the persistent log time to hold the line. */
+static void
+announce(unsigned n, const char *what)
+{
+	step_now = n;
+	printf("SWEET GPU: step %u: %s\n", n, what);
+	sleep_ms(3000);
+}
+
+/* Enable a branch clock and wait for CLK_OFF to clear (hardware-gated ones may read off). */
+static bool
+branch_on(vm_offset_t base, uint32_t off, const char *name)
+{
+	uint32_t v = rd(base, off);
+	if (!(v & CBCR_ENABLE)) {
+		wr(base, off, v | CBCR_ENABLE);
+	}
+	for (unsigned i = 0; i < 200; i++) {
+		v = rd(base, off);
+		if (!(v & CBCR_CLK_OFF) || (v & CBCR_HW_CTL)) {
+			printf("SWEET GPU: %s on (cbcr %#x)\n", name, v);
+			return true;
+		}
+		delay(10);
+	}
+	printf("SWEET GPU: %s STILL OFF (cbcr %#x)\n", name, v);
+	return false;
+}
+
+static void
+dump_clocks(void)
+{
+	printf("SWEET GPU: GCC vote2 %#x cfg-ahb %#x memnoc %#x snoc-dvm %#x ddrss-axi %#x\n",
+	    rd(gcc, GCC_APCS_VOTE2), rd(gcc, GCC_GPU_CFG_AHB), rd(gcc, GCC_GPU_MEMNOC_GFX),
+	    rd(gcc, GCC_GPU_SNOC_DVM_GFX), rd(gcc, GCC_DDRSS_GPU_AXI));
+}
+
+static void
+dump_gpucc(void)
+{
+	printf("SWEET GPU: GPU_CC cx-gdsc %#x gx-gdsc %#x ahb %#x cxo %#x cx-gmu %#x cx-snoc %#x gmu-rcg %#x/%#x\n",
+	    rd(gpucc, GPUCC_CX_GDSCR), rd(gpucc, GPUCC_GX_GDSCR), rd(gpucc, GPUCC_AHB), rd(gpucc, GPUCC_CXO),
+	    rd(gpucc, GPUCC_CX_GMU), rd(gpucc, GPUCC_CX_SNOC_DVM), rd(gpucc, GPUCC_GMU_RCG_CMD),
+	    rd(gpucc, GPUCC_GMU_RCG_CMD + 4));
+}
+
+static int32_t
+scm(uint64_t function, uint64_t arguments, uint64_t first, uint64_t *answer)
+{
+	uint64_t session = 0;
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = first;
+		register uint64_t x3 __asm__("x3") = 0;
+		register uint64_t x4 __asm__("x4") = 0;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	return -1;
+}
+
+static void
+gpu_thread(void *arg, wait_result_t result)
+{
+	unsigned last = (unsigned)(uintptr_t)arg, delay_s = 40;
+	(void)result;
+	(void)PE_parse_boot_argn("sweetgpudelay", &delay_s, sizeof(delay_s));
+	printf("SWEET GPU: Adreno 640 milestone 1, steps 1..%u in %u s\n", last, delay_s);
+	sleep_ms(delay_s * 1000u);
+	gcc = ml_io_map(GPU_GCC_PA, GPU_GCC_SIZE);
+	gpucc = ml_io_map(GPU_CC_PA, GPU_CC_SIZE);
+	gmu = ml_io_map(GPU_GMU_PA, GPU_GMU_SIZE);
+	smmu = ml_io_map(GPU_SMMU_PA, GPU_SMMU_SIZE);
+	if (!gcc || !gpucc || !gmu || !smmu) {
+		printf("SWEET GPU: MMIO mapping failed\n");
+		goto out;
+	}
+
+	announce(1, "read GCC GPU clocks, GPU_CC clocks, GPU GDSCs");
+	dump_clocks();
+	dump_gpucc();
+	if (last < 2) {
+		goto out;
+	}
+
+	announce(2, "GCC: vote GPLL0 for the GPU, enable cfg-ahb, memnoc, snoc-dvm, ddrss-axi");
+	wr(gcc, GCC_APCS_VOTE2, rd(gcc, GCC_APCS_VOTE2) | (1u << 15) | (1u << 16));
+	/*
+	 * memnoc-gfx and snoc-dvm-gfx feed the GPU's power domain and stay CLK_OFF until the CX GDSC
+	 * is up (phone, iOS/runs/gpu-1); they are enabled here and checked again after step 3.
+	 */
+	bool ok = branch_on(gcc, GCC_GPU_CFG_AHB, "gcc_gpu_cfg_ahb");
+	(void)branch_on(gcc, GCC_GPU_MEMNOC_GFX, "gcc_gpu_memnoc_gfx");
+	(void)branch_on(gcc, GCC_GPU_SNOC_DVM_GFX, "gcc_gpu_snoc_dvm_gfx");
+	ok = branch_on(gcc, GCC_DDRSS_GPU_AXI, "gcc_ddrss_gpu_axi") && ok;
+	dump_clocks();
+	if (!ok || last < 3) {
+		goto out;
+	}
+
+	announce(3, "GPU_CC: cxo, ahb; CX GDSC on");
+	dump_gpucc();
+	ok = branch_on(gpucc, GPUCC_CXO, "gpu_cc_cxo");
+	ok = branch_on(gpucc, GPUCC_AHB, "gpu_cc_ahb") && ok;
+	uint32_t g = rd(gpucc, GPUCC_CX_GDSCR);
+	if (g & GDSC_PWR_ON) {
+		printf("SWEET GPU: CX GDSC already on (%#x)\n", g);
+	} else {
+		wr(gpucc, GPUCC_CX_GDSCR, g & ~GDSC_SW_COLLAPSE);
+		for (unsigned i = 0; i < 500 && !((g = rd(gpucc, GPUCC_CX_GDSCR)) & GDSC_PWR_ON); i++) {
+			delay(10);
+		}
+		printf("SWEET GPU: CX GDSC %s (%#x)\n", (g & GDSC_PWR_ON) ? "ON" : "DID NOT POWER UP", g);
+		ok = ok && (g & GDSC_PWR_ON) != 0;
+	}
+	if (ok) {
+		ok = branch_on(gcc, GCC_GPU_MEMNOC_GFX, "gcc_gpu_memnoc_gfx (CX on)");
+		ok = branch_on(gcc, GCC_GPU_SNOC_DVM_GFX, "gcc_gpu_snoc_dvm_gfx (CX on)") && ok;
+		dump_clocks();
+	}
+	if (!ok || last < 4) {
+		goto out;
+	}
+
+	announce(4, "GPU_CC: GMU clock 200 MHz from GPLL0 main div, cx-gmu and cx-snoc-dvm");
+	/* clk-rcg2: CFG = source 6 (GPLL0_OUT_MAIN_DIV) << 8 | half-integer divider 1.5 -> 2 */
+	wr(gpucc, GPUCC_GMU_RCG_CMD + 4, (rd(gpucc, GPUCC_GMU_RCG_CMD + 4) & ~0x71fu) | (6u << 8) | 2u);
+	wr(gpucc, GPUCC_GMU_RCG_CMD, rd(gpucc, GPUCC_GMU_RCG_CMD) | RCG_UPDATE);
+	for (unsigned i = 0; i < 500 && (rd(gpucc, GPUCC_GMU_RCG_CMD) & RCG_UPDATE); i++) {
+		delay(10);
+	}
+	ok = !(rd(gpucc, GPUCC_GMU_RCG_CMD) & RCG_UPDATE);
+	printf("SWEET GPU: GMU RCG %s (cmd %#x cfg %#x)\n", ok ? "updated" : "UPDATE STUCK",
+	    rd(gpucc, GPUCC_GMU_RCG_CMD), rd(gpucc, GPUCC_GMU_RCG_CMD + 4));
+	ok = branch_on(gpucc, GPUCC_CX_GMU, "gpu_cc_cx_gmu") && ok;
+	ok = branch_on(gpucc, GPUCC_CX_SNOC_DVM, "gpu_cc_cx_snoc_dvm") && ok;
+	dump_gpucc();
+	if (!ok || last < 5) {
+		goto out;
+	}
+
+	announce(5, "GMU: always-on counter twice, 20 ms apart");
+	uint32_t l0 = rd(gmu, GMU_AO_COUNTER_L), h0 = rd(gmu, GMU_AO_COUNTER_H);
+	uint64_t t0 = mach_absolute_time();
+	sleep_ms(20);
+	uint32_t l1 = rd(gmu, GMU_AO_COUNTER_L), h1 = rd(gmu, GMU_AO_COUNTER_H);
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	uint64_t c0 = (uint64_t)h0 << 32 | l0, c1 = (uint64_t)h1 << 32 | l1;
+	uint64_t khz = ns ? (c1 - c0) * 1000000ull / ns : 0;
+	printf("SWEET GPU: GMU always-on %#llx -> %#llx in %llu us: %llu kHz%s; CM3 sysreset %#x\n", c0, c1, ns / 1000,
+	    khz, (khz > 18000 && khz < 20500) ? " - THE GPU BLOCK IS ALIVE" : "", rd(gmu, GMU_CM3_SYSRESET));
+	if (last < 6) {
+		goto out;
+	}
+
+	announce(6, "SMMU: ID registers 0..2");
+	printf("SWEET GPU: SMMU IDR0 %#x IDR1 %#x IDR2 %#x CR0 %#x\n", rd(smmu, 0x20), rd(smmu, 0x24),
+	    rd(smmu, 0x28), rd(smmu, 0x0));
+	if (last < 7) {
+		goto out;
+	}
+
+	announce(7, "TrustZone: call available; PAS is-supported for the GPU (13)");
+	uint64_t how = SCM_FAST | SCM_64 | SCM_SIP, ans = 0;
+	int32_t r = scm(how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, how | SCM_IS_CALL_AVAILABLE, &ans);
+	printf("SWEET GPU: TrustZone is-call-available(is-call-available): ret %d answer %#llx\n", r, ans);
+	r = scm(how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, how | SCM_PAS_IS_SUPPORTED, &ans);
+	printf("SWEET GPU: TrustZone is-call-available(pas-is-supported): ret %d answer %#llx\n", r, ans);
+	r = scm(how | SCM_PAS_IS_SUPPORTED, SCM_ONE_VALUE, PAS_GPU, &ans);
+	printf("SWEET GPU: TrustZone pas-is-supported(13): ret %d answer %#llx\n", r, ans);
+	printf("SWEET GPU: milestone 1 done\n");
+out:
+	printf("SWEET GPU: stopped after step %u\n", step_now);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_adreno_init(void)
+{
+	static bool started;
+	unsigned last = 0;
+	thread_t thread;
+	if (started) {
+		return;
+	}
+	started = true;
+	(void)PE_parse_boot_argn("sweetgpu", &last, sizeof(last));
+	if (last == 0) {
+		return;
+	}
+	if (kernel_thread_start(gpu_thread, (void *)(uintptr_t)last, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
