+static vm_offset_t pdc_cfg, pdc_seq;
+static uint32_t smmu_pgsz, smmu_npages, smmu_ctx, smmu_smr, smmu_ncb, smmu_nsmr;
+static const uint8_t *gmu_fw, *sqe_fw;
+static uint32_t gmu_fw_size, sqe_fw_size;
+#define PT_TABLES       16u
+static uint64_t *pt_table[PT_TABLES];
+static uint64_t pt_phys[PT_TABLES];
+static unsigned pt_count;
+
+/* Push this CPU's writes to memory the GPU block reads, and drop the lines (it writes some too). */
+static void
+to_memory(vm_offset_t start, vm_size_t size)
+{
+	for (vm_offset_t line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+		__asm__ volatile("dc civac, %0" : : "r"(line) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static uint64_t *
+pt_new(void)
+{
+	static vm_offset_t pool;
+	if (pool == 0 && kmem_alloc(kernel_map, &pool, PT_TABLES * 4096, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return NULL;
+	}
+	if (pt_count == PT_TABLES) {
+		return NULL;
+	}
+	pt_table[pt_count] = (uint64_t *)(pool + 4096u * pt_count);
+	pt_phys[pt_count] = kvtophys((vm_offset_t)pt_table[pt_count]);
+	return pt_table[pt_count++];
+}
+
+/* The table an entry leads to, made if the entry is empty. */
+static uint64_t *
+pt_next(uint64_t *entry)
+{
+	if (*entry & 1) {
+		for (unsigned i = 0; i < pt_count; i++) {
+			if (pt_phys[i] == (*entry & PTE_ADDR)) {
+				return pt_table[i];
+			}
+		}
+		return NULL;
+	}
+	uint64_t *t = pt_new();
+	if (t != NULL) {
+		*entry = pt_phys[pt_count - 1] | PTE_VALID;
+	}
+	return t;
+}
+
+/* One table tree for both contexts (GMU: stream 5, 3D core: stream 0); their addresses do not overlap. */
+static bool
+pt_map_attr(uint64_t va, uint64_t pa, uint64_t attr)
+{
+	uint64_t *l1 = pt_count ? pt_table[0] : pt_new(), *l2, *l3;
+	if (l1 == NULL || (l2 = pt_next(&l1[(va >> 30) & 0x1ff])) == NULL ||
+	    (l3 = pt_next(&l2[(va >> 21) & 0x1ff])) == NULL) {
+		return false;
+	}
+	l3[(va >> 12) & 0x1ff] = pa | attr | PTE_VALID;
+	return true;
+}
+
+static bool
+pt_map(uint64_t va, uint64_t pa)
+{
+	return pt_map_attr(va, pa, PTE_GMU);
+}
+
+static uint32_t
+cb(uint32_t ctx)
+{
+	return (smmu_npages + ctx) * smmu_pgsz;
+}
+
+/* Fault status of a context; true if it recorded a translation fault (FSR bits 1-8, not the format field). */
+static bool
+smmu_fault_ctx(uint32_t ctx, const char *when)
+{
+	uint32_t c = cb(ctx), fsr = rd(smmu, c + SMMU_CB_FSR);
+	printf("SWEET GPU: SMMU context %u %s: fsr %#x far %#x%08x fsynr0 %#x, sgfsr %#x\n", ctx, when, fsr,
+	    rd(smmu, c + SMMU_CB_FAR + 4), rd(smmu, c + SMMU_CB_FAR), rd(smmu, c + SMMU_CB_FSYNR0), rd(smmu, SMMU_SGFSR));
+	return (fsr & 0x1feu) != 0;
+}
+
+static void
+smmu_fault_report(const char *when)
+{
+	(void)smmu_fault_ctx(smmu_ctx, when);
+}
+
+/*
+ * HakiOS space_on: a context's registers first (stage 1, 64-bit, the shared tables with the context
+ * number as ASID), translation on, then the stream sent through it by a match; read back.
+ */
+static bool
+smmu_attach(uint32_t ctx, uint32_t smr_index, uint32_t stream, uint32_t mask)
+{
+	uint32_t c = cb(ctx), want = SMMU_SMR_VALID | mask << 16 | stream;
+	uint64_t ttbr = pt_phys[0] | (uint64_t)ctx << 48;
+	wr(smmu, c + SMMU_CB_SCTLR, 0);
+	wr(smmu, smmu_pgsz + SMMU_CBA2R(ctx), 1);       /* 64-bit */
+	wr(smmu, smmu_pgsz + SMMU_CBAR(ctx), SMMU_CBAR_S1);
+	wr(smmu, c + SMMU_CB_TCR2, SMMU_TCR2_36);
+	wr(smmu, c + SMMU_CB_TCR, SMMU_TCR_39);
+	wr(smmu, c + SMMU_CB_TTBR0, (uint32_t)ttbr);
+	wr(smmu, c + SMMU_CB_TTBR0 + 4, (uint32_t)(ttbr >> 32));
+	wr(smmu, c + SMMU_CB_TTBR1, 0);
+	wr(smmu, c + SMMU_CB_TTBR1 + 4, 0);
+	wr(smmu, c + SMMU_CB_MAIR0, SMMU_MAIR0);
+	wr(smmu, c + SMMU_CB_MAIR1, 0);
+	wr(smmu, c + SMMU_CB_FSR, SMMU_FSR_ALL);
+	wr(smmu, c + SMMU_CB_TLBIASID, ctx);
+	wr(smmu, c + SMMU_CB_TLBSYNC, 1);
+	for (unsigned i = 0; i < 1000 && (rd(smmu, c + SMMU_CB_TLBSTATUS) & 1); i++) {
+		delay(10);
+	}
+	wr(smmu, c + SMMU_CB_SCTLR, SMMU_SCTLR_ON);
+	wr(smmu, SMMU_S2CR(smr_index), ctx);
+	wr(smmu, SMMU_SMR(smr_index), want);
+	uint32_t smr = rd(smmu, SMMU_SMR(smr_index)), s2cr = rd(smmu, SMMU_S2CR(smr_index));
+	printf("SWEET GPU: SMMU cb%u: cbar %#x sctlr %#x tcr %#x ttbr0 %#x%08x; smr%u %#x s2cr %#x\n", ctx,
+	    rd(smmu, smmu_pgsz + SMMU_CBAR(ctx)), rd(smmu, c + SMMU_CB_SCTLR), rd(smmu, c + SMMU_CB_TCR),
+	    rd(smmu, c + SMMU_CB_TTBR0 + 4), rd(smmu, c + SMMU_CB_TTBR0), smr_index, smr, s2cr);
+	if (smr != want || (s2cr & 0x300ff) != ctx || !(rd(smmu, c + SMMU_CB_SCTLR) & 1) ||
+	    rd(smmu, c + SMMU_CB_TTBR0) != (uint32_t)ttbr) {
+		printf("SWEET GPU: the SMMU (or the hypervisor) did not take it\n");
+		return false;
+	}
+	return true;
+}
+
+/* Step 8: the SMMU's layout and what the boot loader and hypervisor left in it; pick a context and a match. */
+static bool
+gmu_smmu_survey(void)
+{
+	uint32_t idr0 = rd(smmu, SMMU_IDR0), idr1 = rd(smmu, SMMU_IDR1);
+	uint32_t nsmr = idr0 & 0xff, ncb = idr1 & 0xff, busy = 0;
+	smmu_nsmr = nsmr;
+	smmu_ncb = ncb;
+	smmu_pgsz = (idr1 >> 31) ? 0x10000u : 0x1000u;
+	smmu_npages = 2u << ((idr1 >> 28) & 7);
+	printf("SWEET GPU: SMMU %u matches, %u contexts, %u pages of %#x (%#x of registers, dt 0x10000)\n", nsmr, ncb,
+	    smmu_npages, smmu_pgsz, 2 * smmu_npages * smmu_pgsz);
+	if (2 * smmu_npages * smmu_pgsz != GPU_SMMU_SIZE || nsmr == 0 || ncb == 0 || nsmr > 32 || ncb > 32) {
+		return false;
+	}
+	smmu_smr = ~0u;
+	for (uint32_t i = 0; i < nsmr; i++) {
+		uint32_t smr = rd(smmu, SMMU_SMR(i)), s2cr = rd(smmu, SMMU_S2CR(i));
+		printf("SWEET GPU: SMMU smr%u %#x s2cr %#x\n", i, smr, s2cr);
+		if (smr & SMMU_SMR_VALID) {
+			if (((s2cr >> 16) & 3) == 0) {
+				busy |= 1u << (s2cr & 0xff);
+			}
+			if ((smr & 0x7fff) == GMU_STREAM) {
+				printf("SWEET GPU: stream %u already has a match: not touching it\n", GMU_STREAM);
+				return false;
+			}
+		} else if (smmu_smr == ~0u) {
+			smmu_smr = i;
+		}
+	}
+	for (uint32_t i = 0; i < ncb; i++) {
+		uint32_t sctlr = rd(smmu, cb(i) + SMMU_CB_SCTLR);
+		printf("SWEET GPU: SMMU cb%u cbar %#x cba2r %#x sctlr %#x ttbr0 %#x%08x\n", i, rd(smmu, smmu_pgsz + SMMU_CBAR(i)),
+		    rd(smmu, smmu_pgsz + SMMU_CBA2R(i)), sctlr, rd(smmu, cb(i) + SMMU_CB_TTBR0 + 4), rd(smmu, cb(i) + SMMU_CB_TTBR0));
+		if (sctlr & 1) {
+			busy |= 1u << i;
+		}
+	}
+	smmu_ctx = ~0u;
+	for (uint32_t i = 1; i <= ncb; i++) {    /* 1 first, as HakiOS; 0 is the 3D core's in kgsl */
+		uint32_t c = i % ncb;
+		if (!(busy & (1u << c))) {
+			smmu_ctx = c;
+			break;
+		}
+	}
+	printf("SWEET GPU: GMU stream %u goes through context %d, match %d\n", GMU_STREAM, (int)smmu_ctx, (int)smmu_smr);
+	return smmu_ctx != ~0u && smmu_smr != ~0u;
+}
+
+/* Step 9: the firmware blob, the GMU's DDR, page tables, and the SMMU context for stream 5. */
+static bool
+gmu_memory(void)
+{
+	uint64_t nvt_pa = 0;
+	uint32_t nvt_size = 0;
+	(void)PE_parse_boot_argn("sweetnvtfw", &nvt_pa, sizeof(nvt_pa));
+	(void)PE_parse_boot_argn("sweetnvtfwsz", &nvt_size, sizeof(nvt_size));
+	/*
+	 * The shim's ramdisk lies below the memory XNU manages (phone: PA 0x856f5000, phys base 0xc0000000),
+	 * so ml_static_ptovirt panics on it (iOS/runs/ios-gmu1): mapped as I/O like sweet_nvt.c does, and
+	 * copied out word by word (Device memory takes no unaligned or byte-wise memcpy).
+	 */
+	uint64_t pa = nvt_pa + ((nvt_size + 15u) & ~15u), base = pa & ~0x3fffull;
+	/* GMU firmware (up to 64K) and, after it, the CP microcode (build-payload.sh SQEFW=, up to 64K) */
+	vm_offset_t io = nvt_pa ? ml_io_map((vm_offset_t)base, (vm_size_t)((pa - base + 32u + 0x20000u + 0x3fffu) & ~0x3fffull)) : 0;
+	volatile const uint32_t *w = (volatile const uint32_t *)(io + (pa - base));
+	uint32_t magic[2];
+	memcpy(magic, "SWEETGMU", 8);
+	if (io == 0 || w[0] != magic[0] || w[1] != magic[1]) {
+		printf("SWEET GPU: no GMU firmware after the touch firmware (sweetnvtfw=%#llx size %#x)\n", nvt_pa, nvt_size);
+		return false;
+	}
+	gmu_fw_size = w[2];
+	printf("SWEET GPU: a640_gmu.bin: %u bytes at pa %#llx\n", gmu_fw_size, pa + 16u);
+	vm_offset_t copy = 0;
+	if (gmu_fw_size < 16 || gmu_fw_size > 0x10000u || (gmu_fw_size & 3) || kmem_alloc(kernel_map, &copy,
+	    round_page(gmu_fw_size), KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	for (uint32_t i = 0; i < gmu_fw_size / 4u; i++) {
+		((uint32_t *)copy)[i] = w[4 + i];
+	}
+	gmu_fw = (const uint8_t *)copy;
+	volatile const uint32_t *s = w + 4 + ((gmu_fw_size + 15u) & ~15u) / 4u;
+	memcpy(magic, "SWEETSQE", 8);
+	if (s[0] == magic[0] && s[1] == magic[1] && s[2] >= 8 && s[2] <= 0x10000u && !(s[2] & 3) &&
+	    kmem_alloc(kernel_map, &copy, round_page(s[2]), KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) == KERN_SUCCESS) {
+		sqe_fw_size = s[2];
+		for (uint32_t i = 0; i < sqe_fw_size / 4u; i++) {
+			((uint32_t *)copy)[i] = s[4 + i];
+		}
+		sqe_fw = (const uint8_t *)copy;
+		printf("SWEET GPU: a630_sqe.fw: %u bytes, first words %#x %#x\n", sqe_fw_size, ((uint32_t *)copy)[0],
+		    ((uint32_t *)copy)[1]);
+	} else {
+		printf("SWEET GPU: no CP microcode after the GMU firmware (SQEFW=)\n");
+	}
+	for (unsigned i = 0; i < GMU_MEMS; i++) {
+		struct gmu_mem *m = &gmu_mem[i];
+		if (kmem_alloc(kernel_map, &m->kva, round_page(m->size), KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("SWEET GPU: no memory for the GMU's %s\n", m->name);
+			return false;
+		}
+		for (uint32_t off = 0; off < m->size; off += 4096u) {
+			if (!pt_map(m->va + off, kvtophys(m->kva + off))) {
+				printf("SWEET GPU: page tables full at %#x\n", m->va + off);
+				return false;
+			}
+		}
+		to_memory(m->kva, m->size);
+		printf("SWEET GPU: GMU %s %#x..%#x -> pa %#llx\n", m->name, m->va, m->va + m->size - 1, kvtophys(m->kva));
+	}
+	for (unsigned i = 0; i < pt_count; i++) {
+		to_memory((vm_offset_t)pt_table[i], 4096);
+	}
+
+	return smmu_attach(smmu_ctx, smmu_smr, GMU_STREAM, SMMU_STREAM_MASK);
+}
+
+/* Step 10: TCM retention, then the RSCC and PDC sequences (kgsl _load_gmu_rpmh_ucode, a640 values). */
+static bool
+gmu_rpmh_ucode(void)
+{
+	static const uint32_t rscc_seq[5] = { 0xa7a506a0u, 0xa1e6a6e7u, 0xa2e081e1u, 0xe9a982e2u, 0x0020e8a8u };
+	static const uint32_t pdc_seq_mem[5] = { 0xfebea1e1u, 0xa5a4a3a2u, 0x8382a6e0u, 0xbce3e284u, 0x002081fcu };
+	pdc_cfg = ml_io_map(GPU_PDC_CFG_PA, GPU_PDC_SIZE);
+	pdc_seq = ml_io_map(GPU_PDC_SEQ_PA, GPU_PDC_SIZE);
+	if (!pdc_cfg || !pdc_seq) {
+		return false;
+	}
+	printf("SWEET GPU: before: rscc status0 %#x seq_mem0 %#x seq_busy %#x; pdc enable %#x seq_start %#x seq0 %#x\n",
+	    rd(gmu, RSCC_RSC_STATUS0_DRV0), rd(gmu, RSCC_SEQ_MEM_0_DRV0), rd(gmu, RSCC_SEQ_BUSY_DRV0),
+	    rd(pdc_cfg, PDC_GPU_ENABLE_PDC), rd(pdc_cfg, PDC_GPU_SEQ_START_ADDR), rd(pdc_seq, 0));
+	wr(gmu, GMU_GENERAL_7, 1);
+	wr(gmu, RSCC_RSC_STATUS0_DRV0, 1u << 24);
+	wr(gmu, RSCC_PDC_SLAVE_ID_DRV0, 1);
+	for (unsigned i = 0; i < 3; i++) {
+		wr(gmu, RSCC_HIDDEN_TCS_CMD0_DATA + 8u * i, i == 2 ? 0x80000000u : 0);
+		wr(gmu, RSCC_HIDDEN_TCS_CMD0_ADDR + 8u * i, 0);
+	}
+	wr(gmu, RSCC_OVERRIDE_START_ADDR, 0);
+	wr(gmu, RSCC_PDC_SEQ_START_ADDR, 0x4520);
+	wr(gmu, RSCC_PDC_MATCH_VALUE_LO, 0x4510);
+	wr(gmu, RSCC_PDC_MATCH_VALUE_HI, 0x4514);
+	for (unsigned i = 0; i < 5; i++) {
+		wr(gmu, RSCC_SEQ_MEM_0_DRV0 + 4u * i, rscc_seq[i]);
+	}
+	for (unsigned i = 0; i < 5; i++) {
+		wr(pdc_seq, 4u * i, pdc_seq_mem[i]);
+	}
+	/* TCS1 (sleep) and TCS3 (wake): 3 commands each; a640 sends the third to 0x30090 */
+	for (unsigned t = 0; t < 2; t++) {
+		uint32_t base = t ? PDC_GPU_TCS3_CONTROL : PDC_GPU_TCS1_CONTROL;
+		static const uint32_t addr[3] = { 0x30010u, 0x30000u, 0x30090u };
+		static const uint32_t data[2][3] = { { 1, 0, 0 }, { 2, 3, 3 } };
+		wr(pdc_cfg, base + 4u, 7);      /* CMD_ENABLE_BANK */
+		wr(pdc_cfg, base + 8u, 0);      /* CMD_WAIT_FOR_CMPL_BANK */
+		wr(pdc_cfg, base, 0);           /* CONTROL */
+		for (unsigned k = 0; k < 3; k++) {
+			wr(pdc_cfg, base + 12u + 16u * k, 0x10108u);    /* CMD0 MSGID, then every PDC_CMD_OFFSET (4 words) */
+			wr(pdc_cfg, base + 16u + 16u * k, addr[k]);
+			wr(pdc_cfg, base + 20u + 16u * k, data[t][k]);
+		}
+	}
+	wr(pdc_cfg, PDC_GPU_SEQ_START_ADDR, 0);
+	wr(pdc_cfg, PDC_GPU_ENABLE_PDC, 0x80000001u);
+	printf("SWEET GPU: after: rscc seq_mem0 %#x match %#x/%#x; pdc enable %#x seq0 %#x tcs3 cmd2 addr %#x\n",
+	    rd(gmu, RSCC_SEQ_MEM_0_DRV0), rd(gmu, RSCC_PDC_MATCH_VALUE_LO), rd(gmu, RSCC_PDC_MATCH_VALUE_HI),
+	    rd(pdc_cfg, PDC_GPU_ENABLE_PDC), rd(pdc_seq, 0), rd(pdc_cfg, PDC_GPU_TCS3_CONTROL + 16u + 32u));
+	return rd(gmu, RSCC_SEQ_MEM_0_DRV0) == rscc_seq[0];
+}
+
+/* Step 11: the firmware's blocks into the TCMs (registers) and into the DDR of step 9; TCMs read back. */
+static bool
+gmu_firmware(void)
+{
+	unsigned wrong = 0, blocks = 0;
+	if (rd(gmu, GMU_CM3_SYSRESET) != 1) {
+		printf("SWEET GPU: the GMU's CM3 is not in reset (%#x): not loading\n", rd(gmu, GMU_CM3_SYSRESET));
+		return false;
+	}
+	for (int pass = 0; pass < 2; pass++) {
+		for (uint32_t at = 0; at + 16u <= gmu_fw_size;) {
+			uint32_t b[4];
+			memcpy(b, gmu_fw + at, sizeof(b));
+			const uint8_t *data = gmu_fw + at + 16;
+			uint32_t va = b[0], size = b[1];
+			at += 16u + size;
+			if (at > gmu_fw_size || (size & 3)) {
+				printf("SWEET GPU: bad firmware block at %#x (size %#x)\n", at, size);
+				return false;
+			}
+			if (size == 0) {
+				continue;
+			}
+			uint32_t reg = ~0u;
+			if (va + size <= GMU_ITCM_VA + GMU_TCM_SIZE) {
+				reg = GMU_ITCM + (va - GMU_ITCM_VA);
+			} else if (va >= GMU_DTCM_VA && va + size <= GMU_DTCM_VA + GMU_TCM_SIZE) {
+				reg = GMU_DTCM + (va - GMU_DTCM_VA);
+			}
+			if (reg != ~0u) {
+				for (uint32_t off = 0; off < size; off += 4) {
+					uint32_t w;
+					memcpy(&w, data + off, 4);
+					if (pass == 0) {
+						wr(gmu, reg + off, w);
+					} else if (rd(gmu, reg + off) != w) {
+						wrong++;
+					}
+				}
+			} else if (pass == 0) {
+				unsigned i;
+				for (i = 0; i < GMU_MEMS; i++) {
+					if (va >= gmu_mem[i].va && va + size <= gmu_mem[i].va + gmu_mem[i].size) {
+						memcpy((void *)(gmu_mem[i].kva + (va - gmu_mem[i].va)), data, size);
+						to_memory(gmu_mem[i].kva + (va - gmu_mem[i].va), size);
+						break;
+					}
+				}
+				if (i == GMU_MEMS) {
+					printf("SWEET GPU: firmware block %#x+%#x has no memory\n", va, size);
+					return false;
+				}
+			}
+			if (pass == 0) {
+				blocks++;
+				printf("SWEET GPU: firmware %#x+%#x -> %s\n", va, size, reg != ~0u ? "TCM" : "DDR");
+			}
+		}
+	}
+	printf("SWEET GPU: %u firmware blocks loaded, %u TCM words read back wrong\n", blocks, wrong);
+	return blocks > 0 && wrong == 0;
+}
+
+/* Step 12: the HFI table, the GMU's registers (a6xx_gmu_fw_start, power_config), out of reset. */
+static bool
+gmu_start(void)
+{
+	static const uint8_t qpri[4] = { 10, 10, 40, 20 };
+	struct hfi_qtbl *t = (struct hfi_qtbl *)gmu_mem[3].kva;
+	t->version = 0;
+	t->size = sizeof(*t) / 4;
+	t->qhdr0_offset = 6;
+	t->qhdr_size = sizeof(struct hfi_qhdr) / 4;
+	t->num_q = t->num_active_q = 4;
+	for (unsigned i = 0; i < 4; i++) {
+		t->q[i].status = i < 3;
+		t->q[i].start_addr = GMU_HFI_VA + HFI_QUEUE_AT(i);
+		t->q[i].type = i | (uint32_t)qpri[i] << 8;
+		t->q[i].queue_size = 4096 / 4;
+		t->q[i].rx_wm = t->q[i].tx_wm = t->q[i].rx_req = 1;
+	}
+	to_memory((vm_offset_t)t, 4096);
+
+	wr(gmu, GMU_CM3_FW_INIT_RESULT, 0);
+	wr(gmu, GMU_CM3_BOOT_CONFIG, 2);                /* TCM_BOOT */
+	wr(gmu, GMU_HFI_QTBL_ADDR, GMU_HFI_VA);
+	wr(gmu, GMU_HFI_QTBL_INFO, 1);
+	wr(gmu, GMU_AHB_FENCE_RANGE_0, GMU_FENCE_RANGE);
+	wr(gmu, GMU_CM3_CFG, 0x4052);
+	wr(gmu, GMU_HFI_SFR_ADDR, GMU_CHIPID);
+	wr(gmu, GMU_PWR_COL_CP_MSG, GMU_LOG_VA & 0xfffff000u);  /* one 4K page: count - 1 = 0 */
+	wr(gmu, GMU_SYS_BUS_CONFIG, 1);
+	wr(gmu, GMU_ICACHE_CONFIG, 1);
+	wr(gmu, GMU_DCACHE_CONFIG, 1);
+	wr(gmu, GMU_PWR_COL_INTER_FRAME_CTRL, 0x9c40400u);
+	wr(gmu, GMU_RPMH_CTRL, rd(gmu, GMU_RPMH_CTRL) | GMU_RPMH_ENABLE);
+	wr(gmu, GMU_CX_GMU_WFI_CONFIG, 0);
+	wr(gmu, GMU_CM3_SYSRESET, 0);
+	uint32_t r = 0;
+	for (unsigned i = 0; i < 5000 && (r = rd(gmu, GMU_CM3_FW_INIT_RESULT)) != GMU_BOOTED; i++) {
+		delay(100);
+	}
+	printf("SWEET GPU: GMU fw_init_result %#x fw_busy %#x gmu2host %#x ao_host_intr %#x rpmh_ctrl %#x%s\n", r,
+	    rd(gmu, GMU_CM3_FW_BUSY), rd(gmu, GMU_GMU2HOST_INTR_INFO), rd(gmu, GMU_AO_HOST_INTR_STATUS), rd(gmu, GMU_RPMH_CTRL),
+	    r == GMU_BOOTED ? " - THE GMU'S FIRMWARE RUNS" : " - the GMU did not boot");
+	smmu_fault_report("after the GMU start");
+	return r == GMU_BOOTED;
+}
+
+/* Step 13: HFI up (a6xx_gmu_hfi_start); what the GMU wrote into its queues. */
+static bool
+gmu_hfi(void)
+{
+	wr(gmu, GMU_HFI_CTRL_INIT, 1);
+	uint32_t s = 0;
+	for (unsigned i = 0; i < 5000 && !((s = rd(gmu, GMU_HFI_CTRL_STATUS)) & 1); i++) {
+		delay(100);
+	}
+	struct hfi_qtbl *t = (struct hfi_qtbl *)gmu_mem[3].kva;
+	to_memory((vm_offset_t)t, 4096);
+	printf("SWEET GPU: HFI ctrl_status %#x version %#x%s; queues r/w: cmd %u/%u msg %u/%u dbg %u/%u\n", s,
+	    rd(gmu, GMU_HFI_VERSION_INFO), (s & 1) ? " - HFI IS UP" : " - HFI did not start", t->q[0].read_index,
+	    t->q[0].write_index, t->q[1].read_index, t->q[1].write_index, t->q[2].read_index, t->q[2].write_index);
+	smmu_fault_report("after HFI init");
+	return (s & 1) != 0;
+}
+
+/*
+ * ---- milestone 3: GX on (steps 14-15) ----
+ *
+ * kgsl hfi_start for an a640 (HFI 2.x, no H2F_MSG_INIT): FW_VER, PERF_TBL (GPU and GMU levels with
+ * their rail votes), BW_VOTE_TBL, FEATURE_CTRL ECP off, CORE_FW_START; each is acked through the
+ * message queue (GMU2HOST_INTR_INFO bit 0, polled - no interrupts). Then the default DCVS level
+ * (GX_BW_PERF_VOTE) and OOB "gpu" (a6xx_gmu_oob_set: HOST2GMU bit 30, ack GMU2HOST bit 31): the
+ * GMU votes the GX rail through the GPU RSC/PDC and powers the GX GDSC. GX is on when
+ * SPTPRAC_PWR_CLK_STATUS has neither GX_GDSC_POWER_OFF (6) nor GX_CLK_OFF (7); only then are the
+ * 3D core's registers read (RBBM_STATUS) - with GX off they hang the bus.
+ *
+ * Levels (vayu dt): kgsl-3d0 gpu_opp_table_v2 (opp-microvolt = RPMh level + 1), pwrlevel bin by the
+ * fuse qfprom 0x780000 + 0x4130 (mask 0xe0000000 >> 29); GMU 0 / 200 MHz (CX level MIN_SVS, 48, as
+ * upstream sm8150 gmu_opp_table). Votes as kgsl setup_volt_dependency_tbl: primary rail index of
+ * the first level >= the wanted one, secondary (mx.lvl) index of the first >= that; vote =
+ * level << 16 | secondary << 8 | primary. The bus table is upstream Linux a640_build_bw_table: one
+ * "off" level (DDR: MC0, SH0, ACV; CNOC: CN0) - the apps RSC already holds DDR up (sweet_rpmh.c).
+ */
+#define GMU_GMU2HOST_INTR_CLR   GMU_REG(0x1f991u)
+#define GMU_HOST2GMU_INTR_SET   GMU_REG(0x1f994u)
+#define GMU_SPTPRAC_PWR_CLK_STATUS GMU_REG(0x1f8d0u)
+#define GMU_RPMH_POWER_STATE    GMU_REG(0x1f8ecu)
+#define GMU_GX_OFF              ((1u << 6) | (1u << 7))
+#define GPU_QFPROM_PA           0x00784000u     /* page of qfprom 0x780000 + 0x4130 */
+#define GPU_SPEED_BIN_OFF       0x130u
+#define GPU_3D_PA               0x02c00000u
+#define GPU_3D_SIZE             0x00040000u     /* dt kgsl_3d0_reg_memory */
+#define GPU_RBBM_STATUS         (0x210u * 4u)
+#define GPU_RBBM_STATUS3        (0x213u * 4u)
+#define GPU_CP_HW_FAULT         (0x821u * 4u)
+#define H2F_FW_VER              1u
+#define H2F_BW_VOTE_TBL         3u
+#define H2F_PERF_TBL            4u
+#define H2F_FEATURE_CTRL        11u
+#define H2F_CORE_FW_START       14u
+#define H2F_GX_BW_PERF_VOTE     30u
+#define F2H_ERR                 100u
+#define F2H_DEBUG               101u
+#define HFI_TYPE_ACK            1u
+#define HFI_FEATURE_ECP         1u
+#define HFI_GMU_VERSION         0x20000000u     /* GMU_VERSION(gpmu_major 2, minor 0), adreno-gpulist a640 */
+#define HFI_INVALID_IDX         0xffu
+#define HFI_HDR(id, dwords)     ((id) | (uint32_t)(dwords) << 8)
+#define OOB_GPU_SET             (1u << 30)
+#define OOB_GPU_ACK             (1u << 31)
+#define ARC_MAX                 16u
+#define RH_ARC                  3u
+#define RH_BCM                  5u
+extern int sweet_rpmh_cmd_db(const char *res, unsigned type, uint32_t *address, uint16_t *levels, unsigned max,
+    unsigned *count);
+
+struct gpu_level {
+	uint32_t khz;
+	uint16_t vlvl;
+};
+/* Lowest first, as kgsl gmu->gpu_freqs; pwrlevels-0 (speed bin 0) and pwrlevels-1. */
+static const struct gpu_level gpu_bin0[] = {
+	{ 0, 0 }, { 257000, 64 }, { 345000, 128 }, { 427000, 192 }, { 499200, 224 }, { 585000, 256 },
+};
+static const struct gpu_level gpu_bin1[] = {
+	{ 0, 0 }, { 257000, 64 }, { 345000, 128 }, { 427000, 192 }, { 499200, 224 }, { 585000, 256 }, { 675000, 320 },
+};
+static const struct gpu_level gmu_levels[] = { { 0, 0 }, { 200000, 48 } };
+static uint32_t hfi_seq;
+
+/* kgsl setup_volt_dependency_tbl for one level; false if the rail has no level that high. */
+static bool
+arc_vote(const uint16_t *pri, unsigned npri, const uint16_t *sec, unsigned nsec, uint16_t want, uint32_t *vote)
+{
+	unsigned k, j;
+	for (k = 0; k < npri && pri[k] < want; k++) {
+	}
+	if (k == npri) {
+		return false;
+	}
+	for (j = 0; j < nsec && sec[j] < pri[k] && j + 1 < nsec; j++) {
+	}
+	*vote = (uint32_t)pri[k] << 16 | j << 8 | k;
+	return true;
+}
+
+/* kgsl hfi_queue_write: dwords into queue i, padded to 4 with 0xfafafafa (HFI 2), then ring the GMU. */
+static bool
+hfi_write(unsigned i, const uint32_t *msg)
+{
+	struct hfi_qtbl *t = (struct hfi_qtbl *)gmu_mem[3].kva;
+	volatile uint32_t *q = (volatile uint32_t *)(gmu_mem[3].kva + HFI_QUEUE_AT(i));
+	uint32_t n = (msg[0] >> 8) & 0xffu, size = t->q[i].queue_size;
+	to_memory(gmu_mem[3].kva, gmu_mem[3].size);
+	uint32_t w = t->q[i].write_index, r = t->q[i].read_index;
+	uint32_t room = w >= r ? size - (w - r) : r - w;
+	if (room <= n + 3u || w >= size) {
+		printf("SWEET GPU: HFI queue %u full (r %u w %u, message %u dwords)\n", i, r, w, n);
+		return false;
+	}
+	for (uint32_t k = 0; k < n; k++) {
+		q[w] = msg[k];
+		w = (w + 1u) % size;
+	}
+	for (; w % 4u; w = (w + 1u) % size) {
+		q[w] = 0xfafafafau;
+	}
+	t->q[i].write_index = w;
+	to_memory(gmu_mem[3].kva, gmu_mem[3].size);
+	wr(gmu, GMU_HOST2GMU_INTR_SET, 1);
+	return true;
+}
+
+/* kgsl hfi_queue_read: one message from queue i into out (max dwords); 0 if the queue is empty. */
+static uint32_t
+hfi_read(unsigned i, uint32_t *out, uint32_t max)
+{
+	struct hfi_qtbl *t = (struct hfi_qtbl *)gmu_mem[3].kva;
+	const volatile uint32_t *q = (const volatile uint32_t *)(gmu_mem[3].kva + HFI_QUEUE_AT(i));
+	to_memory(gmu_mem[3].kva, gmu_mem[3].size);
+	uint32_t r = t->q[i].read_index, w = t->q[i].write_index, size = t->q[i].queue_size;
+	if (r == w || r >= size) {
+		return 0;
+	}
+	uint32_t n = (q[r] >> 8) & 0xffu;
+	for (uint32_t k = 0; k < n; k++) {
+		if (k < max) {
+			out[k] = q[r];
+		}
+		r = (r + 1u) % size;
+	}
+	t->q[i].read_index = ((r + 3u) & ~3u) % size;
+	to_memory(gmu_mem[3].kva, gmu_mem[3].size);
+	return n;
+}
+
+/* What the GMU said on its own: errors in the message queue, debug prints in queue 2. */
+static void
+hfi_print(const char *queue, const uint32_t *m, uint32_t n)
+{
+	uint32_t id = m[0] & 0xffu;
+	if (id == F2H_DEBUG && n >= 4) {
+		printf("SWEET GPU: GMU debug (%s) type %u timestamp %#x data %#x\n", queue, m[1], m[2], m[3]);
+	} else if (id == F2H_ERR && n >= 4) {
+		printf("SWEET GPU: GMU ERROR (%s) code %#x line %u\n", queue, m[1], m[2]);
+	} else {
+		printf("SWEET GPU: GMU message (%s) hdr %#x, %u dwords, %#x %#x\n", queue, m[0], n, n > 1 ? m[1] : 0,
+		    n > 2 ? m[2] : 0);
+	}
+}
+
+static void
+hfi_drain_debug(void)
+{
+	uint32_t m[16], n;
+	for (unsigned k = 0; k < 32 && (n = hfi_read(2, m, 16)) != 0; k++) {
+		hfi_print("debug", m, n);
+	}
+}
+
+/* kgsl hfi_send_generic_req: send, wait up to 100 ms for the ack, its result word; reply in out. */
+static bool
+hfi_send(const char *what, uint32_t *msg, uint32_t *out, uint32_t max)
+{
+	uint32_t seq = ++hfi_seq & 0xfffu;
+	msg[0] = (msg[0] & 0xfffffu) | seq << 20;
+	wr(gmu, GMU_GMU2HOST_INTR_CLR, 1);
+	if (!hfi_write(0, msg)) {
+		return false;
+	}
+	unsigned waited;
+	for (waited = 0; waited < 1000 && !(rd(gmu, GMU_GMU2HOST_INTR_INFO) & 1u); waited++) {
+		delay(100);
+	}
+	wr(gmu, GMU_GMU2HOST_INTR_CLR, 1);
+	uint32_t m[64], n;
+	bool acked = false;
+	while ((n = hfi_read(1, m, 64)) != 0) {
+		if (((m[0] >> 16) & 0xfu) == HFI_TYPE_ACK && n >= 3 && ((m[1] >> 20) & 0xfffu) == seq) {
+			acked = true;
+			for (uint32_t k = 0; k < n && k < max; k++) {
+				out[k] = m[k];
+			}
+			printf("SWEET GPU: HFI %s: ack after %u us, result %#x%s\n", what, waited * 100u, m[2],
+			    m[2] ? " - REFUSED" : "");
+		} else {
+			hfi_print("msg", m, n);
+		}
+	}
+	hfi_drain_debug();
+	if (!acked) {
+		printf("SWEET GPU: HFI %s: NO ACK in %u us (gmu2host %#x, cmd queue r/w %u/%u)\n", what, waited * 100u,
+		    rd(gmu, GMU_GMU2HOST_INTR_INFO), ((struct hfi_qtbl *)gmu_mem[3].kva)->q[0].read_index,
+		    ((struct hfi_qtbl *)gmu_mem[3].kva)->q[0].write_index);
+		return false;
+	}
+	return out[2] == 0;
+}
+
+static const struct gpu_level *gpu_levels;
+static unsigned gpu_nlevels;
+
+/* Step 14: kgsl hfi_start for a640. */
+static bool
+gmu_hfi_tables(void)
+{
+	uint16_t gfx[ARC_MAX], cx[ARC_MAX], mx[ARC_MAX];
+	unsigned ngfx = 0, ncx = 0, nmx = 0;
+	uint32_t a_gfx, a_cx, a_mx, reply[8];
+	vm_offset_t fuse = ml_io_map(GPU_QFPROM_PA, 0x1000);
+	uint32_t bin = fuse ? (rd(fuse, GPU_SPEED_BIN_OFF) & 0xe0000000u) >> 29 : 0;
+	gpu_levels = bin == 1 ? gpu_bin1 : gpu_bin0;
+	gpu_nlevels = bin == 1 ? sizeof(gpu_bin1) / sizeof(gpu_bin1[0]) : sizeof(gpu_bin0) / sizeof(gpu_bin0[0]);
+	printf("SWEET GPU: speed bin %u (fuse %#x): %u GPU levels up to %u kHz\n", bin,
+	    fuse ? rd(fuse, GPU_SPEED_BIN_OFF) : 0, gpu_nlevels, gpu_levels[gpu_nlevels - 1].khz);
+	if (sweet_rpmh_cmd_db("gfx.lvl", RH_ARC, &a_gfx, gfx, ARC_MAX, &ngfx) ||
+	    sweet_rpmh_cmd_db("cx.lvl", RH_ARC, &a_cx, cx, ARC_MAX, &ncx) ||
+	    sweet_rpmh_cmd_db("mx.lvl", RH_ARC, &a_mx, mx, ARC_MAX, &nmx)) {
+		printf("SWEET GPU: no rail levels in the command DB\n");
+		return false;
+	}
+	printf("SWEET GPU: rails gfx %#x %u levels (%u..%u), cx %#x %u (%u..%u), mx %#x %u (%u..%u)\n", a_gfx, ngfx,
+	    gfx[0], gfx[ngfx - 1], a_cx, ncx, cx[0], cx[ncx - 1], a_mx, nmx, mx[0], mx[nmx - 1]);
+
+	uint32_t fw_ver[2] = { HFI_HDR(H2F_FW_VER, 2), HFI_GMU_VERSION };
+	if (!hfi_send("FW_VER", fw_ver, reply, 8)) {
+		return false;
+	}
+	printf("SWEET GPU: GMU firmware version %#x (wanted major 2)\n", reply[3]);
+
+	/* struct hfi_dcvstable_cmd: hdr, gpu_level_num, gmu_level_num, gx {vote, acd, freq}[16], cx {vote, freq}[4] */
+	uint32_t perf[3 + 16 * 3 + 4 * 2];
+	bzero(perf, sizeof(perf));
+	perf[0] = HFI_HDR(H2F_PERF_TBL, sizeof(perf) / 4);
+	perf[1] = gpu_nlevels;
+	perf[2] = sizeof(gmu_levels) / sizeof(gmu_levels[0]);
+	for (unsigned i = 0; i < gpu_nlevels; i++) {
+		if (!arc_vote(gfx, ngfx, mx, nmx, gpu_levels[i].vlvl, &perf[3 + 3 * i])) {
+			printf("SWEET GPU: gfx rail has no level %u\n", gpu_levels[i].vlvl);
+			return false;
+		}
+		perf[3 + 3 * i + 1] = 0xffffffffu;
+		perf[3 + 3 * i + 2] = gpu_levels[i].khz;
+		printf("SWEET GPU: GPU level %u: %u kHz, vote %#x\n", i, gpu_levels[i].khz, perf[3 + 3 * i]);
+	}
+	for (unsigned i = 0; i < perf[2]; i++) {
+		if (!arc_vote(cx, ncx, mx, nmx, gmu_levels[i].vlvl, &perf[3 + 48 + 2 * i])) {
+			printf("SWEET GPU: cx rail has no level %u\n", gmu_levels[i].vlvl);
+			return false;
+		}
+		perf[3 + 48 + 2 * i + 1] = gmu_levels[i].khz;
+		printf("SWEET GPU: GMU level %u: %u kHz, vote %#x\n", i, gmu_levels[i].khz, perf[3 + 48 + 2 * i]);
+	}
+	if (!hfi_send("PERF_TBL", perf, reply, 8)) {
+		return false;
+	}
+
+	/*
+	 * struct hfi_bwtable_cmd: hdr, bw_level_num, cnoc_cmds_num, ddr_cmds_num, cnoc_wait_bitmask,
+	 * ddr_wait_bitmask, cnoc_cmd_addrs[6], cnoc_cmd_data[2][6], ddr_cmd_addrs[8], ddr_cmd_data[16][8]
+	 */
+	uint32_t bw[6 + 6 + 12 + 8 + 128], mc0 = 0x50000u, sh0 = 0x5003cu, acv = 0x5000cu, cn0 = 0x50034u;
+	(void)sweet_rpmh_cmd_db("MC0", RH_BCM, &mc0, NULL, 0, NULL);
+	(void)sweet_rpmh_cmd_db("SH0", RH_BCM, &sh0, NULL, 0, NULL);
+	(void)sweet_rpmh_cmd_db("ACV", RH_BCM, &acv, NULL, 0, NULL);
+	(void)sweet_rpmh_cmd_db("CN0", RH_BCM, &cn0, NULL, 0, NULL);
+	printf("SWEET GPU: bus table: ddr MC0 %#x SH0 %#x ACV %#x, cnoc CN0 %#x (upstream a640: 0x50000 0x5003c 0x5000c, 0x50034)\n",
+	    mc0, sh0, acv, cn0);
+	bzero(bw, sizeof(bw));
+	bw[0] = HFI_HDR(H2F_BW_VOTE_TBL, sizeof(bw) / 4);
+	bw[1] = 1;                      /* bw_level_num */
+	bw[2] = 1;                      /* cnoc_cmds_num */
+	bw[3] = 3;                      /* ddr_cmds_num */
+	bw[4] = 1;                      /* cnoc_wait_bitmask */
+	bw[5] = 1;                      /* ddr_wait_bitmask */
+	bw[6] = cn0;                    /* cnoc_cmd_addrs[0] */
+	bw[12] = 0x40000000u;           /* cnoc_cmd_data[0][0]: commit, off */
+	bw[18] = 0x60000001u;           /* cnoc_cmd_data[1][0]: commit, valid, 1 */
+	bw[24] = mc0;                   /* ddr_cmd_addrs */
+	bw[25] = sh0;
+	bw[26] = acv;
+	bw[32] = bw[33] = bw[34] = 0x40000000u;  /* ddr_cmd_data[0]: commit, off */
+	if (!hfi_send("BW_VOTE_TBL", bw, reply, 8)) {
+		return false;
+	}
+
+	uint32_t ecp[4] = { HFI_HDR(H2F_FEATURE_CTRL, 4), HFI_FEATURE_ECP, 0, 0 };
+	if (!hfi_send("FEATURE_CTRL ECP off", ecp, reply, 8)) {
+		return false;
+	}
+	uint32_t start[2] = { HFI_HDR(H2F_CORE_FW_START, 2), 0 };
+	return hfi_send("CORE_FW_START", start, reply, 8);
+}
+
+/* Step 15: the default level, OOB gpu - the GMU powers GX; then the 3D core's status registers. */
+static bool
+gmu_gx_on(void)
+{
+	uint32_t reply[8];
+	/* kgsl gmu_dcvs_set(default pwrlevel): freq index = levels - initial-pwrlevel - 1 = 257 MHz for both bins */
+	uint32_t vote[4] = { HFI_HDR(H2F_GX_BW_PERF_VOTE, 4), 1 /* DCVS_ACK_BLOCK */, 1, HFI_INVALID_IDX };
+	if (!hfi_send("GX_BW_PERF_VOTE 257 MHz", vote, reply, 8)) {
+		return false;
+	}
+	printf("SWEET GPU: before OOB: sptprac %#x rpmh_power_state %#x gx-gdsc %#x gmu2host %#x\n",
+	    rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS), rd(gmu, GMU_RPMH_POWER_STATE), rd(gpucc, GPUCC_GX_GDSCR),
+	    rd(gmu, GMU_GMU2HOST_INTR_INFO));
+	wr(gmu, GMU_HOST2GMU_INTR_SET, OOB_GPU_SET);
+	unsigned waited;
+	for (waited = 0; waited < 1000 && !(rd(gmu, GMU_GMU2HOST_INTR_INFO) & OOB_GPU_ACK); waited++) {
+		delay(100);
+	}
+	bool acked = (rd(gmu, GMU_GMU2HOST_INTR_INFO) & OOB_GPU_ACK) != 0;
+	wr(gmu, GMU_GMU2HOST_INTR_CLR, OOB_GPU_ACK);
+	uint32_t sp = rd(gmu, GMU_SPTPRAC_PWR_CLK_STATUS);
+	bool on = !(sp & GMU_GX_OFF);
+	printf("SWEET GPU: OOB gpu %s after %u us; sptprac %#x rpmh_power_state %#x gx-gdsc %#x%s\n",
+	    acked ? "acked" : "NOT ACKED", waited * 100u, sp, rd(gmu, GMU_RPMH_POWER_STATE), rd(gpucc, GPUCC_GX_GDSCR),
+	    on ? " - GX IS ON" : " - GX is off");
+	hfi_drain_debug();
+	smmu_fault_report("after OOB gpu");
+	if (!acked || !on) {
+		return false;
+	}
+	gpu3d = ml_io_map(GPU_3D_PA, GPU_3D_SIZE);
+	if (gpu3d) {
+		printf("SWEET GPU: 3D core: RBBM_STATUS %#x RBBM_STATUS3 %#x CP_HW_FAULT %#x\n", rd(gpu3d, GPU_RBBM_STATUS),
+		    rd(gpu3d, GPU_RBBM_STATUS3), rd(gpu3d, GPU_CP_HW_FAULT));
+	}
+	return gpu3d != 0;
+}
+
+/*
+ * ---- milestone 4: the command processor (steps 16-19) ----
+ *
+ * HakiOS steps 18, 20, 21 with the a640 values of kgsl a6xx_start / a6xx_rb_start (vayu dt: GMEM 1 MB
+ * at GPU address 0x100000, highest-bank-bit 15, min-access-length 32, ubwc-mode 3; GBIF). The 3D
+ * core's requests (stream 0, dt gfx3d_user iommus <0 0x401>) go through another SMMU context into
+ * the same table tree as the GMU's: ring 32K at 0x01000000, the CP microcode (a630_sqe.fw without
+ * its first word) at 0x01100000, a scratch page at 0x01200000. Commands are PM4 type 7 packets with
+ * parity (adreno_pm4types.h); the ring's read pointer is not copied to memory (CP_RB_CNTL bit 27):
+ * CP_RB_RPTR is polled. The core starts in secure mode: a zap shader (TrustZone, PAS 13) takes it
+ * out (CP_SET_SECURE_MODE 0); without one kgsl writes RBBM_SECVID_TRUST_CNTL = 0 itself. Step 18
+ * first tries a memory write as the core is; step 19 only if that did not land.
+ */
+#define GPU_REG(w)              ((w) * 4u)
+#define CP_RB_BASE              GPU_REG(0x800u)
+#define CP_RB_CNTL              GPU_REG(0x802u)
+#define CP_RB_RPTR              GPU_REG(0x806u)
+#define CP_RB_WPTR              GPU_REG(0x807u)
+#define CP_SQE_CNTL             GPU_REG(0x808u)
+#define CP_INTERRUPT_STATUS     GPU_REG(0x823u)
+#define CP_PROTECT_STATUS       GPU_REG(0x824u)
+#define CP_SQE_INSTR_BASE       GPU_REG(0x830u)
+#define CP_ROQ_THRESHOLDS_1     GPU_REG(0x8c1u)
+#define CP_ROQ_THRESHOLDS_2     GPU_REG(0x8c2u)
+#define CP_MEM_POOL_SIZE        GPU_REG(0x8c3u)
+#define CP_AHB_CNTL             GPU_REG(0x98du)
+#define RBBM_GBIF_CLIENT_QOS_CNTL GPU_REG(0x011u)
+#define RBBM_GBIF_HALT          GPU_REG(0x016u)
+#define RBBM_INTERFACE_HANG_INT_CNTL GPU_REG(0x01fu)
+#define RBBM_INT_0_STATUS       GPU_REG(0x201u)
+#define RBBM_PERFCTR_CNTL       GPU_REG(0x500u)
+#define RBBM_PERFCTR_GPU_BUSY_MASKED GPU_REG(0x50bu)
+#define UCHE_MODE_CNTL          GPU_REG(0xe01u)
+#define UCHE_WRITE_RANGE_MAX    GPU_REG(0xe05u)
+#define UCHE_WRITE_THRU_BASE    GPU_REG(0xe07u)
+#define UCHE_TRAP_BASE          GPU_REG(0xe09u)
+#define UCHE_GMEM_RANGE_MIN     GPU_REG(0xe0bu)
+#define UCHE_GMEM_RANGE_MAX     GPU_REG(0xe0du)
+#define UCHE_CACHE_WAYS         GPU_REG(0xe17u)
+#define UCHE_FILTER_CNTL        GPU_REG(0xe18u)
+#define UCHE_CLIENT_PF          GPU_REG(0xe19u)
+#define GBIF_QSB_SIDE0          GPU_REG(0x3c03u)
+#define GBIF_HALT               GPU_REG(0x3c45u)
+#define RB_NC_MODE_CNTL         GPU_REG(0x8e08u)
+#define PC_DBG_ECO_CNTL         GPU_REG(0x9e00u)
+#define SP_NC_MODE_CNTL         GPU_REG(0xae02u)
+#define TPL1_NC_MODE_CNTL       GPU_REG(0xb604u)
+#define RBBM_SECVID_TRUST_CNTL  GPU_REG(0xf400u)
+#define RBBM_SECVID_TSB_TRUSTED_BASE GPU_REG(0xf800u)
+#define RBBM_SECVID_TSB_TRUSTED_SIZE GPU_REG(0xf802u)
+#define RBBM_SECVID_TSB_CNTL    GPU_REG(0xf803u)
+#define CP_RB_CNTL_VALUE        (12u | 2u << 8 | 1u << 27)      /* 2^12 quadwords, no read pointer in memory */
+#define PM4_ME_INIT             0x48u
+#define PM4_MEM_WRITE           0x3du
+#define CORE_STREAM             0u
+#define CORE_STREAM_MASK        0x401u
+#define CORE_RING_VA            0x01000000u
+#define CORE_RING_SIZE          0x8000u
+#define CORE_SQE_VA             0x01100000u
+#define CORE_SCRATCH_VA         0x01200000u
+#define PTE_CORE                (PTE_GMU | (1ull << 6))         /* + unprivileged access, as HakiOS */
+#define PTE_RO                  (1ull << 7)
+#define GMEM_BASE               0x00100000u
+#define GMEM_SIZE               0x00100000u
+
+static vm_offset_t core_ring, core_sqe, core_scratch;
+static uint32_t core_ctx = ~0u, ring_at, ring_sent;
+
+static uint32_t
+odd_parity(uint32_t v)
+{
+	return 0x9669u >> (0xfu & (v ^ v >> 4 ^ v >> 8 ^ v >> 12 ^ v >> 16 ^ v >> 20 ^ v >> 24 ^ v >> 28)) & 1u;
+}
+
+static void
+ring(uint32_t word)
+{
+	((volatile uint32_t *)core_ring)[ring_at] = word;
+	ring_at = (ring_at + 1u) % (CORE_RING_SIZE / 4u);
+}
+
+static void
+ring_cmd(uint32_t op, uint32_t words)
+{
+	ring(7u << 28 | words | odd_parity(words) << 15 | op << 16 | odd_parity(op) << 23);
+}
+
+static void
+wr64(vm_offset_t base, uint32_t off, uint64_t v)
+{
+	wr(base, off, (uint32_t)v);
+	wr(base, off + 4u, (uint32_t)(v >> 32));
+}
+
+/* Hand the core what is new in the ring; wait (2 s) until it has read it all and is idle. */
+static bool
+ring_run(const char *what)
+{
+	uint32_t taken = ~0u, status = ~0u;
+	to_memory(core_ring, CORE_RING_SIZE);
+	ring_sent = ring_at;
+	wr(gpu3d, CP_RB_WPTR, ring_at);
+	for (unsigned i = 0; i < 20000 && (taken != ring_at || (status & ~1u)); i++) {
+		delay(100);
+		taken = rd(gpu3d, CP_RB_RPTR);
+		status = rd(gpu3d, GPU_RBBM_STATUS);
+	}
+	bool fault = smmu_fault_ctx(core_ctx, what);
+	bool ok = taken == ring_at && !(status & ~1u) && rd(gpu3d, GPU_CP_HW_FAULT) == 0 && !fault;
+	printf("SWEET GPU: %s: ring read %u of %u, rbbm_status %#x, rbbm_int %#x, cp: fault %#x int %#x protect %#x%s\n",
+	    what, taken, ring_at, status, rd(gpu3d, RBBM_INT_0_STATUS), rd(gpu3d, GPU_CP_HW_FAULT),
+	    rd(gpu3d, CP_INTERRUPT_STATUS), rd(gpu3d, CP_PROTECT_STATUS), ok ? " - DONE" : " - NOT DONE");
+	return ok;
+}
+
+/* Kernel memory for the core, mapped at va with attr; zeroed and pushed to memory. */
+static vm_offset_t
+core_buffer(uint32_t va, uint32_t size, uint64_t attr)
+{
+	vm_offset_t kva = 0;
+	if (kmem_alloc(kernel_map, &kva, round_page(size), KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return 0;
+	}
+	for (uint32_t off = 0; off < size; off += 4096u) {
+		if (!pt_map_attr(va + off, kvtophys(kva + off), attr)) {
+			printf("SWEET GPU: page tables full at %#x\n", va + off);
+			return 0;
+		}
+	}
+	return kva;
+}
+
+/* Step 16: the core's memory and its SMMU context (stream 0, mask 0x401). */
+static bool
+core_memory(void)
+{
+	uint32_t smr = ~0u;
+	if (sqe_fw == NULL || sqe_fw_size <= 4) {
+		printf("SWEET GPU: no CP microcode\n");
+		return false;
+	}
+	for (uint32_t i = 0; i < smmu_ncb && core_ctx == ~0u; i++) {
+		if (i != smmu_ctx && !(rd(smmu, cb(i) + SMMU_CB_SCTLR) & 1)) {
+			core_ctx = i;
+		}
+	}
+	for (uint32_t i = 0; i < smmu_nsmr && smr == ~0u; i++) {
+		if (!(rd(smmu, SMMU_SMR(i)) & SMMU_SMR_VALID)) {
+			smr = i;
+		}
+	}
+	printf("SWEET GPU: 3D core stream %u/%#x goes through context %d, match %d\n", CORE_STREAM, CORE_STREAM_MASK,
+	    (int)core_ctx, (int)smr);
+	if (core_ctx == ~0u || smr == ~0u) {
+		return false;
+	}
+	core_ring = core_buffer(CORE_RING_VA, CORE_RING_SIZE, PTE_CORE);
+	core_sqe = core_buffer(CORE_SQE_VA, sqe_fw_size - 4u, PTE_CORE | PTE_RO);
+	core_scratch = core_buffer(CORE_SCRATCH_VA, 4096u, PTE_CORE);
+	if (!core_ring || !core_sqe || !core_scratch) {
+		return false;
+	}
+	memcpy((void *)core_sqe, sqe_fw + 4, sqe_fw_size - 4u);         /* the first word is not microcode */
+	to_memory(core_sqe, sqe_fw_size - 4u);
+	to_memory(core_ring, CORE_RING_SIZE);
+	to_memory(core_scratch, 4096u);
+	for (unsigned i = 0; i < pt_count; i++) {
+		to_memory((vm_offset_t)pt_table[i], 4096);
+	}
+	printf("SWEET GPU: ring %#x -> pa %#llx, microcode %#x (%u bytes) -> pa %#llx, scratch %#x -> pa %#llx; %u tables\n",
+	    CORE_RING_VA, kvtophys(core_ring), CORE_SQE_VA, sqe_fw_size - 4u, kvtophys(core_sqe), CORE_SCRATCH_VA,
+	    kvtophys(core_scratch), pt_count);
+	/* the GMU's context shares the tables: its cached walks of them are dropped too */
+	wr(smmu, cb(smmu_ctx) + SMMU_CB_TLBIASID, smmu_ctx);
+	return smmu_attach(core_ctx, smr, CORE_STREAM, CORE_STREAM_MASK);
+}
+
+/* Step 17: a6xx_start (a640), the ring and microcode, the CP out of halt, CP_ME_INIT. */
+static bool
+core_start(void)
+{
+	wr(gpu3d, GBIF_HALT, 0);
+	wr(gpu3d, RBBM_GBIF_HALT, 0);
+	wr(gpu3d, RBBM_SECVID_TSB_CNTL, 0);
+	wr64(gpu3d, RBBM_SECVID_TSB_TRUSTED_BASE, 0);
+	wr(gpu3d, RBBM_SECVID_TSB_TRUSTED_SIZE, 0);
+	static const uint32_t addr_mode[] = { 0x842, 0xc01, 0x8601, 0x8e05, 0x9e01, 0xbe05, 0xa601, 0x9601, 0xe00,
+		                              0xae01, 0xb601, 0xf810 };      /* a6xx_enable_64bit */
+	for (unsigned i = 0; i < sizeof(addr_mode) / sizeof(addr_mode[0]); i++) {
+		wr(gpu3d, GPU_REG(addr_mode[i]), 1);
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		wr(gpu3d, GBIF_QSB_SIDE0 + 4u * i, 0x00071620u);        /* a640_gbif */
+	}
+	wr(gpu3d, RBBM_GBIF_CLIENT_QOS_CNTL, 3);
+	wr(gpu3d, RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffffu);
+	wr64(gpu3d, UCHE_WRITE_RANGE_MAX, 0x0001ffffffffffc0ull);
+	wr64(gpu3d, UCHE_TRAP_BASE, 0x0001fffffffff000ull);
+	wr64(gpu3d, UCHE_WRITE_THRU_BASE, 0x0001fffffffff000ull);
+	wr64(gpu3d, UCHE_GMEM_RANGE_MIN, GMEM_BASE);
+	wr64(gpu3d, UCHE_GMEM_RANGE_MAX, GMEM_BASE + GMEM_SIZE - 1u);
+	wr(gpu3d, UCHE_FILTER_CNTL, 0x804);
+	wr(gpu3d, UCHE_CACHE_WAYS, 0x4);
+	wr(gpu3d, CP_ROQ_THRESHOLDS_2, 0x02000140u);    /* a640 */
+	wr(gpu3d, CP_ROQ_THRESHOLDS_1, 0x8040362cu);
+	wr(gpu3d, CP_MEM_POOL_SIZE, 128);
+	wr(gpu3d, PC_DBG_ECO_CNTL, 0x400u << 11);       /* a640 primFifo threshold */
+	wr(gpu3d, CP_AHB_CNTL, 1);
+	wr(gpu3d, RBBM_PERFCTR_CNTL, 1);
+	/* UBWC 3.0: mode 0 + amsbc; hbb 15 -> 2; mal 32 -> 0 */
+	wr(gpu3d, RB_NC_MODE_CNTL, 1u << 4 | 2u << 1);
+	wr(gpu3d, TPL1_NC_MODE_CNTL, 2u << 1);
+	wr(gpu3d, SP_NC_MODE_CNTL, 2u << 1);
+	wr(gpu3d, UCHE_MODE_CNTL, 2u << 21);
+	wr(gpu3d, RBBM_INTERFACE_HANG_INT_CNTL, 1u << 30 | 0xcfffffu);
+	wr(gpu3d, UCHE_CLIENT_PF, 1);
+	wr64(gpu3d, CP_SQE_INSTR_BASE, CORE_SQE_VA);
+	wr64(gpu3d, CP_RB_BASE, CORE_RING_VA);
+	wr(gpu3d, CP_RB_CNTL, CP_RB_CNTL_VALUE);
+	printf("SWEET GPU: sqe_instr_base %#x rb_base %#x rb_cntl %#x rb_rptr %u wptr %u rbbm_status %#x\n",
+	    rd(gpu3d, CP_SQE_INSTR_BASE), rd(gpu3d, CP_RB_BASE), rd(gpu3d, CP_RB_CNTL), rd(gpu3d, CP_RB_RPTR),
+	    rd(gpu3d, CP_RB_WPTR), rd(gpu3d, GPU_RBBM_STATUS));
+	wr(gpu3d, CP_SQE_CNTL, 1);
+	sleep_ms(20);
+	printf("SWEET GPU: CP out of halt: rbbm_status %#x rbbm_int %#x cp: fault %#x int %#x protect %#x, rptr %u\n",
+	    rd(gpu3d, GPU_RBBM_STATUS), rd(gpu3d, RBBM_INT_0_STATUS), rd(gpu3d, GPU_CP_HW_FAULT),
+	    rd(gpu3d, CP_INTERRUPT_STATUS), rd(gpu3d, CP_PROTECT_STATUS), rd(gpu3d, CP_RB_RPTR));
+	if (smmu_fault_ctx(core_ctx, "after the CP start")) {
+		return false;
+	}
+	ring_cmd(PM4_ME_INIT, 8);                       /* upstream a6xx_cp_init */
+	ring(0x0000002fu);
+	ring(0x00000003u);                              /* multiple hardware contexts */
+	ring(0x20000000u);                              /* error detection */
+	for (unsigned i = 0; i < 5; i++) {
+		ring(0);
+	}
+	return ring_run("CP_ME_INIT");
+}
+
+/* Steps 18-19: CP_MEM_WRITE of a word into the scratch page; true if it is there. */
+static bool
+core_write(uint32_t value)
+{
+	ring_cmd(PM4_MEM_WRITE, 3);
+	ring(CORE_SCRATCH_VA);
+	ring(0);
+	ring(value);
+	(void)ring_run("CP_MEM_WRITE");
+	to_memory(core_scratch, 64);
+	uint32_t got = *(volatile uint32_t *)core_scratch;
+	printf("SWEET GPU: scratch reads %#x (told %#x)%s\n", got, value,
+	    got == value ? " - THE 3D CORE WRITES OUR MEMORY ON COMMAND" : "");
+	return got == value;
+}
+
+static void
+gpu_thread(void *arg, wait_result_t result)
+{
+	unsigned last = (unsigned)(uintptr_t)arg, delay_s = 40;
+	(void)result;
+	(void)PE_parse_boot_argn("sweetgpudelay", &delay_s, sizeof(delay_s));
+	printf("SWEET GPU: Adreno 640 milestone 1, steps 1..%u in %u s\n", last, delay_s);
+	sleep_ms(delay_s * 1000u);
+	gcc = ml_io_map(GPU_GCC_PA, GPU_GCC_SIZE);
+	gpucc = ml_io_map(GPU_CC_PA, GPU_CC_SIZE);
+	gmu = ml_io_map(GPU_GMU_PA, GPU_GMU_SIZE);
+	smmu = ml_io_map(GPU_SMMU_PA, GPU_SMMU_SIZE);
+	if (!gcc || !gpucc || !gmu || !smmu) {
+		printf("SWEET GPU: MMIO mapping failed\n");
+		goto out;
+	}
+
+	announce(1, "read GCC GPU clocks, GPU_CC clocks, GPU GDSCs");
+	dump_clocks();
+	dump_gpucc();
+	if (last < 2) {
+		goto out;
+	}
+
+	announce(2, "GCC: vote GPLL0 for the GPU, enable cfg-ahb, memnoc, snoc-dvm, ddrss-axi");
+	wr(gcc, GCC_APCS_VOTE2, rd(gcc, GCC_APCS_VOTE2) | (1u << 15) | (1u << 16));
+	/*
+	 * memnoc-gfx and snoc-dvm-gfx feed the GPU's power domain and stay CLK_OFF until the CX GDSC
+	 * is up (phone, iOS/runs/gpu-1); they are enabled here and checked again after step 3.
+	 */
+	bool ok = branch_on(gcc, GCC_GPU_CFG_AHB, "gcc_gpu_cfg_ahb");
+	(void)branch_on(gcc, GCC_GPU_MEMNOC_GFX, "gcc_gpu_memnoc_gfx");
+	(void)branch_on(gcc, GCC_GPU_SNOC_DVM_GFX, "gcc_gpu_snoc_dvm_gfx");
+	ok = branch_on(gcc, GCC_DDRSS_GPU_AXI, "gcc_ddrss_gpu_axi") && ok;
+	dump_clocks();
+	if (!ok || last < 3) {
+		goto out;
+	}
+
+	announce(3, "CX GDSC on; GPU_CC: cxo, ahb");
+	dump_gpucc();
+	/*
+	 * Like KGSL (vddcx regulator before the clocks): the CX branches read CLK_OFF until the CX GDSC
+	 * is up (phone, iOS/runs/ios-gpu2). gpu_cc_ahb is BRANCH_HALT_DELAY in gpucc-sm8150.c - its
+	 * CLK_OFF bit is not meaningful, so it is enabled and not checked.
+	 */
+	uint32_t g = rd(gpucc, GPUCC_CX_GDSCR);
+	if (g & GDSC_PWR_ON) {
+		printf("SWEET GPU: CX GDSC already on (%#x)\n", g);
+	} else {
+		wr(gpucc, GPUCC_CX_GDSCR, g & ~GDSC_SW_COLLAPSE);
+		for (unsigned i = 0; i < 500 && !((g = rd(gpucc, GPUCC_CX_GDSCR)) & GDSC_PWR_ON); i++) {
+			delay(10);
+		}
+		printf("SWEET GPU: CX GDSC %s (%#x)\n", (g & GDSC_PWR_ON) ? "ON" : "DID NOT POWER UP", g);
+	}
+	ok = (g & GDSC_PWR_ON) != 0;
+	wr(gpucc, GPUCC_AHB, rd(gpucc, GPUCC_AHB) | CBCR_ENABLE);
+	if (ok) {
+		ok = branch_on(gpucc, GPUCC_CXO, "gpu_cc_cxo (CX on)");
+		ok = branch_on(gcc, GCC_GPU_MEMNOC_GFX, "gcc_gpu_memnoc_gfx (CX on)") && ok;
+		ok = branch_on(gcc, GCC_GPU_SNOC_DVM_GFX, "gcc_gpu_snoc_dvm_gfx (CX on)") && ok;
+	}
+	dump_clocks();
+	dump_gpucc();
+	if (!ok || last < 4) {
+		goto out;
+	}
+
+	announce(4, "GPU_CC: GMU clock 200 MHz from GPLL0 main div, cx-gmu and cx-snoc-dvm");
+	/* clk-rcg2: CFG = source 6 (GPLL0_OUT_MAIN_DIV) << 8 | half-integer divider 1.5 -> 2 */
+	wr(gpucc, GPUCC_GMU_RCG_CMD + 4, (rd(gpucc, GPUCC_GMU_RCG_CMD + 4) & ~0x71fu) | (6u << 8) | 2u);
+	wr(gpucc, GPUCC_GMU_RCG_CMD, rd(gpucc, GPUCC_GMU_RCG_CMD) | RCG_UPDATE);
+	for (unsigned i = 0; i < 500 && (rd(gpucc, GPUCC_GMU_RCG_CMD) & RCG_UPDATE); i++) {
+		delay(10);
+	}
+	ok = !(rd(gpucc, GPUCC_GMU_RCG_CMD) & RCG_UPDATE);
+	printf("SWEET GPU: GMU RCG %s (cmd %#x cfg %#x)\n", ok ? "updated" : "UPDATE STUCK",
+	    rd(gpucc, GPUCC_GMU_RCG_CMD), rd(gpucc, GPUCC_GMU_RCG_CMD + 4));
+	ok = branch_on(gpucc, GPUCC_CX_GMU, "gpu_cc_cx_gmu") && ok;
+	ok = branch_on(gpucc, GPUCC_CX_SNOC_DVM, "gpu_cc_cx_snoc_dvm") && ok;
+	dump_gpucc();
+	if (!ok || last < 5) {
+		goto out;
+	}
+
+	announce(5, "GMU: always-on counter twice, 20 ms apart");
+	uint32_t l0 = rd(gmu, GMU_AO_COUNTER_L), h0 = rd(gmu, GMU_AO_COUNTER_H);
+	uint64_t t0 = mach_absolute_time();
+	sleep_ms(20);
+	uint32_t l1 = rd(gmu, GMU_AO_COUNTER_L), h1 = rd(gmu, GMU_AO_COUNTER_H);
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	uint64_t c0 = (uint64_t)h0 << 32 | l0, c1 = (uint64_t)h1 << 32 | l1;
+	uint64_t khz = ns ? (c1 - c0) * 1000000ull / ns : 0;
+	printf("SWEET GPU: GMU always-on %#llx -> %#llx in %llu us: %llu kHz%s; CM3 sysreset %#x\n", c0, c1, ns / 1000,
+	    khz, (khz > 18000 && khz < 20500) ? " - THE GPU BLOCK IS ALIVE" : "", rd(gmu, GMU_CM3_SYSRESET));
+	if (last < 6) {
+		goto out;
+	}
+
+	announce(6, "SMMU: ID registers 0..2");
+	printf("SWEET GPU: SMMU IDR0 %#x IDR1 %#x IDR2 %#x CR0 %#x\n", rd(smmu, 0x20), rd(smmu, 0x24),
+	    rd(smmu, 0x28), rd(smmu, 0x0));
+	if (last < 7) {
+		goto out;
+	}
+
+	announce(7, "TrustZone: call available; PAS is-supported for the GPU (13)");
+	uint64_t how = SCM_FAST | SCM_64 | SCM_SIP, ans = 0;
+	int32_t r = scm(how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, how | SCM_IS_CALL_AVAILABLE, &ans);
+	printf("SWEET GPU: TrustZone is-call-available(is-call-available): ret %d answer %#llx\n", r, ans);
+	r = scm(how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, how | SCM_PAS_IS_SUPPORTED, &ans);
+	printf("SWEET GPU: TrustZone is-call-available(pas-is-supported): ret %d answer %#llx\n", r, ans);
+	r = scm(how | SCM_PAS_IS_SUPPORTED, SCM_ONE_VALUE, PAS_GPU, &ans);
+	printf("SWEET GPU: TrustZone pas-is-supported(13): ret %d answer %#llx\n", r, ans);
+	printf("SWEET GPU: milestone 1 done\n");
+	if (last < 8) {
+		goto out;
+	}
+
+	announce(8, "SMMU: layout, stream matches and contexts as left; pick a context for the GMU");
+	if (!gmu_smmu_survey() || last < 9) {
+		goto out;
+	}
+	announce(9, "GMU memory: firmware blob, ICACHE/DCACHE/HFI/log in DDR, page tables, SMMU context for stream 5");
+	if (!gmu_memory() || last < 10) {
+		goto out;
+	}
+	announce(10, "RSCC and PDC sequences (GMU+0x23000, pdc cfg 0xb290000, seq 0xb490000)");
+	if (!gmu_rpmh_ucode() || last < 11) {
+		goto out;
+	}
+	announce(11, "GMU firmware: TCMs through registers, the rest into DDR");
+	if (!gmu_firmware() || last < 12) {
+		goto out;
+	}
+	announce(12, "GMU registers, HFI table; CM3 out of reset, wait for 0xbabeface");
+	if (!gmu_start() || last < 13) {
+		goto out;
+	}
+	announce(13, "HFI init");
+	if (!gmu_hfi()) {
+		goto out;
+	}
+	printf("SWEET GPU: milestone 2 done\n");
+	if (last < 14) {
+		goto out;
+	}
+	announce(14, "HFI: FW_VER, PERF_TBL, BW_VOTE_TBL, ECP off, CORE_FW_START");
+	if (!gmu_hfi_tables() || last < 15) {
+		goto out;
+	}
+	announce(15, "default GPU level, OOB gpu: the GMU powers GX; 3D core status");
+	if (!gmu_gx_on()) {
+		goto out;
+	}
+	printf("SWEET GPU: milestone 3 done - GX is on\n");
+	if (last < 16) {
+		goto out;
+	}
+	announce(16, "3D core memory: ring, CP microcode, scratch; SMMU context for stream 0");
+	if (!core_memory() || last < 17) {
+		goto out;
+	}
+	announce(17, "a640 hw init, ring and microcode, CP out of halt, CP_ME_INIT");
+	if (!core_start() || last < 18) {
+		goto out;
+	}
+	announce(18, "CP_MEM_WRITE into the scratch page (secure mode as it is)");
+	bool wrote = core_write(0x600dc0deu);
+	if (!wrote && last >= 19) {
+		announce(19, "RBBM_SECVID_TRUST_CNTL = 0 (kgsl without a zap shader), CP_MEM_WRITE again");
+		wr(gpu3d, RBBM_SECVID_TRUST_CNTL, 0);
+		printf("SWEET GPU: secvid_trust_cntl reads %#x\n", rd(gpu3d, RBBM_SECVID_TRUST_CNTL));
+		wrote = core_write(0x0dd0c0deu);
+	}
+	if (wrote) {
+		printf("SWEET GPU: milestone 4 done - the command processor runs our commands\n");
+	}
+out:
+	printf("SWEET GPU: stopped after step %u\n", step_now);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_adreno_init(void)
+{
+	static bool started;
+	unsigned last = 0;
+	thread_t thread;
+	if (started) {
+		return;
+	}
+	started = true;
+	(void)PE_parse_boot_argn("sweetgpu", &last, sizeof(last));
+	if (last == 0) {
+		return;
+	}
+	if (kernel_thread_start(gpu_thread, (void *)(uintptr_t)last, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
