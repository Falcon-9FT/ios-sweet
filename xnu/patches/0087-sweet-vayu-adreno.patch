+/*
+ * ---- milestone 2: the GMU (steps 8-13) ----
+ *
+ * The GMU is a Cortex-M3 in the CX half. Its firmware (a640_gmu.bin, blocks {addr, size, type,
+ * value} + data, kgsl load_gmu_fw) goes partly into its own TCMs through GMU registers and partly
+ * into DDR it reaches through the GPU SMMU, stream 5 (vayu dt gmu_kernel iommus <0x05 0x400>):
+ * ICACHE 0x4000 and DCACHE 0x44000 (240K each), the uncached kernel range 0x60000000 one 1M slot
+ * per buffer (write-back dummy, HFI queues, log; kgsl_gmu.c gmu_memory_probe order). Page
+ * tables: 3 levels of 4K, 39-bit input, memory attribute 0 (normal, non-cacheable) - HakiOS
+ * space_map/space_on, kgsl arm-smmu. The firmware blob comes in the payload right after the
+ * touch firmware (build-payload.sh GMUFW=, header "SWEETGMU" + u32 size + u32 0).
+ */
+#define GPU_PDC_CFG_PA          0x0b290000u     /* dt kgsl_gmu_pdc_cfg */
+#define GPU_PDC_SEQ_PA          0x0b490000u     /* dt kgsl_gmu_pdc_seq */
+#define GPU_PDC_SIZE            0x00010000u
+/* a6xx_reg.h */
+#define GMU_ITCM                GMU_REG(0x1b400u)
+#define GMU_DTCM                GMU_REG(0x1c400u)
+#define GMU_ICACHE_CONFIG       GMU_REG(0x1f400u)
+#define GMU_DCACHE_CONFIG       GMU_REG(0x1f401u)
+#define GMU_SYS_BUS_CONFIG      GMU_REG(0x1f40fu)
+#define GMU_CM3_BOOT_CONFIG     GMU_REG(0x1f801u)
+#define GMU_CX_GMU_WFI_CONFIG   GMU_REG(0x1f802u)
+#define GMU_CM3_FW_BUSY         GMU_REG(0x1f81au)
+#define GMU_CM3_FW_INIT_RESULT  GMU_REG(0x1f81cu)
+#define GMU_CM3_CFG             GMU_REG(0x1f82du)
+#define GMU_PWR_COL_INTER_FRAME_CTRL GMU_REG(0x1f8c0u)
+#define GMU_RPMH_CTRL           GMU_REG(0x1f8e8u)
+#define GMU_PWR_COL_CP_MSG      GMU_REG(0x1f900u)
+#define GMU_HFI_CTRL_STATUS     GMU_REG(0x1f980u)
+#define GMU_HFI_VERSION_INFO    GMU_REG(0x1f981u)
+#define GMU_HFI_SFR_ADDR        GMU_REG(0x1f982u)
+#define GMU_HFI_QTBL_INFO       GMU_REG(0x1f984u)
+#define GMU_HFI_QTBL_ADDR       GMU_REG(0x1f985u)
+#define GMU_HFI_CTRL_INIT       GMU_REG(0x1f986u)
+#define GMU_GMU2HOST_INTR_INFO  GMU_REG(0x1f992u)
+#define GMU_GENERAL_7           GMU_REG(0x1f9ccu)
+#define GMU_AO_HOST_INTR_STATUS GMU_REG(0x23b05u)
+#define GMU_AHB_FENCE_RANGE_0   GMU_REG(0x23b11u)
+#define RSCC_RSC_STATUS0_DRV0   GMU_REG(0x23404u)
+#define RSCC_PDC_SEQ_START_ADDR GMU_REG(0x23408u)
+#define RSCC_PDC_MATCH_VALUE_LO GMU_REG(0x23409u)
+#define RSCC_PDC_MATCH_VALUE_HI GMU_REG(0x2340au)
+#define RSCC_PDC_SLAVE_ID_DRV0  GMU_REG(0x2340bu)
+#define RSCC_HIDDEN_TCS_CMD0_ADDR GMU_REG(0x2340du)
+#define RSCC_HIDDEN_TCS_CMD0_DATA GMU_REG(0x2340eu)
+#define RSCC_OVERRIDE_START_ADDR GMU_REG(0x23500u)
+#define RSCC_SEQ_BUSY_DRV0      GMU_REG(0x23501u)
+#define RSCC_SEQ_MEM_0_DRV0     GMU_REG(0x23580u)
+/* PDC, word offsets in its cfg block */
+#define PDC_REG(w)              ((w) * 4u)
+#define PDC_GPU_ENABLE_PDC      PDC_REG(0x1140u)
+#define PDC_GPU_SEQ_START_ADDR  PDC_REG(0x1148u)
+#define PDC_GPU_TCS1_CONTROL    PDC_REG(0x1572u)
+#define PDC_GPU_TCS3_CONTROL    PDC_REG(0x15d6u)
+/* the GMU's view of memory (kgsl_gmu.c gmu_vma) */
+#define GMU_ITCM_VA             0x00000u
+#define GMU_TCM_SIZE            0x4000u
+#define GMU_DTCM_VA             0x40000u
+#define GMU_ICACHE_VA           0x04000u
+#define GMU_DCACHE_VA           0x44000u
+#define GMU_CACHE_SIZE          0x3c000u
+#define GMU_DUMMY_VA            0x60000000u
+#define GMU_HFI_VA              0x60100000u
+#define GMU_LOG_VA              0x60200000u
+#define GMU_STREAM              5u
+#define GMU_CHIPID              0x06040100u     /* 0x06040001 with minor/patch packed (a6xx_gmu_fw_start) */
+#define GMU_FENCE_RANGE         ((1u << 31) | ((0xau << 2) << 18) | 0x8a0u)
+#define GMU_RPMH_ENABLE         0xf11u          /* interface, LLC, DDR, MX, CX, GFX votes */
+#define GMU_BOOTED              0xbabefaceu
+/* MMU-500 */
+#define SMMU_IDR0               0x020u
+#define SMMU_IDR1               0x024u
+#define SMMU_SGFSR              0x048u
+#define SMMU_SMR(n)             (0x800u + 4u * (n))
+#define SMMU_S2CR(n)            (0xc00u + 4u * (n))
+#define SMMU_SMR_VALID          (1u << 31)
+#define SMMU_STREAM_MASK        0x400u          /* dt: every iommus of this SMMU */
+#define SMMU_CBAR(n)            (4u * (n))      /* in the GR1 page */
+#define SMMU_CBA2R(n)           (0x800u + 4u * (n))
+#define SMMU_CB_SCTLR           0x00u
+#define SMMU_CB_TCR2            0x10u
+#define SMMU_CB_TTBR0           0x20u
+#define SMMU_CB_TTBR1           0x28u
+#define SMMU_CB_TCR             0x30u
+#define SMMU_CB_MAIR0           0x38u
+#define SMMU_CB_MAIR1           0x3cu
+#define SMMU_CB_FSR             0x58u
+#define SMMU_CB_FAR             0x60u
+#define SMMU_CB_FSYNR0          0x68u
+#define SMMU_CB_TLBIASID        0x610u
+#define SMMU_CB_TLBSYNC         0x7f0u
+#define SMMU_CB_TLBSTATUS       0x7f4u
+#define SMMU_CBAR_S1            ((1u << 16) | (3u << 8) | (0xfu << 12))
+#define SMMU_SCTLR_ON           ((1u << 0) | (1u << 1) | (1u << 2) | (1u << 5) | (1u << 12))
+#define SMMU_TCR_39             (25u | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23))
+#define SMMU_TCR2_36            (1u | (1u << 4) | (7u << 15))
+#define SMMU_MAIR0              0xf404ff44u
+#define SMMU_FSR_ALL            0xc00001feu
+#define PTE_VALID               3ull            /* table / page descriptor */
+#define PTE_GMU                 ((2ull << 8) | (1ull << 10) | (1ull << 11))     /* inner shareable, AF, nG */
+#define PTE_ADDR                0x0000fffffffff000ull
+
+struct gmu_mem {
+	const char *name;
+	uint32_t va, size;
+	vm_offset_t kva;
+};
+static struct gmu_mem gmu_mem[] = {
+	{ "dummy", GMU_DUMMY_VA, 0x1000u, 0 },
+	{ "dcache", GMU_DCACHE_VA, GMU_CACHE_SIZE, 0 },
+	{ "icache", GMU_ICACHE_VA, GMU_CACHE_SIZE, 0 },
