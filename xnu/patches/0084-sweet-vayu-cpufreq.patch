+/*
+ * SWEET vayu (SM8150/SM8150-AC): CPU clocks. The OSM (Operating State Manager) of each
+ * frequency domain picks the clock and voltage of its cores from a lookup table; the OS
+ * only asks for a table row (Linux qcom-cpufreq-hw "v1": LUT at 0x110, 32-byte rows,
+ * desired perf state at 0x920; vayu DT qcom,clk-cpu-osm: domains at 0x18323000 (A55,
+ * cpu0-3), 0x18325800 (A76, cpu4-6), 0x18327800 (A76 prime, cpu7)). Nothing here sets
+ * voltages: the OSM and its CPR do, and LMh (qcom,limits-dcvs) still throttles in hardware.
+ *
+ * Without a cpufreq driver the cores stay at whatever state ABL left. Boot-arg sweetcpufreq:
+ *   0 off; 1 (default) report: the table, the requested state and each CPU's measured clock;
+ *   2 also request the highest row of every domain, then measure again.
+ * A clock is measured as dependent adds per counter tick on that CPU (1 add/cycle on A55
+ * and A76), with interrupts off for 2 ms.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach declarations not included by BSD's exported headers. */
+extern kern_return_t thread_terminate(thread_t);
+extern struct processor *cpu_to_processor(int cpu);
+extern struct processor *thread_bind(struct processor *processor);
+void sweet_cpufreq_init(void);
+
+#define CF_LUT          0x110u
+#define CF_ROW          32u
+#define CF_ROWS         40u
+#define CF_PERF_STATE   0x920u
+#define CF_XO_KHZ       19200u
+#define CF_ALT_KHZ      300000u         /* LUT source 0: the 300 MHz GPLL0 path */
+
+static const struct {
+	const char *name;
+	uint32_t pa;
+	int first_cpu, ncpu;
+} cf_dom[] = {
+	{ "A55", 0x18323000u, 0, 4 },
+	{ "A76", 0x18325800u, 4, 3 },
+	{ "A76 prime", 0x18327800u, 7, 1 },
+};
+#define CF_NDOM (sizeof(cf_dom) / sizeof(cf_dom[0]))
+
+static uint32_t
+cf_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+cf_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/* Rows of the table until the frequency repeats (the OSM's end marker); returns their count. */
+static unsigned
+cf_lut(vm_offset_t base, uint32_t *khz)
+{
+	unsigned n = 0;
+	for (unsigned i = 0; i < CF_ROWS; i++) {
+		uint32_t d = cf_rd(base, CF_LUT + i * CF_ROW);
+		uint32_t f = ((d >> 30) & 3u) ? (d & 0xffu) * CF_XO_KHZ : CF_ALT_KHZ;
+		if (i > 0 && f == khz[n - 1]) {
+			break;
+		}
+		khz[n++] = f;
+	}
+	return n;
+}
+
+static uint64_t
+cf_ticks(void)
+{
+	uint64_t t;
+	__asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(t));
+	return t;
+}
+
+/* Clock of the calling CPU in MHz: 64 dependent adds per round, rounds counted over ~2 ms. */
+static unsigned
+cf_measure_here(void)
+{
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+	uint64_t x = 0, rounds = 0, t0 = cf_ticks(), end = t0 + 2u * CF_XO_KHZ;
+	do {
+		__asm__ volatile(
+			".rept 64\n\tadd %0, %0, #1\n\t.endr"
+			: "+r"(x));
+		rounds++;
+	} while (cf_ticks() < end);
+	uint64_t dt = cf_ticks() - t0;
+	ml_set_interrupts_enabled(istate);
+	/* adds per tick * 19.2 MHz */
+	return (unsigned)((rounds * 64u * CF_XO_KHZ) / dt / 1000u);
+}
+
+static void
+cf_measure_all(const char *when)
+{
+	unsigned mhz[8] = {0};
+	int ncpu = ml_get_max_cpu_number() + 1;
+	if (ncpu > 8) {
+		ncpu = 8;
+	}
+	for (int c = 0; c < ncpu; c++) {
+		struct processor *p = cpu_to_processor(c);
+		if (p == NULL) {
+			continue;
+		}
+		thread_bind(p);
+		thread_block(THREAD_CONTINUE_NULL);     /* move to that CPU */
+		mhz[c] = cf_measure_here();
+	}
+	thread_bind(NULL);
+	thread_block(THREAD_CONTINUE_NULL);
+	printf("SWEET CPUFREQ: %s: cpu0-7 %u %u %u %u | %u %u %u | %u MHz\n", when,
+	    mhz[0], mhz[1], mhz[2], mhz[3], mhz[4], mhz[5], mhz[6], mhz[7]);
+}
+
+static void
+cf_thread(void *arg, wait_result_t result)
+{
+	int mode = (int)(uintptr_t)arg;
+	vm_offset_t base[CF_NDOM];
+	unsigned rows[CF_NDOM];
+	uint32_t khz[CF_NDOM][CF_ROWS];
+	(void)result;
+
+	for (unsigned d = 0; d < CF_NDOM; d++) {
+		base[d] = ml_io_map(cf_dom[d].pa, 0x1000);
+		if (!base[d]) {
+			printf("SWEET CPUFREQ: %s: map failed\n", cf_dom[d].name);
+			goto out;
+		}
+		rows[d] = cf_lut(base[d], khz[d]);
+		uint32_t st = cf_rd(base[d], CF_PERF_STATE);
+		printf("SWEET CPUFREQ: %s (cpu%d-%d): %u rows %u-%u MHz, enable %#x, requested row %u (%u MHz)\n",
+		    cf_dom[d].name, cf_dom[d].first_cpu, cf_dom[d].first_cpu + cf_dom[d].ncpu - 1, rows[d],
+		    khz[d][0] / 1000, khz[d][rows[d] - 1] / 1000, cf_rd(base[d], 0), st,
+		    st < rows[d] ? khz[d][st] / 1000 : 0);
+	}
+	cf_measure_all("measured");
+	if (mode >= 2) {
+		for (unsigned d = 0; d < CF_NDOM; d++) {
+			cf_wr(base[d], CF_PERF_STATE, rows[d] - 1);
+			printf("SWEET CPUFREQ: %s: requested row %u (%u MHz), reads back %u\n", cf_dom[d].name,
+			    rows[d] - 1, khz[d][rows[d] - 1] / 1000, cf_rd(base[d], CF_PERF_STATE));
+		}
+		delay(10 * 1000);
+		cf_measure_all("after max");
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_cpufreq_init(void)
+{
+	static bool started;
+	int mode = 1;
+	thread_t thread;
+	if (started) {
+		return;
+	}
+	started = true;
+	(void)PE_parse_boot_argn("sweetcpufreq", &mode, sizeof(mode));
+	if (mode <= 0) {
+		return;
+	}
+	if (kernel_thread_start(cf_thread, (void *)(uintptr_t)mode, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
