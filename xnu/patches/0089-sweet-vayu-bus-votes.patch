+/* Highest level of each named bus clock manager (BCM), one active-only request, commit on each. */
+int
+sweet_rpmh_bcm_max(const char *const *names, unsigned count)
+{
+	uint32_t addresses[RH_MAX_CMDS], values[RH_MAX_CMDS];
+	if (count == 0 || count > RH_MAX_CMDS) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_poisoned ? EIO : rh_map();
+	for (unsigned i = 0; !error && i < count; ++i) {
+		error = rh_lookup(names[i], RH_BCM, &addresses[i]);
+		values[i] = RH_BCM_CMD(0x3fffu, 0x3fffu);
+	}
+	if (!error) {
+		error = rh_send(addresses, values, count, "BCM max");
+	}
+	if (error) {
+		printf("SWEET RPMH: BCM vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/*
+ * Read-only command DB queries for the GPU (sweet_adreno.c): a resource's address, and for a rail
+ * (ARC, type 3: "gfx.lvl", "cx.lvl", "mx.lvl") its voltage level table - the auxiliary data, little
+ * endian u16, zero padded; count as kgsl rpmh_arc_cmds (up to the first value followed by 0).
+ */
+int
+sweet_rpmh_cmd_db(const char *res, unsigned type, uint32_t *address, uint16_t *levels, unsigned max, unsigned *count)
+{
+	uint32_t off = 0, len = 0;
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_map();
+	if (!error) {
+		error = rh_lookup_aux(res, type, address, &off, &len);
+	}
+	if (!error && levels != NULL) {
+		unsigned n = len / 2u, i;
+		if (n == 0 || n > max) {
+			error = ERANGE;
+		} else {
+			for (i = 0; i < n; i++) {
+				levels[i] = rh_db16(off + 2u * i);
+			}
+			for (i = 1; i < n; i++) {
+				if (levels[i - 1] != 0 && levels[i] == 0) {
+					break;
+				}
+			}
+			*count = i;
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/* MB/s of a 16 MB memcpy, best of 4 (cached kernel memory, the CPU renderer's kind of work). */
+static unsigned
+bw_measure(vm_offset_t a, vm_offset_t b, vm_size_t size)
+{
+	uint64_t best = UINT64_MAX;
+	for (int i = 0; i < 4; i++) {
+		uint64_t t0 = mach_absolute_time();
+		memcpy((void *)b, (const void *)a, size);
+		uint64_t dt = mach_absolute_time() - t0;
+		best = dt < best ? dt : best;
+	}
+	uint64_t ns;
+	absolutetime_to_nanoseconds(best, &ns);
+	return ns ? (unsigned)((uint64_t)size * 1000u / ns) : 0;      /* bytes/ns * 1000 = MB/s */
+}
+
+static int bw_chan;
+
+static void
+bw_thread(void *arg, wait_result_t result)
+{
+	static const char *const bcms[] = { "MC0", "SH0" };
+	const vm_size_t size = 16u << 20;
+	vm_offset_t a = 0, b = 0;
+	uint64_t deadline;
+	(void)arg;
+	(void)result;
+	clock_interval_to_deadline(15, NSEC_PER_SEC, &deadline);        /* after the boot rush */
+	(void)assert_wait_deadline(&bw_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	if (kmem_alloc(kernel_map, &a, size, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, &b, size, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET BW: no memory for the copy test\n");
+		goto out;
+	}
+	/*
+	 * Both measurements on one A76 core (cpu4): unbound, the first run on the phone gave 6546 and
+	 * the second 3974 MB/s, most likely an A76 and then an A55 (iOS/runs/ios-smooth1). Bound only:
+	 * interrupts stay on (sweet_cpufreq.c's masked measurement stopped the disk).
+	 */
+	struct processor *cpu4 = cpu_to_processor(4);
+	if (cpu4 != NULL) {
+		thread_bind(cpu4);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	memset((void *)a, 0x5a, size);
+	printf("SWEET BW: memcpy 16 MB on cpu%d before the vote: %u, %u MB/s\n", cpu_number(), bw_measure(a, b, size),
+	    bw_measure(a, b, size));
+	if (sweet_rpmh_bcm_max(bcms, 2) == 0) {
+		clock_interval_to_deadline(100, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&bw_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		printf("SWEET BW: memcpy 16 MB on cpu%d after MC0+SH0 max: %u, %u MB/s\n", cpu_number(), bw_measure(a, b, size),
+		    bw_measure(a, b, size));
+	}
+	if (cpu4 != NULL) {
+		thread_bind(NULL);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	kmem_free(kernel_map, a, size);
+	kmem_free(kernel_map, b, size);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_bw_init(void)
+{
+	static bool started;
+	int on = 0;
+	thread_t thread;
+	if (started || !PE_parse_boot_argn("sweetbw", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	started = true;
+	if (kernel_thread_start(bw_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
