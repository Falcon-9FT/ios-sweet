--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5568,6 +5568,46 @@
  * Note:	The argument and environment vectors are user space pointers
  *		to arrays of user space pointers.
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET (vayu): boot-arg sweetoslog=NAME[,NAME...] - programs with these file names get
+ * OS_ACTIVITY_DT_MODE=YES and CFLOG_FORCE_STDERR=YES in their environment, so os_log and CFLog
+ * (the "Terminating app due to uncaught exception" reason) also go to standard error; launchd
+ * points that at /dev/null, and sweetnull=NAME (bsd/dev/mem.c) prints it on the console.
+ * After HakiOS applog (oosexgang/hackios-xnu-kernel, exec_applog_oslog, APSL 2.0).
+ */
+static bool
+sweet_oslog_wanted(struct image_params *imgp)
+{
+	static char names[128];
+	static int parsed;
+
+	if (!parsed) {
+		if (!PE_parse_boot_argn("sweetoslog", names, sizeof(names))) {
+			names[0] = 0;
+		}
+		parsed = 1;
+	}
+	if (names[0] == 0 || imgp->ip_ndp == NULL) {
+		return false;
+	}
+	const char *name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	size_t n = (size_t)imgp->ip_ndp->ni_cnd.cn_namelen;
+	for (const char *t = names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+#endif
