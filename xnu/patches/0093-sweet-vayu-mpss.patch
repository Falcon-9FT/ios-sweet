@@ -0,0 +1,214 @@
+/*
+ * SWEET vayu (SM8150): modem (MPSS) bring-up, milestone 0 - read-only probe of what the modem's start
+ * would need. After HakiOS hakios.mpss.c (oosexgang/hackios-xnu-kernel, APSL 2.0), with the numbers of
+ * this SoC (vayu dt: qcom,mss pil-tz-generic pas-id 4, ipa pas-id 15; smem 0x86000000 + 0x200000;
+ * smp2p items 435/428, host 0 / modem 1). Nothing is started, written or voted:
+ *   1 TrustZone: is "PAS is-supported" available; is-supported for the modem (4), the IPA's GSI
+ *     firmware (15) and, for comparison, the GPU's zap shader (13, answered 0 on this phone)
+ *   2 SMEM: header (versions, initialized), the partition table at its last 4K ($TOC), the
+ *     partition shared by the apps (host 0) and the modem (host 1) and the items in it
+ * Boot-arg sweetmpss=1 (default 0: off); sweetmpssdelay=S start delay (30 s, so iOS is up first).
+ * Linux: drivers/soc/qcom/smem.c (layout), qcom_scm (calls), vendor subsys-pil-tz.c (pas_supported).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <string.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_mpss_init(void);
+
+/* qcom_scm-smc.c, as sweet_adreno.c */
+#define SCM_FAST                (1ull << 31)
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(s, c)          ((uint64_t)(s) << 8 | (c))
+#define SCM_IS_CALL_AVAILABLE   SCM_CALL(6, 1)
+#define SCM_PAS_IS_SUPPORTED    SCM_CALL(2, 7)
+#define SCM_ONE_VALUE           1
+#define SCM_INTERRUPTED         1
+#define PAS_MPSS                4
+#define PAS_IPA                 15
+#define PAS_GPU                 13
+
+#define SMEM_PA                 0x86000000u     /* dt reserved-memory smem */
+#define SMEM_SIZE               0x00200000u
+#define SMEM_VERSION(i)         (64u + 4u * (i))        /* after proc_comm[4] */
+#define SMEM_INITIALIZED        (64u + 128u)
+#define SMEM_SBL_VERSION        7
+#define SMEM_TOC                (SMEM_SIZE - 0x1000u)
+#define SMEM_TOC_MAGIC          0x434f5424u     /* "$TOC" */
+#define SMEM_PRT_MAGIC          0x54525024u     /* "$PRT" */
+#define SMEM_TOC_ENTRY          48u
+#define SMEM_PRIVATE_CANARY     0xa5a5u
+#define SMEM_APPS               0u
+#define SMEM_MODEM              1u
+
+static int sweet_mpss_chan;
+
+static void
+sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&sweet_mpss_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static int32_t
+scm(uint64_t function, uint64_t arguments, uint64_t first, uint64_t *answer)
+{
+	uint64_t session = 0;
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = first;
+		register uint64_t x3 __asm__("x3") = 0;
+		register uint64_t x4 __asm__("x4") = 0;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	return -1;
+}
+
+static void
+probe_trustzone(void)
+{
+	static const struct { unsigned pas; const char *what; } images[] = {
+		{ PAS_MPSS, "modem" }, { PAS_IPA, "IPA GSI firmware" }, { PAS_GPU, "GPU zap shader" },
+	};
+	uint64_t how = SCM_FAST | SCM_64 | SCM_SIP, ans = ~0ull;
+	int32_t r = scm(how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, how | SCM_PAS_IS_SUPPORTED, &ans);
+	printf("SWEET MPSS: TrustZone is-call-available(pas-is-supported): ret %d answer %#llx\n", r, ans);
+	for (unsigned i = 0; i < sizeof(images) / sizeof(images[0]); i++) {
+		ans = ~0ull;
+		r = scm(how | SCM_PAS_IS_SUPPORTED, SCM_ONE_VALUE, images[i].pas, &ans);
+		printf("SWEET MPSS: TrustZone pas-is-supported(%u, %s): ret %d answer %#llx%s\n", images[i].pas, images[i].what,
+		    r, ans, r == 0 && ans == 1 ? " - SUPPORTED" : "");
+	}
+}
+
+/* The apps/modem partition: its header and the items in its uncached list (smem.c qcom_smem_get_private). */
+static void
+probe_partition(vm_offset_t smem, uint32_t offset, uint32_t size)
+{
+	if (offset == 0 || size < 32 || offset > SMEM_SIZE || size > SMEM_SIZE - offset) {
+		printf("SWEET MPSS: partition at %#x size %#x is outside SMEM\n", offset, size);
+		return;
+	}
+	vm_offset_t p = smem + offset;
+	uint32_t magic = rd(p, 0), hosts = rd(p, 4), psize = rd(p, 8), free_uncached = rd(p, 12), free_cached = rd(p, 16);
+	printf("SWEET MPSS: partition at %#x: magic %#x hosts %u/%u size %#x free uncached %#x cached %#x\n", offset, magic,
+	    hosts & 0xffffu, hosts >> 16, psize, free_uncached, free_cached);
+	if (magic != SMEM_PRT_MAGIC || free_uncached > size) {
+		return;
+	}
+	unsigned items = 0;
+	for (uint32_t e = 32u; e + 16u <= free_uncached && items < 64; items++) {
+		uint32_t w0 = rd(p, e), w1 = rd(p, e + 4), w2 = rd(p, e + 8);
+		uint32_t canary = w0 & 0xffffu, item = w0 >> 16, isize = w1, pad_hdr = w2 >> 16;
+		if (canary != SMEM_PRIVATE_CANARY) {
+			printf("SWEET MPSS: bad canary %#x at %#x\n", canary, e);
+			break;
+		}
+		printf("SWEET MPSS:   item %u (%#x) size %#x at %#x%s\n", item, item, isize, e,
+		    item == 428 ? " - modem's SMP2P out" : item == 435 ? " - apps' SMP2P out" : item == 421 ? " - crash reason" :
+		    (item >= 478 && item <= 480) ? " - GLINK" : "");
+		e += 16u + pad_hdr + isize;
+	}
+	printf("SWEET MPSS: %u items in the apps/modem partition\n", items);
+}
+
+static void
+probe_smem(void)
+{
+	vm_offset_t smem = ml_io_map(SMEM_PA, SMEM_SIZE);
+	if (smem == 0) {
+		printf("SWEET MPSS: SMEM mapping failed\n");
+		return;
+	}
+	uint32_t sbl = rd(smem, SMEM_VERSION(SMEM_SBL_VERSION));
+	printf("SWEET MPSS: SMEM at %#x: initialized %#x, SBL version %#x (global heap %u, partitions %u)\n", SMEM_PA,
+	    rd(smem, SMEM_INITIALIZED), sbl, (sbl >> 16) == 0xb, (sbl >> 16) == 0xc);
+	vm_offset_t toc = smem + SMEM_TOC;
+	uint32_t magic = rd(toc, 0), version = rd(toc, 4), n = rd(toc, 8);
+	printf("SWEET MPSS: partition table: magic %#x version %u entries %u\n", magic, version, n);
+	if (magic != SMEM_TOC_MAGIC || n > 64) {
+		return;
+	}
+	bool found = false;
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t e = 32u + SMEM_TOC_ENTRY * i;
+		uint32_t offset = rd(toc, e), size = rd(toc, e + 4), flags = rd(toc, e + 8), hosts = rd(toc, e + 12);
+		uint32_t h0 = hosts & 0xffffu, h1 = hosts >> 16;
+		printf("SWEET MPSS: partition %u: hosts %u/%u offset %#x size %#x flags %#x cacheline %u\n", i, h0, h1, offset,
+		    size, flags, rd(toc, e + 16));
+		if ((h0 == SMEM_APPS && h1 == SMEM_MODEM) || (h0 == SMEM_MODEM && h1 == SMEM_APPS)) {
+			found = true;
+			probe_partition(smem, offset, size);
+		}
+	}
+	printf("SWEET MPSS: apps/modem partition %s\n", found ? "PRESENT" : "MISSING");
+}
+
+static void
+mpss_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 30;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweetmpssdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET MPSS: modem probe in %u s (read-only)\n", delay_s);
+	sleep_ms(delay_s * 1000u);
+	printf("SWEET MPSS: step 1: TrustZone PAS support\n");
+	sleep_ms(3000);
+	probe_trustzone();
+	printf("SWEET MPSS: step 2: SMEM\n");
+	sleep_ms(3000);
+	probe_smem();
+	printf("SWEET MPSS: probe done\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_mpss_init(void)
+{
+	static bool started;
+	unsigned on = 0;
+	thread_t thread;
+	if (started) {
+		return;
+	}
+	started = true;
+	(void)PE_parse_boot_argn("sweetmpss", &on, sizeof(on));
+	if (on == 0) {
+		return;
+	}
+	if (kernel_thread_start(mpss_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
