+/*
+ * Read-only access for kernel clients to a GPT partition on any LUN (sweet_mpss.c: the modem's file systems
+ * modemst1, modemst2, fsg and fsc, which Android's rmtfs serves it; on vayu they are not on LUN 0). The LUNs
+ * are searched in order, lun_hint first; offset (a multiple of 4 KiB) and len pick what of the partition is
+ * read into out. With out NULL only *size, the partition's size in bytes, is filled in. The device lock is
+ * taken one bounce buffer at a time and the root's LUN is put back before it is let go, so the root's I/O
+ * never goes to another LUN. Only READ(10) is issued: nothing is ever written.
+ */
+int sweet_ufs_read_partition(const char *name, unsigned lun_hint, uint64_t offset, void *out, uint64_t len,
+    uint64_t *size);
+
+#define UFS_MAX_LUN     8u
+
+/* With the lock held and su.lun set: the partition's first device block and count, or an errno. */
+static int
+ufs_gpt_lookup(const char *want, uint64_t *first, uint64_t *count)
+{
+	static const uint8_t tur[6] = { 0x00 };
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = EIO;
+	/* The first command to a LUN may report a unit attention. */
+	for (int i = 0; i < 3 && error; i++) {
+		error = ufs_scsi(tur, sizeof(tur), 0, false);
+	}
+	if (!error) {
+		error = ufs_read_blocks(1, 1);
+	}
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent > BOUNCE_SIZE / esz) {
+		return ENXIO;
+	}
+	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t lo, hi;
+		memcpy(&lo, e + 32, 8);
+		memcpy(&hi, e + 40, 8);
+		if (hi < lo) {
+			return ENXIO;
+		}
+		*first = lo;
+		*count = hi - lo + 1;
+		return 0;
+	}
+	return ENOENT;
+}
+
+int
+sweet_ufs_read_partition(const char *name, unsigned lun_hint, uint64_t offset, void *out, uint64_t len,
+    uint64_t *size)
+{
+	uint64_t first = 0, count = 0;
+	unsigned lun = 0, hint = lun_hint % UFS_MAX_LUN;
+	uint8_t root_lun;
+	int error = ENOENT;
+
+	if (!su.ready || name == NULL || (offset % UFS_BLOCK) != 0) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	root_lun = su.lun;
+	/* hint, then 0 .. hint - 1, then hint + 1 .. 7 */
+	for (unsigned i = 0; i < UFS_MAX_LUN && error; i++) {
+		lun = i == 0 ? hint : (i <= hint ? i - 1 : i);
+		su.lun = (uint8_t)lun;
+		error = ufs_gpt_lookup(name, &first, &count);
+	}
+	su.lun = root_lun;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		printf("SWEET UFS: no GPT partition named \"%s\" on LUNs 0-%u\n", name, UFS_MAX_LUN - 1);
+		return error;
+	}
+	uint64_t bytes = count * UFS_BLOCK;
+	if (size != NULL) {
+		*size = bytes;
+	}
+	if (out == NULL || len == 0) {
+		return 0;
+	}
+	if (offset > bytes || len > bytes - offset) {
+		return EINVAL;
+	}
+	/* bytes is whole device blocks, so rounding the last piece up stays inside the partition */
+	for (uint64_t done = 0; done < len && !error;) {
+		uint32_t want = (uint32_t)MIN(len - done, (uint64_t)BOUNCE_SIZE);
+		uint32_t blocks = (want + UFS_BLOCK - 1) / UFS_BLOCK;
+		lck_mtx_lock(&sweet_ufs_lock);
+		su.lun = (uint8_t)lun;
+		error = ufs_read_blocks(first + (offset + done) / UFS_BLOCK, blocks);
+		if (!error) {
+			memcpy((uint8_t *)out + done, (const void *)(su.dma + DMA_BOUNCE), want);
+		}
+		su.lun = root_lun;
+		lck_mtx_unlock(&sweet_ufs_lock);
+		done += want;
+	}
+	if (!error) {
+		printf("SWEET UFS: \"%s\" on LUN %u: %llu of %llu KiB read (read-only)\n", name, lun, len >> 10, bytes >> 10);
+	}
+	return error;
+}
