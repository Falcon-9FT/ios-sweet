+/*
+ * SWEET vayu (SM8150): modem (MPSS) bring-up, milestone 0 - read-only probe of what the modem's start
+ * would need. After HakiOS hakios.mpss.c (oosexgang/hackios-xnu-kernel, APSL 2.0), with the numbers of
+ * this SoC (vayu dt: qcom,mss pil-tz-generic pas-id 4, ipa pas-id 15; smem 0x86000000 + 0x200000;
+ * smp2p items 435/428, host 0 / modem 1). Nothing is started, written or voted:
+ *   1 TrustZone: is "PAS is-supported" available; is-supported for the modem (4), the IPA's GSI
+ *     firmware (15) and, for comparison, the GPU's zap shader (13, answered 0 on this phone)
+ *   2 SMEM: header (versions, initialized), the partition table at its last 4K ($TOC), the
+ *     partition shared by the apps (host 0) and the modem (host 1) and the items in it
+ *   3 TrustZone PAS init image with the modem's and the zap shader's .mdt (signature check only),
+ *     each undone at once by PAS shutdown
+ * Boot-arg sweetmpss=1 (default 0: off); sweetmpssdelay=S start delay (30 s, so iOS is up first).
+ * Linux: drivers/soc/qcom/smem.c (layout), qcom_scm (calls), vendor subsys-pil-tz.c (pas_supported).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+#include <string.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_mpss_init(void);
+
+/* qcom_scm-smc.c, as sweet_adreno.c */
+#define SCM_FAST                (1ull << 31)
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(s, c)          ((uint64_t)(s) << 8 | (c))
+#define SCM_IS_CALL_AVAILABLE   SCM_CALL(6, 1)
+#define SCM_PAS_IS_SUPPORTED    SCM_CALL(2, 7)
+#define SCM_ONE_VALUE           1
+#define SCM_INTERRUPTED         1
+#define PAS_MPSS                4
+#define PAS_IPA                 15
+#define PAS_GPU                 13
+
+#define SMEM_PA                 0x86000000u     /* dt reserved-memory smem */
+#define SMEM_SIZE               0x00200000u
+#define SMEM_VERSION(i)         (64u + 4u * (i))        /* after proc_comm[4] */
+#define SMEM_INITIALIZED        (64u + 128u)
+#define SMEM_SBL_VERSION        7
+#define SMEM_TOC                (SMEM_SIZE - 0x1000u)
+#define SMEM_TOC_MAGIC          0x434f5424u     /* "$TOC" */
+#define SMEM_PRT_MAGIC          0x54525024u     /* "$PRT" */
+#define SMEM_TOC_ENTRY          48u
+#define SMEM_PRIVATE_CANARY     0xa5a5u
+#define SMEM_APPS               0u
+#define SMEM_MODEM              1u
+
+static int sweet_mpss_chan;
+
+static void
+sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&sweet_mpss_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static int32_t
+scm2(uint64_t function, uint64_t arguments, uint64_t first, uint64_t second, uint64_t *answer)
+{
+	uint64_t session = 0;
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = first;
+		register uint64_t x3 __asm__("x3") = second;
+		register uint64_t x4 __asm__("x4") = 0;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	return -1;
+}
+
+static int32_t
+scm(uint64_t function, uint64_t arguments, uint64_t first, uint64_t *answer)
+{
+	return scm2(function, arguments, first, 0, answer);
+}
+
+static void
+probe_trustzone(void)
+{
+	static const struct { unsigned pas; const char *what; } images[] = {
+		{ PAS_MPSS, "modem" }, { PAS_IPA, "IPA GSI firmware" }, { PAS_GPU, "GPU zap shader" },
+	};
+	/*
+	 * ios-mpss1: as fast calls (bit 31) every image answered 0, the modem too - which Android starts through
+	 * TrustZone on this very phone. Linux (vendor scm_call2, upstream qcom_scm_call) and HakiOS make these
+	 * as standard (yielding) calls; fast is only for the atomic ones. Both kinds are asked here.
+	 */
+	for (int kind = 0; kind < 2; kind++) {
+		uint64_t how = (kind ? SCM_FAST : 0) | SCM_64 | SCM_SIP, ans = ~0ull;
+		const char *k = kind ? "fast" : "standard";
+		int32_t r = scm(how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE, how | SCM_PAS_IS_SUPPORTED, &ans);
+		printf("SWEET MPSS: TrustZone (%s calls) is-call-available(pas-is-supported): ret %d answer %#llx\n", k, r, ans);
+		for (unsigned i = 0; i < sizeof(images) / sizeof(images[0]); i++) {
+			ans = ~0ull;
+			r = scm(how | SCM_PAS_IS_SUPPORTED, SCM_ONE_VALUE, images[i].pas, &ans);
+			printf("SWEET MPSS: TrustZone (%s calls) pas-is-supported(%u, %s): ret %d answer %#llx%s\n", k,
+			    images[i].pas, images[i].what, r, ans, r == 0 && ans == 1 ? " - SUPPORTED" : "");
+		}
+	}
+}
+
+/* The apps/modem partition: its header and the items in its uncached list (smem.c qcom_smem_get_private). */
+static void
+probe_partition(vm_offset_t smem, uint32_t offset, uint32_t size)
+{
+	if (offset == 0 || size < 32 || offset > SMEM_SIZE || size > SMEM_SIZE - offset) {
+		printf("SWEET MPSS: partition at %#x size %#x is outside SMEM\n", offset, size);
+		return;
+	}
+	vm_offset_t p = smem + offset;
+	uint32_t magic = rd(p, 0), hosts = rd(p, 4), psize = rd(p, 8), free_uncached = rd(p, 12), free_cached = rd(p, 16);
+	printf("SWEET MPSS: partition at %#x: magic %#x hosts %u/%u size %#x free uncached %#x cached %#x\n", offset, magic,
+	    hosts & 0xffffu, hosts >> 16, psize, free_uncached, free_cached);
+	if (magic != SMEM_PRT_MAGIC || free_uncached > size) {
+		return;
+	}
+	unsigned items = 0;
+	for (uint32_t e = 32u; e + 16u <= free_uncached && items < 64; items++) {
+		uint32_t w0 = rd(p, e), w1 = rd(p, e + 4), w2 = rd(p, e + 8);
+		uint32_t canary = w0 & 0xffffu, item = w0 >> 16, isize = w1, pad_hdr = w2 >> 16;
+		if (canary != SMEM_PRIVATE_CANARY) {
+			printf("SWEET MPSS: bad canary %#x at %#x\n", canary, e);
+			break;
+		}
+		printf("SWEET MPSS:   item %u (%#x) size %#x at %#x%s\n", item, item, isize, e,
+		    item == 428 ? " - modem's SMP2P out" : item == 435 ? " - apps' SMP2P out" : item == 421 ? " - crash reason" :
+		    (item >= 478 && item <= 480) ? " - GLINK" : "");
+		e += 16u + pad_hdr + isize;
+	}
+	printf("SWEET MPSS: %u items in the apps/modem partition\n", items);
+}
+
+static void
+probe_smem(void)
+{
+	vm_offset_t smem = ml_io_map(SMEM_PA, SMEM_SIZE);
+	if (smem == 0) {
+		printf("SWEET MPSS: SMEM mapping failed\n");
+		return;
+	}
+	uint32_t sbl = rd(smem, SMEM_VERSION(SMEM_SBL_VERSION));
+	printf("SWEET MPSS: SMEM at %#x: initialized %#x, SBL version %#x (global heap %u, partitions %u)\n", SMEM_PA,
+	    rd(smem, SMEM_INITIALIZED), sbl, (sbl >> 16) == 0xb, (sbl >> 16) == 0xc);
+	vm_offset_t toc = smem + SMEM_TOC;
+	uint32_t magic = rd(toc, 0), version = rd(toc, 4), n = rd(toc, 8);
+	printf("SWEET MPSS: partition table: magic %#x version %u entries %u\n", magic, version, n);
+	if (magic != SMEM_TOC_MAGIC || n > 64) {
+		return;
+	}
+	bool found = false;
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t e = 32u + SMEM_TOC_ENTRY * i;
+		uint32_t offset = rd(toc, e), size = rd(toc, e + 4), flags = rd(toc, e + 8), hosts = rd(toc, e + 12);
+		uint32_t h0 = hosts & 0xffffu, h1 = hosts >> 16;
+		printf("SWEET MPSS: partition %u: hosts %u/%u offset %#x size %#x flags %#x cacheline %u\n", i, h0, h1, offset,
+		    size, flags, rd(toc, e + 16));
+		if ((h0 == SMEM_APPS && h1 == SMEM_MODEM) || (h0 == SMEM_MODEM && h1 == SMEM_APPS)) {
+			found = true;
+			probe_partition(smem, offset, size);
+		}
+	}
+	printf("SWEET MPSS: apps/modem partition %s\n", found ? "PRESENT" : "MISSING");
+}
+
+/*
+ * Step 3: the real question. The vendor kernel never asks pas-is-supported (subsys-pil-tz.c has no such
+ * call; this TrustZone answers 0 for every image, ios-mpss1/2): it hands the image's header (.mdt: ELF
+ * headers + hash segment with the signature) to PAS_INIT_IMAGE in one physically contiguous buffer -
+ * args pas id (value) and its address (read-write buffer), SCM_ARGS(2, VAL, RW) - and TrustZone checks
+ * the signature. Done here for the modem (4) and the GPU zap shader (13), each followed at once by
+ * PAS_SHUTDOWN (pil_deinit_image_trusted), so nothing stays set up; no memory is given, nothing runs.
+ * The headers come in the payload after the CP microcode (build-payload.sh EXTRAFW=SWEETMDM=modem.mdt
+ * SWEETZAP=a640_zap.mdt), found by walking the blocks after the touch firmware (sweet_adreno.c).
+ */
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_SHUTDOWN        SCM_CALL(2, 6)
+#define SCM_VAL_RW              (2u | 2u << 6)  /* SCM_ARGS(2, SCM_VAL, SCM_RW) */
+#define BLOB_MAP                0x40000u
+extern uint64_t kvtophys(vm_offset_t va);
+
+/* A tagged block of the payload copied into one kernel page (so physically contiguous); 0 if absent. */
+static vm_offset_t
+payload_blob(const char *tag, uint32_t *size)
+{
+	uint64_t nvt_pa = 0;
+	uint32_t nvt_size = 0;
+	(void)PE_parse_boot_argn("sweetnvtfw", &nvt_pa, sizeof(nvt_pa));
+	(void)PE_parse_boot_argn("sweetnvtfwsz", &nvt_size, sizeof(nvt_size));
+	if (nvt_pa == 0) {
+		return 0;
+	}
+	uint64_t pa = nvt_pa + ((nvt_size + 15u) & ~15u), base = pa & ~0x3fffull;
+	vm_offset_t io = ml_io_map((vm_offset_t)base, BLOB_MAP);
+	uint32_t want[2];
+	memcpy(want, tag, 8);
+	for (uint32_t at = (uint32_t)(pa - base); io != 0 && at + 16u <= BLOB_MAP;) {
+		volatile const uint32_t *w = (volatile const uint32_t *)(io + at);
+		uint32_t len = w[2];
+		if ((w[0] & 0xffffffu) != 0x455753u /* "SWE" */ || len > BLOB_MAP) {
+			break;
+		}
+		if (w[0] == want[0] && w[1] == want[1]) {
+			vm_offset_t copy = 0;
+			if (len == 0 || len > PAGE_SIZE || (len & 3) || at + 16u + len > BLOB_MAP ||
+			    kmem_alloc(kernel_map, &copy, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+			    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+				printf("SWEET MPSS: %.8s: %u bytes, not usable\n", tag, len);
+				return 0;
+			}
+			for (uint32_t i = 0; i < len / 4u; i++) {
+				((uint32_t *)copy)[i] = w[4 + i];
+			}
+			*size = len;
+			return copy;
+		}
+		at += 16u + ((len + 15u) & ~15u);
+	}
+	printf("SWEET MPSS: no %.8s block in the payload\n", tag);
+	return 0;
+}
+
+static void
+probe_signature(unsigned pas, const char *what, const char *tag)
+{
+	uint32_t size = 0;
+	vm_offset_t mdt = payload_blob(tag, &size);
+	if (mdt == 0) {
+		return;
+	}
+	for (vm_offset_t line = mdt; line < mdt + size; line += 64) {
+		__asm__ volatile("dc civac, %0" : : "r"(line) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	uint64_t how = SCM_64 | SCM_SIP, ans = ~0ull, phys = kvtophys(mdt);
+	printf("SWEET MPSS: %s header: %u bytes at pa %#llx, ELF %#x\n", what, size, phys, *(uint32_t *)mdt);
+	int32_t r = scm2(how | SCM_PAS_INIT_IMAGE, SCM_VAL_RW, pas, phys, &ans);
+	printf("SWEET MPSS: TrustZone pas-init-image(%u, %s): ret %d answer %#llx%s\n", pas, what, r, ans,
+	    r == 0 && ans == 0 ? " - SIGNATURE ACCEPTED" : " - refused");
+	ans = ~0ull;
+	r = scm(how | SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, pas, &ans);
+	printf("SWEET MPSS: TrustZone pas-shutdown(%u): ret %d answer %#llx\n", pas, r, ans);
+}
+
+static void
+mpss_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 30;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweetmpssdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET MPSS: modem probe in %u s (read-only)\n", delay_s);
+	sleep_ms(delay_s * 1000u);
+	printf("SWEET MPSS: step 1: TrustZone PAS support\n");
+	sleep_ms(3000);
+	probe_trustzone();
+	printf("SWEET MPSS: step 2: SMEM\n");
+	sleep_ms(3000);
+	probe_smem();
+	printf("SWEET MPSS: step 3: TrustZone PAS init image (signature check) + shutdown: modem, GPU zap\n");
+	sleep_ms(3000);
+	probe_signature(PAS_MPSS, "modem", "SWEETMDM");
+	sleep_ms(1000);
+	probe_signature(PAS_GPU, "GPU zap shader", "SWEETZAP");
+	printf("SWEET MPSS: probe done\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_mpss_init(void)
+{
+	static bool started;
+	unsigned on = 0;
+	thread_t thread;
+	if (started) {
+		return;
+	}
+	started = true;
+	(void)PE_parse_boot_argn("sweetmpss", &on, sizeof(on));
+	if (on == 0) {
+		return;
+	}
+	if (kernel_thread_start(mpss_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
