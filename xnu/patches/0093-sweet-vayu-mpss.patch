+/*
+ * The Wi-Fi radio's (WCN3998) four supplies, as vayu's DT gives them to qcom,icnss@18800000 (vdd-cx-mx, vdd-1.8-xo,
+ * vdd-1.3-rfa, vdd-3.3-ch0): PMIC5 LDOs, each switched with one active-only request of three commands - voltage,
+ * HPM (raw 7), enable last - or of one (enable 0). Only these resources and these voltages are accepted.
+ */
+int
+sweet_rpmh_wifi_ldo(const char *res, unsigned mv, bool on)
+{
+	static const struct {
+		const char *res;
+		unsigned min_mv, max_mv;
+	} allowed[] = {
+		{ "ldoa1", 752, 752 },          /* vdd-cx-mx, pm8150 L1 */
+		{ "ldoa7", 1800, 1800 },        /* vdd-1.8-xo, pm8150 L7 */
+		{ "ldoc2", 1304, 1304 },        /* vdd-1.3-rfa, pm8150l L2 */
+		{ "ldoc11", 3104, 3312 },       /* vdd-3.3-ch0, pm8150l L11 (the touch panel's too) */
+		{ "rfclka2", 0, 0 },            /* the radio's XO (mainline sm8150.dtsi: cxo_ref_clk_pin = RPMH_RF_CLK2):
+		                                 * a VRM resource of clk-rpmh, enable only */
+	};
+	unsigned i;
+	uint32_t address = 0;
+	int error;
+
+	for (i = 0; i < sizeof(allowed) / sizeof(allowed[0]); i++) {
+		if (res != NULL && strcmp(res, allowed[i].res) == 0) {
+			break;
+		}
+	}
+	if (i == sizeof(allowed) / sizeof(allowed[0]) || (on && (mv < allowed[i].min_mv || mv > allowed[i].max_mv))) {
+		printf("SWEET RPMH: %s at %u mV is not a Wi-Fi supply this switches\n", res ? res : "(none)", mv);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	error = rh_poisoned ? EIO : rh_map();
+	if (!error) {
+		error = rh_lookup(res, RH_VRM, &address);
+	}
+	if (!error && allowed[i].max_mv == 0) {
+		const uint32_t addresses[1] = {address + 4};     /* CLK_RPMH_VRM_EN_OFFSET */
+		const uint32_t values[1] = {on ? 1u : 0u};
+		error = rh_send(addresses, values, 1, res);
+	} else if (!error && on) {
+		const uint32_t addresses[3] = {address, address + 8, address + 4};
+		const uint32_t values[3] = {mv, 7, 1};
+		error = rh_send(addresses, values, 3, res);
+	} else if (!error) {
+		const uint32_t addresses[1] = {address + 4};
+		const uint32_t values[1] = {0};
+		error = rh_send(addresses, values, 1, res);
+	}
+	if (error) {
+		printf("SWEET RPMH: %s %s failed errno=%d\n", res, on ? "on" : "off", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
