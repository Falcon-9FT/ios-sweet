+
+static int32_t
+scm(uint64_t function, uint64_t arguments, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t a4, uint64_t *answer)
+{
+	uint64_t session = 0;
+
+	function |= SCM_64 | SCM_SIP;
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = a1;
+		register uint64_t x3 __asm__("x3") = a2;
+		register uint64_t x4 __asm__("x4") = a3;
+		register uint64_t x5 __asm__("x5") = a4;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	return -1;
+}
+
+/* ---- the doorbells: vayu's APCS register (no IPCC) ------------------------------------------------- */
+
+/*
+ * One register, 0x17c0000c; a bit written there raises the modem's interrupt of that number (dt:
+ * mboxes of qcom,smp2p-modem bit 14, qcom,glink/modem bit 12, qcom,qmp-aop bit 0). There is no
+ * matching register for the modem's rings back: those are SPI interrupts, which this does not take,
+ * so everything the modem writes is found by polling the shared memory and the GLINK queues.
+ */
+static struct block apcs = { "apcs", 0x17c00000, 0x1000, 0 };
+#define APCS_IPC_SEND           0x0c
+#define RING_AOP                0u
+#define RING_GLINK              12u
+#define RING_SMP2P              14u
+
+static void
+ring(unsigned bit)
+{
+	if (need(&apcs)) {
+		w32(apcs.base + APCS_IPC_SEND, 1u << bit);
+	}
+}
+
+/* ---- the shared memory ---------------------------------------------------------------------------- */
+
+#define SMEM_PA                 0x86000000u     /* dt: reserved-memory smem */
+#define SMEM_SIZE               0x00200000u
+#define SMEM_US                 0
+#define SMEM_MPSS               1               /* dt: qcom,remote-pid of qcom,smp2p-modem and qcom,glink/modem */
+#define SMEM_CANARY             0xa5a5
+
+#define ITEM_SMP2P_OURS         428
+#define ITEM_SMP2P_THEIRS       435
+#define ITEM_CRASH_REASON       421
+#define ITEM_GLINK_DESCRIPTOR   478
+#define ITEM_GLINK_OUR_QUEUE    479
+#define ITEM_GLINK_THEIR_QUEUE  480
+#define GLINK_OUR_QUEUE_SIZE    0x4000u         /* 16 KB (dt: qcom,glink/modem) */
+
+struct smem_table {
+	uint8_t magic[4];
+	uint32_t version, count, reserved[5];
+};
+struct smem_table_entry {
+	uint32_t offset, size, flags;
+	uint16_t host0, host1;
+	uint32_t cacheline, reserved[7];
+};
+struct smem_partition {
+	uint8_t magic[4];
+	uint16_t host0, host1;
+	uint32_t size, free_uncached, free_cached, reserved[3];
+};
+#define SMEM_PARTITION_FREE_UNCACHED    12      /* offsetof(struct smem_partition, free_uncached) */
+struct smem_entry {
+	uint16_t canary, item;
+	uint32_t size;
+	uint16_t padding_data, padding_header;
+	uint32_t reserved;
+};
+struct smem_item {
+	uint32_t item, offset, size;
+};
+
+static const volatile uint8_t *smem;
+
+static bool
+smem_peek(uint64_t offset, void *to, uint32_t size)
+{
+	if (smem == NULL) {
+		smem = (const volatile uint8_t *)ml_io_map(SMEM_PA, SMEM_SIZE);
+	}
+	if (smem == NULL || offset + size > SMEM_SIZE) {
+		return false;
+	}
+	for (uint32_t i = 0; i < size; i++) {
+		((uint8_t *)to)[i] = smem[offset + i];
+	}
+	return true;
+}
+
+static void
+smem_poke(uint32_t offset, uint32_t value)
+{
+	w32((vm_offset_t)smem + offset, value);
+}
+
+static uint32_t
+smem_word(uint32_t offset)
+{
+	return r32((vm_offset_t)smem + offset);
+}
+
+static uint32_t
+smem_partition(uint16_t one, uint16_t other, uint32_t *cacheline, uint32_t *size)
+{
+	struct smem_table table;
+	struct smem_table_entry entry;
+	struct smem_partition header;
+
+	if (!smem_peek(SMEM_SIZE - 0x1000, &table, sizeof(table)) || memcmp(table.magic, "$TOC", 4) != 0 || table.version != 1 ||
+	    table.count > 64) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < table.count; i++) {
+		if (!smem_peek(SMEM_SIZE - 0x1000 + sizeof(table) + i * sizeof(entry), &entry, sizeof(entry)) || entry.offset == 0 ||
+		    entry.size == 0) {
+			continue;
+		}
+		if (!((entry.host0 == one && entry.host1 == other) || (entry.host0 == other && entry.host1 == one))) {
+			continue;
+		}
+		if ((uint64_t)entry.offset + entry.size > SMEM_SIZE - 0x1000 || !smem_peek(entry.offset, &header, sizeof(header)) ||
+		    memcmp(header.magic, "$PRT", 4) != 0 || header.size != entry.size) {
+			return 0;
+		}
+		*cacheline = entry.cacheline;
+		*size = entry.size;
+		return entry.offset;
+	}
+	return 0;
+}
+
+static unsigned
+smem_items(uint32_t partition, uint32_t cacheline, struct smem_item *found, unsigned max)
+{
+	struct smem_partition header;
+	struct smem_entry entry;
+	uint32_t at, step_back;
+	unsigned count = 0;
+
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header)) || header.free_uncached > header.size ||
+	    header.free_cached > header.size) {
+		return 0;
+	}
+	for (at = sizeof(header); at + sizeof(entry) <= header.free_uncached;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.size > header.size) {
+			break;
+		}
+		if (count < max) {
+			found[count].item = entry.item;
+			found[count].offset = partition + at + sizeof(entry) + entry.padding_header;
+			found[count].size = entry.size - entry.padding_data;
+		}
+		count++;
+		at += sizeof(entry) + entry.padding_header + entry.size;
+	}
+	if (cacheline == 0 || (cacheline & (cacheline - 1))) {
+		return count;
+	}
+	step_back = ((uint32_t)sizeof(entry) + cacheline - 1) & ~(cacheline - 1);
+	for (at = header.size - step_back; at > header.free_cached && at < header.size;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.size > at) {
+			break;
+		}
+		if (count < max) {
+			found[count].item = entry.item;
+			found[count].offset = partition + at - entry.size;
+			found[count].size = entry.size - entry.padding_data;
+		}
+		count++;
+		if (entry.size + step_back > at) {
+			break;
+		}
+		at -= entry.size + step_back;
+	}
+	return count;
+}
+
+static uint32_t
+smem_item(uint32_t item, uint32_t *size)
+{
+	static struct smem_item found[256];
+	static const uint16_t hosts[2][2] = { { SMEM_US, SMEM_MPSS }, { 0xfffe, 0xfffe } };
+
+	for (unsigned h = 0; h < 2; h++) {
+		uint32_t cacheline = 0, partition_size = 0;
+		uint32_t partition = smem_partition(hosts[h][0], hosts[h][1], &cacheline, &partition_size);
+		unsigned count = smem_items(partition, cacheline, found, 256);
+
+		for (unsigned i = 0; i < count && i < 256; i++) {
+			if (found[i].item == item) {
+				*size = found[i].size;
+				return found[i].offset;
+			}
+		}
+	}
+	return 0;
+}
+
+static void
+show_partition(void)
+{
+	static struct smem_item found[256];
+	struct smem_partition header;
+	uint32_t cacheline = 0, size = 0, partition = smem_partition(SMEM_US, SMEM_MPSS, &cacheline, &size);
+	unsigned count;
+	char line[320];
+
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header))) {
+		printf("SWEET MPSS: %u: there is no partition for us and the modem (0 and 1)\n", step);
+		return;
+	}
+	count = smem_items(partition, cacheline, found, 256);
+	printf("SWEET MPSS: %u: the partition for us and the modem: at %#lx, %#x bytes, %#x free; %u items\n", step,
+	    (unsigned long)(SMEM_PA + partition), size, header.free_cached - header.free_uncached, count);
+	for (unsigned i = 0; i < count && i < 256;) {
+		int at = 0;
+
+		for (unsigned n = 0; n < 12 && i < count && i < 256; n++, i++) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %u(%u)", found[i].item, found[i].size);
+		}
+		printf("SWEET MPSS: %u:   items:%s\n", step, line);
+	}
+}
+
+/* ---- SMP2P ---------------------------------------------------------------------------------------- */
+
+struct smp2p {
+	uint32_t magic;
+	uint32_t version;
+	uint16_t local, remote, total, valid;
+	uint32_t flags;
+	struct {
+		char name[16];
+		uint32_t value;
+	} entry[16];
+};
+#define SMP2P_MAGIC             0x504d5324      /* "$SMP" */
+#define SMP2P_VERSION           1
+#define SMP2P_RESTART_ACKS      1u
+#define SMP2P_RESTART_DONE      (1u << 0)
+#define SMP2P_RESTART_ACK       (1u << 1)
+#define SMP2P_AT_VERSION        4
+#define SMP2P_AT_PROCESSORS     8
+#define SMP2P_AT_COUNTS         12
+#define SMP2P_AT_FLAGS          16
+#define SMP2P_AT_NAME(i)        (20 + 20 * (i))
+#define SMP2P_AT_VALUE(i)       (36 + 20 * (i))
+
+/* The modem's entry "slave-kernel" (dt: the interrupts of qcom,smp2p-modem, as modem.md names them). */
+#define DSP_FATAL               (1u << 0)
+#define DSP_READY               (1u << 1)
+#define DSP_HANDOVER            (1u << 2)       /* proxy-unvote: it has asked for its own power */
+#define DSP_STOP_ACK            (1u << 3)
+#define DSP_SHUTDOWN_ACK        (1u << 7)
+#define OUR_ENTRY_STOP          "master-kernel"
+#define DSP_STOP                (1u << 0)
+
+static uint32_t our_item;               /* our SMP2P item (428); 0: not made */
+static bool smp2p_agreed, smp2p_restart_acks, smp2p_restart_acked;
+
+static bool
+dsp_words(struct smp2p *words)
+{
+	static uint32_t at;
+	uint32_t size = 0;
+
+	if (at == 0) {
+		at = smem_item(ITEM_SMP2P_THEIRS, &size);
+		if (at == 0 || size < sizeof(*words)) {
+			at = 0;
+			return false;
+		}
+	}
+	return smem_peek(at, words, sizeof(*words)) && words->magic == SMP2P_MAGIC;
+}
+
+static int
+smp2p_entry(const struct smp2p *words, const char *name)
+{
+	for (unsigned i = 0; i < words->valid && i < 16; i++) {
+		if (strncmp(words->entry[i].name, name, sizeof(words->entry[i].name)) == 0) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+static uint32_t
+dsp_state(const struct smp2p *words)
+{
+	int entry = smp2p_entry(words, "slave-kernel");
+
+	return entry < 0 ? 0 : words->entry[entry].value;
+}
+
+static void
+show_words(const char *prefix, const struct smp2p *words)
+{
+	char line[320];
+	int at = 0;
+
+	line[0] = 0;
+	for (unsigned i = 0; i < words->valid && i < 16 && at < (int)sizeof(line) - 40; i++) {
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %.16s=%#x;", words->entry[i].name, words->entry[i].value);
+	}
+	printf("SWEET MPSS: %u: %s: SMP2P version %u, features %#x, %u->%u, flags %#x, %u/%u entries:%s\n", step, prefix,
+	    words->version & 0xff, words->version >> 8, words->local, words->remote, words->flags, words->valid, words->total, line);
+}
+
+static void
+show_crash_reason(void)
+{
+	char text[257];
+	uint32_t size = 0, at = smem_item(ITEM_CRASH_REASON, &size);
+
+	if (at == 0 || size == 0) {
+		printf("SWEET MPSS: %u: item %u, the modem's last words: not there\n", step, ITEM_CRASH_REASON);
+		return;
+	}
+	bzero(text, sizeof(text));
+	smem_peek(at, text, size < sizeof(text) - 1 ? size : sizeof(text) - 1);
+	if (text[0] == 0) {
+		printf("SWEET MPSS: %u: item %u, the modem's last words (%u bytes): none\n", step, ITEM_CRASH_REASON, size);
+	} else {
+		printf("SWEET MPSS: %u: THE MODEM'S LAST WORDS (item %u, %u bytes): \"%s\"\n", step, ITEM_CRASH_REASON, size, text);
+	}
+}
+
+/* What Linux does when the modem rings for SMP2P: agree on the features once, and answer a restart. */
+static void
+dsp_listen(const struct smp2p *theirs)
+{
+	struct smp2p ours;
+
+	if (our_item == 0 || !smem_peek(our_item, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC) {
+		return;
+	}
+	if (!smp2p_agreed) {
+		uint32_t features = (ours.version >> 8) & (theirs->version >> 8);
+
+		if ((theirs->version & 0xff) != (ours.version & 0xff)) {
+			return;
+		}
+		if (features != ours.version >> 8) {
+			smem_poke(our_item + SMP2P_AT_VERSION, features << 8 | (ours.version & 0xff));
+		}
+		smp2p_restart_acks = features & SMP2P_RESTART_ACKS;
+		smp2p_agreed = true;
+		printf("SWEET MPSS: %u: SMP2P agreed: version %u, features %#x\n", step, ours.version & 0xff, features);
+	}
+	if (smp2p_restart_acks && ((theirs->flags & SMP2P_RESTART_DONE) != 0) != smp2p_restart_acked) {
+		smp2p_restart_acked = !smp2p_restart_acked;
+		smem_poke(our_item + SMP2P_AT_FLAGS, (ours.flags & ~SMP2P_RESTART_ACK) | (smp2p_restart_acked ? SMP2P_RESTART_ACK : 0));
+		settle();
+		ring(RING_SMP2P);
+	}
+}
+
+static uint32_t
+our_item_find(void)
+{
+	uint32_t size = 0, at = smem_item(ITEM_SMP2P_OURS, &size);
+
+	return at != 0 && size >= sizeof(struct smp2p) ? at : 0;
+}
+
+/* Linux's qcom_q6v5_request_stop(): our "stop" bit, the modem's "stop ack" waited for, our bit taken back. */
+static bool
+dsp_ask_to_stop(uint32_t bound_ms)
+{
+	struct smp2p ours, theirs;
+	uint32_t at = our_item_find(), state, value_at;
+	uint64_t asked, now;
+	int entry;
+
+	if (at == 0 || !smem_peek(at, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC || (ours.version & 0xff) != SMP2P_VERSION ||
+	    (entry = smp2p_entry(&ours, OUR_ENTRY_STOP)) < 0) {
+		printf("SWEET MPSS: %u: the modem is not asked to stop first: no SMP2P item of ours\n", step);
+		return false;
+	}
+	if (!dsp_words(&theirs) || smp2p_entry(&theirs, "slave-kernel") < 0) {
+		printf("SWEET MPSS: %u: the modem is not asked to stop first: its item has no entry to answer in\n", step);
+		return false;
+	}
+	state = dsp_state(&theirs);
+	if (state & DSP_STOP_ACK) {
+		printf("SWEET MPSS: %u: the modem already says it has stopped (%#x)\n", step, state);
+		return true;
+	}
+	if (!(state & DSP_READY) || (state & DSP_FATAL)) {
+		printf("SWEET MPSS: %u: the modem is not asked to stop first: its entry says %#x, not up\n", step, state);
+		return false;
+	}
+	value_at = at + SMP2P_AT_VALUE((uint32_t)entry);
+	smem_poke(value_at, ours.entry[entry].value | DSP_STOP);
+	settle();
+	ring(RING_SMP2P);
+	asked = now = now_us();
+	while (now - asked < bound_ms * 1000ull) {
+		if (dsp_words(&theirs) && (dsp_state(&theirs) & (DSP_STOP_ACK | DSP_FATAL))) {
+			break;
+		}
+		sleep_us(200);
+		now = now_us();
+	}
+	state = dsp_words(&theirs) ? dsp_state(&theirs) : 0;
+	printf("SWEET MPSS: %u: %s after %llu.%03llu ms; its entry says %#x\n", step, state & DSP_STOP_ACK ?
+	    "THE MODEM ACKNOWLEDGES THE STOP" : "THE MODEM DOES NOT ACKNOWLEDGE THE STOP", (now - asked) / 1000,
+	    (now - asked) % 1000, state);
+	smem_poke(value_at, ours.entry[entry].value & ~DSP_STOP);
+	settle();
+	ring(RING_SMP2P);
+	return (state & DSP_STOP_ACK) != 0;
+}
+
+/* ---- the always-on processor's mailbox (Linux's qmp; its memory is at 0x0c300000, the doorbell APCS bit 0) ---- */
+
+#define QMP_MAGIC               0x00
+#define QMP_MAGIC_VALUE         0x4d41494c      /* "MAIL" */
+#define QMP_VERSION             0x04
+#define QMP_THEIR_LINK          0x0c
+#define QMP_THEIR_LINK_ACK      0x10
+#define QMP_THEIR_CHANNEL       0x14
+#define QMP_THEIR_CHANNEL_ACK   0x18
+#define QMP_OUR_LINK            0x24
+#define QMP_OUR_LINK_ACK        0x28
+#define QMP_OUR_CHANNEL         0x2c
+#define QMP_OUR_CHANNEL_ACK     0x30
+#define QMP_OUR_BOX_SIZE        0x34
+#define QMP_OUR_BOX             0x38
+#define QMP_UP                  0x0000ffffu
+#define QMP_DOWN                0xffff0000u
+#define QMP_MESSAGE             64
+
+static struct block aoss = { "aop-mailbox", 0x0c300000, 0x400, 0 };
+static uint32_t our_box;                /* where our mailbox is in the message memory; 0: not open */
+
+static bool
+mailbox_wait(uint32_t offset, uint32_t value, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		if (r32(aoss.base + offset) == value) {
+			return true;
+		}
+		sleep_us(100);
+	}
+	return r32(aoss.base + offset) == value;
+}
+
+/* Linux's qmp_open(), as HakiOS does it; what is done already is found done. */
+static bool
+mailbox_open(void)
+{
+	uint32_t box, size;
+
+	if (!need(&aoss)) {
+		return false;
+	}
+	if (r32(aoss.base + QMP_MAGIC) != QMP_MAGIC_VALUE || r32(aoss.base + QMP_VERSION) != 1) {
+		printf("SWEET MPSS: %u: not a mailbox this knows (magic %#x)\n", step, r32(aoss.base + QMP_MAGIC));
+		return false;
+	}
+	box = r32(aoss.base + QMP_OUR_BOX);
+	size = r32(aoss.base + QMP_OUR_BOX_SIZE);
+	if (size < QMP_MESSAGE + 4 || box < 0x3c || box + size > aoss.size || (box & 3)) {
+		printf("SWEET MPSS: %u: our mailbox is not where a message fits (box %#x size %#x)\n", step, box, size);
+		return false;
+	}
+	if (r32(aoss.base + QMP_OUR_LINK) == QMP_UP && r32(aoss.base + QMP_OUR_LINK_ACK) == QMP_UP &&
+	    r32(aoss.base + QMP_OUR_CHANNEL) == QMP_UP && r32(aoss.base + QMP_THEIR_CHANNEL) == QMP_UP &&
+	    r32(aoss.base + QMP_OUR_CHANNEL_ACK) == QMP_UP) {
+		printf("SWEET MPSS: %u: the mailbox is open already\n", step);
+		our_box = box;
+		return true;
+	}
+	w32(aoss.base + QMP_THEIR_LINK_ACK, r32(aoss.base + QMP_THEIR_LINK));
+	w32(aoss.base + QMP_OUR_LINK, QMP_UP);
+	ring(RING_AOP);
+	if (!mailbox_wait(QMP_OUR_LINK_ACK, QMP_UP, 1000)) {
+		printf("SWEET MPSS: %u: THE ALWAYS-ON PROCESSOR DOES NOT ACKNOWLEDGE OUR LINK; taken down again\n", step);
+		w32(aoss.base + QMP_OUR_LINK, QMP_DOWN);
+		ring(RING_AOP);
+		return false;
+	}
+	w32(aoss.base + QMP_OUR_CHANNEL, QMP_UP);
+	ring(RING_AOP);
+	if (!mailbox_wait(QMP_THEIR_CHANNEL, QMP_UP, 1000)) {
+		printf("SWEET MPSS: %u: THE ALWAYS-ON PROCESSOR DOES NOT OPEN ITS CHANNEL; ours taken down again\n", step);
+		w32(aoss.base + QMP_OUR_CHANNEL, QMP_DOWN);
+		w32(aoss.base + QMP_OUR_LINK, QMP_DOWN);
+		ring(RING_AOP);
+		return false;
+	}
+	w32(aoss.base + QMP_THEIR_CHANNEL_ACK, QMP_UP);
+	ring(RING_AOP);
+	if (!mailbox_wait(QMP_OUR_CHANNEL_ACK, QMP_UP, 1000)) {
+		printf("SWEET MPSS: %u: THE ALWAYS-ON PROCESSOR DOES NOT ACKNOWLEDGE OUR CHANNEL; taken down again\n", step);
+		w32(aoss.base + QMP_OUR_CHANNEL, QMP_DOWN);
+		w32(aoss.base + QMP_OUR_LINK, QMP_DOWN);
+		ring(RING_AOP);
+		return false;
+	}
+	printf("SWEET MPSS: %u: THE MAILBOX TO THE ALWAYS-ON PROCESSOR IS OPEN\n", step);
+	our_box = box;
+	return true;
+}
+
+static bool
+mailbox_send(const char *text)
+{
+	uint32_t words[QMP_MESSAGE / 4] = { 0 };
+
+	if (our_box == 0 && !mailbox_open()) {
+		return false;
+	}
+	strlcpy((char *)words, text, sizeof(words));
+	if (r32(aoss.base + our_box) != 0) {
+		printf("SWEET MPSS: %u: our mailbox still holds %u bytes: not sent\n", step, r32(aoss.base + our_box));
+		return false;
+	}
+	for (unsigned i = 0; i < QMP_MESSAGE / 4; i++) {
+		w32(aoss.base + our_box + 4 + 4 * i, words[i]);
+	}
+	w32(aoss.base + our_box, QMP_MESSAGE);
+	(void)r32(aoss.base + our_box);
+	ring(RING_AOP);
+	if (!mailbox_wait(our_box, 0, 1000)) {
+		printf("SWEET MPSS: %u: THE ALWAYS-ON PROCESSOR DOES NOT TAKE \"%s\"; taken back\n", step, text);
+		w32(aoss.base + our_box, 0);
+		return false;
+	}
+	printf("SWEET MPSS: %u: the always-on processor has taken \"%s\"\n", step, text);
+	return true;
+}
+
+/* ---- the rails: cx.lvl and mss.lvl at 385 while the modem boots (sweet_rpmh.c) --------------------- */
+
+static bool rails_asked;
+
+static bool
+rails(uint32_t level)
+{
+	static const char *const names[2] = { "cx.lvl", "mss.lvl" };
+	int error = sweet_rpmh_arc_vote(names, 2, level);
+
+	printf("SWEET MPSS: %u: RPMh asked for cx.lvl and mss.lvl at level %u: %s (%d)\n", step, level,
+	    error == 0 ? "done" : "FAILED", error);
+	return error == 0;
+}
+
+/* ---- the firmware, from /fw/image on the root ------------------------------------------------------ */
+
+#define MPSS_MEMORY             0x8e000000u     /* dt: modem_region, memory-region of qcom,mss@4080000 */
+#define MPSS_MEMORY_SIZE        0x09600000u
+#define MDT_HASH(flags)         (((flags) >> 24 & 7) == 2)
+#define MAX_SEGMENTS            48
+
+struct elf_segment {
+	uint32_t type, offset, vaddr, paddr, file_size, memory_size, flags, align;
+};
+
+static struct {
+	uint8_t *header;
+	uint64_t header_size;
+	struct {
+		uint32_t at, file_size, memory_size;
+		uint8_t *file;
+	} segment[MAX_SEGMENTS];
+	unsigned segments;
+	uint32_t size;
+} image;
+
+/* A file of /fw/image on the root, read whole into memory of ours. */
+static uint8_t *
+root_file(const char *name, uint64_t *size)
+{
+	char path[256];
+	vfs_context_t context = vfs_context_kernel();
+	vnode_t vnode = NULLVP;
+	struct vnode_attr attributes;
+	uint8_t *data;
+	int left = 0, error;
+
+	if (rootvnode == NULLVP) {
+		return NULL;
+	}
+	snprintf(path, sizeof(path), "/fw/image/%s", name);
+	if (vnode_lookup(path, 0, &vnode, context) != 0) {
+		return NULL;
+	}
+	VATTR_INIT(&attributes);
+	VATTR_WANTED(&attributes, va_data_size);
+	if (vnode_getattr(vnode, &attributes, context) != 0 || attributes.va_data_size == 0 ||
+	    attributes.va_data_size > MPSS_MEMORY_SIZE) {
+		vnode_put(vnode);
+		return NULL;
+	}
+	data = kalloc_data(attributes.va_data_size, Z_WAITOK);
+	if (data == NULL) {
+		vnode_put(vnode);
+		return NULL;
+	}
+	error = vn_rdwr(UIO_READ, vnode, (caddr_t)data, (int)attributes.va_data_size, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(context), &left, vfs_context_proc(context));
+	vnode_put(vnode);
+	if (error != 0 || left != 0) {
+		printf("SWEET MPSS: %u: %s: read error %d, %d left\n", step, path, error, left);
+		kfree_data(data, attributes.va_data_size);
+		return NULL;
+	}
+	*size = attributes.va_data_size;
+	return data;
+}
+
+static void
+image_forget(void)
+{
+	if (image.header != NULL) {
+		kfree_data(image.header, image.header_size);
+	}
+	for (unsigned s = 0; s < image.segments; s++) {
+		if (image.segment[s].file != NULL) {
+			kfree_data(image.segment[s].file, image.segment[s].file_size);
+		}
+	}
+	bzero(&image, sizeof(image));
+}
+
+static unsigned rmtfs_load(void);
+static void servreg_load(void);
+
+static bool
+step_firmware(void)
+{
+	struct elf_segment segment;
+	uint8_t *header;
+	uint64_t size = 0, files = 0;
+	uint32_t count, hashes = 0, lowest = ~0u, highest = 0;
+
+	announce("find modem.mdt and its segments in /fw/image on the root, and check the image against its own header");
+	image_forget();
+	header = root_file("modem.mdt", &size);
+	if (header == NULL) {
+		printf("SWEET MPSS: %u: no /fw/image/modem.mdt on the root (run iOS/scripts/add-modem-fw.sh)\n", step);
+		return false;
+	}
+	image.header = header;
+	image.header_size = size;
+	count = size >= 52 + 2 * 32 ? header[44] | header[45] << 8 : 0;
+	if (memcmp(header, "\177ELF\1", 5) != 0 || count < 3 || count > MAX_SEGMENTS || 52 + 32 * count > size || size > PAGE_SIZE) {
+		printf("SWEET MPSS: %u: modem.mdt is not such a header (%u segments, %llu bytes)\n", step, count, size);
+		goto fail;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		char name[16];
+
+		memcpy(&segment, header + 52 + 32 * i, sizeof(segment));
+		if (MDT_HASH(segment.flags)) {
+			hashes = segment.file_size;
+		}
+		if (segment.type != 1 || MDT_HASH(segment.flags) || segment.memory_size == 0) {
+			continue;
+		}
+		if (segment.paddr < MPSS_MEMORY || segment.file_size > segment.memory_size ||
+		    (uint64_t)segment.paddr + segment.memory_size > (uint64_t)MPSS_MEMORY + MPSS_MEMORY_SIZE) {
+			printf("SWEET MPSS: %u: segment %u (%#x, %#x bytes) is not within the modem's memory\n", step, i, segment.paddr,
+			    segment.memory_size);
+			goto fail;
+		}
+		image.segment[image.segments].at = segment.paddr - MPSS_MEMORY;
+		image.segment[image.segments].file_size = segment.file_size;
+		image.segment[image.segments].memory_size = segment.memory_size;
+		image.segment[image.segments].file = NULL;
+		if (segment.file_size != 0) {
+			uint64_t file_size = 0;
+
+			snprintf(name, sizeof(name), "modem.b%02u", i);
+			image.segment[image.segments].file = root_file(name, &file_size);
+			if (image.segment[image.segments].file == NULL) {
+				printf("SWEET MPSS: %u: no /fw/image/%s on the root\n", step, name);
+				goto fail;
+			}
+			if (file_size != segment.file_size) {
+				printf("SWEET MPSS: %u: /fw/image/%s has %llu bytes, the header says %u\n", step, name, file_size,
+				    segment.file_size);
+				image.segments++;               /* (for its file to be given back) */
+				goto fail;
+			}
+			files += file_size;
+		}
+		lowest = segment.paddr < lowest ? segment.paddr : lowest;
+		highest = segment.paddr + segment.memory_size > highest ? segment.paddr + segment.memory_size : highest;
+		image.segments++;
+	}
+	if (image.segments == 0 || lowest != MPSS_MEMORY || 52 + 32 * count + (uint64_t)hashes != size) {
+		printf("SWEET MPSS: %u: not what TrustZone takes: %u segments, lowest %#x; header %llu, headers %u, hashes %u\n", step,
+		    image.segments, lowest, size, 52 + 32 * count, hashes);
+		goto fail;
+	}
+	image.size = ((highest + 0xfff) & ~0xfffu) - MPSS_MEMORY;
+	printf("SWEET MPSS: %u: the image is whole: header %llu bytes (%u of hashes), %u segments, %llu bytes of files, %#x bytes of "
+	    "the modem's %#x from %#x\n", step, size, hashes, image.segments, files, image.size, MPSS_MEMORY_SIZE, MPSS_MEMORY);
+	announce("read the modem's file systems from the phone's storage into memory of ours");
+	{
+		unsigned loaded = rmtfs_load();
+
+		printf("SWEET MPSS: %u: %u of the modem's 4 file systems are here%s\n", step, loaded, loaded == 4 ? "" :
+		    ": WITHOUT THEM ALL THE MODEM OFFERS LITTLE");
+		servreg_load();
+	}
+	return true;
+fail:
+	image_forget();
+	return false;
+}
+
+/* ---- TrustZone takes the header; stopping a modem a kernel before this one left running ------------ */
+
+static bool dsp_started;
+static bool stopped_by_its_word;
+static void link_stop(void);
+static bool rmtfs_share(bool in);
+
+static bool
+dsp_shutdown(const char *why)
+{
+	uint64_t answer = ~0ull;
+	int32_t result;
+
+	printf("SWEET MPSS: %u: %s: the modem is asked to stop, then TrustZone to shut it down\n", step, why);
+	link_stop();
+	stopped_by_its_word = dsp_ask_to_stop(5000);
+	result = scm(SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, pas_mpss, 0, 0, 0, &answer);
+	if (result != 0 || answer != 0) {
+		printf("SWEET MPSS: %u: TRUSTZONE DOES NOT SHUT THE MODEM DOWN (ret %d, answer %#llx)\n", step, result, answer);
+		return false;
+	}
+	printf("SWEET MPSS: %u: THE MODEM IS SHUT DOWN\n", step);
+	rmtfs_share(false);
+	dsp_started = false;
+	mailbox_send("{class: image, res: load_state, name: modem, val: off}");
+	if (rails_asked) {
+		rails(0);
+		rails_asked = false;
+	}
+	return true;
+}
+
+static bool
+step_header(void)
+{
+	struct smp2p words;
+	vm_offset_t page = 0;
+	uint64_t answer = ~0ull;
+	int32_t result;
+
+	if (image.segments == 0) {
+		return false;
+	}
+	if (dsp_words(&words)) {
+		show_words("the modem has left words in the shared memory", &words);
+		announce("shut down a modem a kernel before this one may have left running");
+		if (!dsp_shutdown("it may be running")) {
+			return false;
+		}
+		if (!stopped_by_its_word && !option("modem_again")) {
+			printf("SWEET MPSS: %u: NOT STARTED AGAIN: shut down without acknowledging a stop (modem_again=1 to try)\n", step);
+			return false;
+		}
+	} else {
+		printf("SWEET MPSS: %u: the modem has not run since the phone was started\n", step);
+	}
+	announce("hand the image's header to TrustZone to check its signature (PAS_INIT_IMAGE), in a page of ours");
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET MPSS: %u: no memory\n", step);
+		return false;
+	}
+	memcpy((void *)page, image.header, image.header_size);
+	for (vm_offset_t line = page; line < page + PAGE_SIZE; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	settle();
+	result = scm(SCM_PAS_INIT_IMAGE, SCM_VAL_RW, pas_mpss, kvtophys(page), 0, 0, &answer);
+	kmem_free(kernel_map, page, PAGE_SIZE);
+	if (result != 0 || answer != 0) {
+		printf("SWEET MPSS: %u: TRUSTZONE DOES NOT TAKE THE HEADER (ret %d, answer %#llx)\n", step, result, answer);
+		return false;
+	}
+	printf("SWEET MPSS: %u: TRUSTZONE ACCEPTS THE MODEM'S SIGNATURE\n", step);
+	announce("tell TrustZone where the image will be: the whole of the modem's memory (PAS_MEM_SETUP)");
+	result = scm(SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, pas_mpss, MPSS_MEMORY, MPSS_MEMORY_SIZE, 0, &answer);
+	if (result != 0 || answer != 0) {
+		printf("SWEET MPSS: %u: TRUSTZONE DOES NOT TAKE THE PLACE (ret %d, answer %#llx)\n", step, result, answer);
+		return false;
+	}
+	printf("SWEET MPSS: %u: TrustZone takes the place: %#x bytes at %#x\n", step, MPSS_MEMORY_SIZE, MPSS_MEMORY);
+	return true;
+}
+
+/* ---- the image, written into the modem's memory ---------------------------------------------------- */
+
+static bool image_written;
+
+static uint64_t
+segment_word(unsigned s, uint32_t at)
+{
+	uint64_t word = 0;
+
+	for (unsigned b = 0; b < 8 && at + b < image.segment[s].file_size; b++) {
+		word |= (uint64_t)image.segment[s].file[at + b] << (8 * b);
+	}
+	return word;
+}
+
+static void
+segment_put(volatile uint8_t *mem, unsigned s)
+{
+	uint32_t at = image.segment[s].at, size = image.segment[s].memory_size, i = 0;
+
+	if ((at & 7) == 0) {
+		volatile uint64_t *to = (volatile uint64_t *)(mem + at);
+
+		for (; i + 8 <= size; i += 8) {
+			to[i / 8] = segment_word(s, i);
+		}
+	}
+	for (; i < size; i++) {
+		mem[at + i] = i < image.segment[s].file_size ? image.segment[s].file[i] : 0;
+	}
+}
+
+static uint64_t
+segment_check(volatile uint8_t *mem, unsigned s)
+{
+	uint32_t at = image.segment[s].at, size = image.segment[s].memory_size, i = 0;
+	uint64_t wrong = 0;
+
+	if ((at & 7) == 0) {
+		volatile uint64_t *from = (volatile uint64_t *)(mem + at);
+
+		for (; i + 8 <= size; i += 8) {
+			wrong += from[i / 8] != segment_word(s, i);
+		}
+	}
+	for (; i < size; i++) {
+		wrong += mem[at + i] != (i < image.segment[s].file_size ? image.segment[s].file[i] : 0);
+	}
+	return wrong;
+}
+
+static bool
+step_image(void)
+{
+	volatile uint8_t *mem;
+	uint64_t written = 0, cleared = 0, wrong = 0, began;
+
+	if (image.segments == 0) {
+		return false;
+	}
+	announce("put the image's segments into the modem's memory (150 MB, nobody's until TrustZone starts the modem), and read back");
+	mem = (volatile uint8_t *)ml_io_map_unmappable(MPSS_MEMORY, image.size, VM_WIMG_WCOMB);
+	if (mem == NULL) {
+		printf("SWEET MPSS: %u: the modem's memory cannot be mapped (%#x bytes)\n", step, image.size);
+		return false;
+	}
+	began = now_us();
+	for (unsigned s = 0; s < image.segments; s++) {
+		segment_put(mem, s);
+		written += image.segment[s].file_size;
+		cleared += image.segment[s].memory_size - image.segment[s].file_size;
+	}
+	settle();
+	for (unsigned s = 0; s < image.segments; s++) {
+		wrong += segment_check(mem, s);
+	}
+	printf("SWEET MPSS: %u: %u segments, %llu bytes written and %llu cleared in %llu ms; read back, %llu differ\n", step,
+	    image.segments, written, cleared, (now_us() - began) / 1000, wrong);
+	settle();
+	ml_io_unmap((vm_offset_t)mem, image.size);
+	image_written = wrong == 0;
+	image_forget();                         /* (it is in the modem's memory now) */
+	return image_written;
+}
+
+/* ---- our SMP2P item (428) --------------------------------------------------------------------------- */
+
+static struct block smem_lock = { "smem-lock", 0x01f43000, 0x1000, 0 };   /* hwlock@1f40000, lock 3 */
+#define LOCK_OWNER              0x000
+#define LOCK_US                 1u
+
+static bool
+our_item_make(uint32_t partition, uint32_t item, uint32_t bytes)
+{
+	struct smem_partition header;
+	struct smem_entry entry;
+	const uint32_t item_size = (bytes + 7) & ~7u, need_bytes = sizeof(entry) + item_size;
+	uint32_t owner = ~0u, at;
+	bool made = false;
+
+	if (!need(&smem_lock)) {
+		return false;
+	}
+	for (uint32_t ms = 0; ms <= 1000; ms++) {
+		w32(smem_lock.base + LOCK_OWNER, LOCK_US);
+		owner = r32(smem_lock.base + LOCK_OWNER);
+		if (owner == LOCK_US) {
+			break;
+		}
+		sleep_ms(1);
+	}
+	if (owner != LOCK_US) {
+		printf("SWEET MPSS: %u: the shared memory's lock is held by %u for a second: nothing written\n", step, owner);
+		return false;
+	}
+	if (!smem_peek(partition, &header, sizeof(header)) || header.free_uncached > header.free_cached ||
+	    header.free_cached > header.size) {
+		printf("SWEET MPSS: %u: the partition's marks make no sense: nothing written\n", step);
+		goto out;
+	}
+	for (at = sizeof(header); at < header.free_uncached;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.item == item ||
+		    entry.size > header.size) {
+			break;
+		}
+		at += sizeof(entry) + entry.padding_header + entry.size;
+	}
+	if (at != header.free_uncached) {
+		printf("SWEET MPSS: %u: the entries do not end at the mark, or the item has appeared: nothing written\n", step);
+		goto out;
+	}
+	if (at + need_bytes > header.free_cached) {
+		printf("SWEET MPSS: %u: no room: %u wanted, %u free\n", step, need_bytes, header.free_cached - at);
+		goto out;
+	}
+	smem_poke(partition + at, SMEM_CANARY | item << 16);
+	smem_poke(partition + at + 4, item_size);
+	smem_poke(partition + at + 8, item_size - bytes);
+	for (uint32_t z = 0; z < item_size; z += 4) {
+		smem_poke(partition + at + (uint32_t)sizeof(entry) + z, 0);
+	}
+	smem_poke(partition + at + 12, 0);
+	settle();
+	smem_poke(partition + SMEM_PARTITION_FREE_UNCACHED, at + need_bytes);
+	settle();
+	made = true;
+out:
+	w32(smem_lock.base + LOCK_OWNER, 0);
+	return made;
+}
+
+static void glink_reset(void);
+
+static bool
+step_our_item(void)
+{
+	struct smem_partition header;
+	struct smp2p ours;
+	uint32_t cacheline = 0, size = 0, partition, name[4] = { 0 };
+
+	announce("look for our SMP2P item (428) in the partition, make it if there is none, and fill it in");
+	partition = smem_partition(SMEM_US, SMEM_MPSS, &cacheline, &size);
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header))) {
+		printf("SWEET MPSS: %u: there is no such partition\n", step);
+		return false;
+	}
+	our_item = our_item_find();
+	if (our_item != 0) {
+		printf("SWEET MPSS: %u: item %u is there, at %#lx (a kernel before this one made it)\n", step, ITEM_SMP2P_OURS,
+		    (unsigned long)(SMEM_PA + our_item));
+	} else {
+		if (!our_item_make(partition, ITEM_SMP2P_OURS, sizeof(struct smp2p))) {
+			return false;
+		}
+		our_item = our_item_find();
+		if (our_item == 0) {
+			printf("SWEET MPSS: %u: THE ITEM IS NOT FOUND where it was just made\n", step);
+			return false;
+		}
+		printf("SWEET MPSS: %u: item %u made, at %#lx\n", step, ITEM_SMP2P_OURS, (unsigned long)(SMEM_PA + our_item));
+	}
+	/*
+	 * zeroes; from processor 0 to 1, one entry "master-kernel" (the force-stop), feature bit 0; the version
+	 * last. No "ipa" entry: there is no IPA driver here, and milestone 1 (the Wi-Fi) does not need the IPA.
+	 */
+	for (uint32_t at = 0; at < sizeof(ours); at += 4) {
+		smem_poke(our_item + at, 0);
+	}
+	settle();
+	smem_poke(our_item, SMP2P_MAGIC);
+	smem_poke(our_item + SMP2P_AT_PROCESSORS, SMEM_US | SMEM_MPSS << 16);
+	strlcpy((char *)name, OUR_ENTRY_STOP, sizeof(name));
+	for (uint32_t word = 0; word < 4; word++) {
+		smem_poke(our_item + SMP2P_AT_NAME(0) + 4 * word, name[word]);
+	}
+	smem_poke(our_item + SMP2P_AT_COUNTS, 16 | 1u << 16);
+	smem_poke(our_item + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8);
+	settle();
+	smem_poke(our_item + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8 | SMP2P_VERSION);
+	settle();
+	smp2p_agreed = smp2p_restart_acks = smp2p_restart_acked = false;
+	ring(RING_SMP2P);
+	if (!smem_peek(our_item, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC || smp2p_entry(&ours, OUR_ENTRY_STOP) < 0) {
+		printf("SWEET MPSS: %u: OUR ITEM DOES NOT READ BACK AS WRITTEN\n", step);
+		return false;
+	}
+	show_words("our item reads back", &ours);
+	/*
+	 * GLINK's shared memory, which the application processor allocates (modem.md; Linux's
+	 * qcom_glink_smem_register): item 478, the 32-byte descriptor holding the four read/write marks,
+	 * and item 479, our 16 KB transmit queue (the modem's receive). Item 480, the modem's own queue,
+	 * the modem makes. Made here if a kernel before this one has not; left as they are if it has (the
+	 * marks are reset in glink_reset below). Without them the modem's GLINK finds no transport.
+	 */
+	{
+		uint32_t size = 0;
+
+		if (smem_item(ITEM_GLINK_DESCRIPTOR, &size) == 0 && !our_item_make(partition, ITEM_GLINK_DESCRIPTOR, 32)) {
+			printf("SWEET MPSS: %u: GLINK's descriptor (item %u) could not be made\n", step, ITEM_GLINK_DESCRIPTOR);
+			return false;
+		}
+		if (smem_item(ITEM_GLINK_OUR_QUEUE, &size) == 0 && !our_item_make(partition, ITEM_GLINK_OUR_QUEUE, GLINK_OUR_QUEUE_SIZE)) {
+			printf("SWEET MPSS: %u: GLINK's queue (item %u) could not be made\n", step, ITEM_GLINK_OUR_QUEUE);
+			return false;
+		}
+		printf("SWEET MPSS: %u: GLINK's descriptor (478) and our queue (479, %u bytes) are in place\n", step,
+		    GLINK_OUR_QUEUE_SIZE);
+	}
+	glink_reset();
+	return true;
+}
+
+/* ---- start the modem (PAS_AUTH_AND_RESET), and watch for its first words ---------------------------- */
+
+static bool
+step_start(void)
+{
+	struct smp2p words, last;
+	uint64_t answer = ~0ull, started, now, ready_at = 0, limit;
+	uint32_t state = 0, changes = 0, wait_seconds = 10;
+	int32_t result;
+	bool have, spoke = false, handed_over = false;
+
+	if (!image_written) {
+		printf("SWEET MPSS: %u: the image is not in place\n", step);
+		return false;
+	}
+	PE_parse_boot_argn("modem_wait", &wait_seconds, sizeof(wait_seconds));
+	bzero(&last, sizeof(last));
+	have = dsp_words(&last);
+	announce("ask RPMh for the modem's rails, tell the always-on processor its image is loaded, and ask TrustZone to "
+	    "authenticate the image and let the modem out of reset (PAS_AUTH_AND_RESET)");
+	if (option("modem_share_off")) {
+		printf("SWEET MPSS: %u: the buffer is not shared with the modem (modem_share_off)\n", step);
+	} else if (!rmtfs_share(true)) {
+		printf("SWEET MPSS: %u: THE MODEM GETS NO BUFFER FOR ITS FILES: started all the same\n", step);
+	}
+	if (!rails(385)) {
+		return false;
+	}
+	rails_asked = true;
+	if (!mailbox_send("{class: image, res: load_state, name: modem, val: on}")) {
+		rails(0);
+		rails_asked = false;
+		return false;
+	}
+	result = scm(SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, pas_mpss, 0, 0, 0, &answer);
+	started = now_us();
+	image_written = false;
+	if (result != 0 || answer != 0) {
+		printf("SWEET MPSS: %u: TRUSTZONE DOES NOT START THE MODEM (ret %d, answer %#llx)\n", step, result, answer);
+		mailbox_send("{class: image, res: load_state, name: modem, val: off}");
+		rails(0);
+		rails_asked = false;
+		return false;
+	}
+	dsp_started = true;
+	printf("SWEET MPSS: %u: TRUSTZONE HAS STARTED THE MODEM; watching for %u s\n", step, wait_seconds);
+	limit = started + wait_seconds * 1000000ull;
+	for (;;) {
+		now = now_us();
+		if (now >= limit || !dsp_started) {
+			break;
+		}
+		if (dsp_words(&words) && (!have || memcmp(&words, &last, sizeof(words)) != 0)) {
+			char when[64];
+
+			snprintf(when, sizeof(when), "+%llu.%03llu ms: the modem's item %s", (now - started) / 1000,
+			    (now - started) % 1000, have ? "changes" : "APPEARS");
+			if (changes++ < 40) {
+				show_words(when, &words);
+			}
+			last = words;
+			have = spoke = true;
+			dsp_listen(&words);
+			state = dsp_state(&words);
+			if ((state & DSP_READY) && ready_at == 0) {
+				ready_at = now;
+				limit = now + 3000000ull;
+				printf("SWEET MPSS: %u: THE MODEM SAYS IT IS UP (%#x), %llu.%03llu ms after the start\n", step, state,
+				    (now - started) / 1000, (now - started) % 1000);
+			}
+			if ((state & DSP_HANDOVER) && !handed_over) {
+				handed_over = true;
+				printf("SWEET MPSS: %u: the modem has asked for its own power (bit 2): ours is given back\n", step);
+				if (rails_asked) {
+					rails(0);
+					rails_asked = false;
+				}
+			}
+			if (state & DSP_FATAL) {
+				printf("SWEET MPSS: %u: THE MODEM SAYS IT HAS GIVEN UP\n", step);
+				show_crash_reason();
+				break;
+			}
+		}
+		sleep_us(200);
+	}
+	printf("SWEET MPSS: %u: the watch is over after %llu ms\n", step, (now_us() - started) / 1000);
+	show_partition();
+	if (state & DSP_FATAL) {
+		return false;
+	}
+	if (ready_at == 0) {
+		printf("SWEET MPSS: %u: %s\n", step, spoke ? "THE MODEM RUNS BUT HAS NOT SAID UP" : "NOT A WORD FROM THE MODEM");
+		show_crash_reason();
+	}
+	return ready_at != 0;
+}
+
+/* ---- GLINK (items 478 to 480 of our partition with the modem) -------------------------------------- */
+
+#define GLINK_OUR_TAIL          0
+#define GLINK_OUR_HEAD          4
+#define GLINK_THEIR_TAIL        8
+#define GLINK_THEIR_HEAD        12
+#define GLINK_RESERVE           16
+
+enum {
+	GLINK_VERSION = 0, GLINK_VERSION_ACK = 1, GLINK_OPEN = 2, GLINK_CLOSE = 3, GLINK_OPEN_ACK = 4, GLINK_INTENT = 5,
+	GLINK_DONE = 6, GLINK_INTENT_REQUEST = 7, GLINK_INTENT_REQUEST_ACK = 8, GLINK_DATA = 9, GLINK_CLOSE_ACK = 11,
+	GLINK_DATA_MORE = 12, GLINK_READ_NOTIFY = 13, GLINK_DONE_REUSE = 14, GLINK_SIGNALS = 15,
+};
+#define GLINK_VERSION_1         1
+#define GLINK_INTENT_REUSE      1u
+
+struct glink_message {
+	uint16_t command, param1;
+	uint32_t param2;
+};
+struct glink_packet {
+	struct glink_packet *next;
+	uint32_t length;
+	uint8_t data[];
+};
+
+/* The one channel we answer when the modem opens it: IPCRTR, which carries QRTR. */
+enum { CHANNEL_QRTR, CHANNELS };
+
+struct glink_channel {
+	const char *name;
+	uint32_t ours;
+	struct {
+		uint32_t size, count;
+	} intents[3];
+	uint32_t theirs;                        /* the modem's number for it; 0: not opened */
+	bool asked, acknowledged, open;
+	bool request_answered, request_granted;
+	struct {
+		uint32_t id, size;
+		bool there, in_use;
+	} their_intents[64];
+	struct {
+		uint32_t size, fill;
+		uint8_t *data;
+	} our_intents[24];
+	uint32_t our_intent_count;
+	struct glink_packet *first, *last;
+};
+
+static LCK_GRP_DECLARE(mpss_grp, "sweet-mpss");
+static LCK_MTX_DECLARE(glink_lock, &mpss_grp);
+static struct {
+	uint32_t descriptor, ours, ours_size, theirs, theirs_size;
+	bool up, broken;
+	uint32_t features;
+	bool agreed;
+	struct glink_channel channel[CHANNELS];
+	uint32_t said, heard, trace;
+	char others[4][33];
+} glink = {
+	.channel = {
+		[CHANNEL_QRTR] = { .name = "IPCRTR", .ours = 1, .intents = { { 0x800, 5 }, { 0x2000, 3 }, { 0x4400, 2 } } },
+	},
+};
+
+static struct glink_channel *
+glink_theirs(uint32_t theirs)
+{
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		if (glink.channel[c].theirs != 0 && glink.channel[c].theirs == theirs) {
+			return &glink.channel[c];
+		}
+	}
+	return NULL;
+}
+
+static bool
+glink_find(void)
+{
+	uint32_t size = 0;
+
+	glink.descriptor = smem_item(ITEM_GLINK_DESCRIPTOR, &size);
+	if (glink.descriptor == 0 || size != 32) {
+		return false;
+	}
+	glink.ours = smem_item(ITEM_GLINK_OUR_QUEUE, &glink.ours_size);
+	glink.theirs = smem_item(ITEM_GLINK_THEIR_QUEUE, &glink.theirs_size);
+	return glink.ours != 0 && glink.theirs != 0 && glink.ours_size >= 1024 && glink.theirs_size >= 1024 &&
+	       !(glink.ours_size & 7) && !(glink.theirs_size & 7);
+}
+
+static void
+glink_reset(void)
+{
+	uint32_t size = 0, descriptor = smem_item(ITEM_GLINK_DESCRIPTOR, &size);
+
+	if (descriptor == 0 || size != 32) {
+		printf("SWEET MPSS: %u: GLINK's descriptor (item %u) is not there yet\n", step, ITEM_GLINK_DESCRIPTOR);
+		return;
+	}
+	printf("SWEET MPSS: %u: GLINK's descriptor at %#lx: our queue %#x/%#x, the modem's %#x/%#x\n", step,
+	    (unsigned long)(SMEM_PA + descriptor), smem_word(descriptor + GLINK_OUR_TAIL), smem_word(descriptor + GLINK_OUR_HEAD),
+	    smem_word(descriptor + GLINK_THEIR_TAIL), smem_word(descriptor + GLINK_THEIR_HEAD));
+	if (smem_word(descriptor + GLINK_OUR_HEAD) != 0 || smem_word(descriptor + GLINK_THEIR_TAIL) != 0) {
+		smem_poke(descriptor + GLINK_OUR_HEAD, 0);
+		smem_poke(descriptor + GLINK_THEIR_TAIL, 0);
+		settle();
+	}
+}
+
+static uint32_t
+glink_waiting(void)
+{
+	uint32_t head = smem_word(glink.descriptor + GLINK_THEIR_HEAD), tail = smem_word(glink.descriptor + GLINK_THEIR_TAIL);
+
+	if (head >= glink.theirs_size || tail >= glink.theirs_size) {
+		return 0;
+	}
+	return head >= tail ? head - tail : glink.theirs_size - tail + head;
+}
+
+static void
+glink_peek(void *to, uint32_t offset, uint32_t count)
+{
+	uint32_t at = (smem_word(glink.descriptor + GLINK_THEIR_TAIL) + offset) % glink.theirs_size;
+
+	for (uint32_t i = 0; i < count; i++) {
+		((uint8_t *)to)[i] = smem[glink.theirs + (at + i) % glink.theirs_size];
+	}
+}
+
+static void
+glink_advance(uint32_t count)
+{
+	smem_poke(glink.descriptor + GLINK_THEIR_TAIL, (smem_word(glink.descriptor + GLINK_THEIR_TAIL) + count) % glink.theirs_size);
+}
+
+static uint32_t
+glink_room(void)
+{
+	uint32_t head = smem_word(glink.descriptor + GLINK_OUR_HEAD), tail = smem_word(glink.descriptor + GLINK_OUR_TAIL), room;
+
+	if (head >= glink.ours_size || tail >= glink.ours_size) {
+		return 0;
+	}
+	room = tail <= head ? glink.ours_size - head + tail : tail - head;
+	return room < GLINK_RESERVE ? 0 : room - GLINK_RESERVE;
+}
+
+static bool
+glink_put(const void *first, uint32_t first_length, const void *second, uint32_t second_length)
+{
+	volatile uint8_t *queue = (volatile uint8_t *)(uintptr_t)smem + glink.ours;
+	uint32_t head = smem_word(glink.descriptor + GLINK_OUR_HEAD), length = first_length + second_length;
+	uint32_t padded = (length + 7) & ~7u;
+
+	if (!glink.up || glink_room() < padded) {
+		return false;
+	}
+	for (uint32_t i = 0; i < padded; i++) {
+		queue[(head + i) % glink.ours_size] = i < first_length ? ((const uint8_t *)first)[i] :
+		    i < length ? ((const uint8_t *)second)[i - first_length] : 0;
+	}
+	settle();
+	smem_poke(glink.descriptor + GLINK_OUR_HEAD, (head + padded) % glink.ours_size);
+	settle();
+	ring(RING_GLINK);
+	glink.said++;
+	return true;
+}
+
+static const char *
+glink_name(unsigned command)
+{
+	static const char *const names[] = {
+		"version", "version-ack", "open", "close", "open-ack", "intent", "done", "intent-request", "intent-request-ack",
+		"data", "10", "close-ack", "data-more", "read-notify", "done-reuse", "signals"
+	};
+
+	return command < sizeof(names) / sizeof(names[0]) ? names[command] : "?";
+}
+
+static void
+glink_say(unsigned command, uint32_t param1, uint32_t param2, const void *more, uint32_t more_length)
+{
+	struct glink_message message = { .command = (uint16_t)command, .param1 = (uint16_t)param1, .param2 = param2 };
+	bool sent = glink_put(&message, sizeof(message), more, more_length);
+
+	if (glink.trace > 0 || !sent) {
+		glink.trace -= glink.trace > 0;
+		printf("SWEET MPSS: glink: > %s %u %#x%s\n", glink_name(command), param1, param2, sent ? "" : ": NO ROOM, not sent");
+	}
+}
+
+static bool
+glink_offer(struct glink_channel *channel, uint32_t size)
+{
+	uint32_t words[2] = { size, channel->our_intent_count + 1 }, i = channel->our_intent_count;
+
+	if (i >= sizeof(channel->our_intents) / sizeof(channel->our_intents[0]) || size == 0 || size > 0x10000) {
+		return false;
+	}
+	if (channel->our_intents[i].data == NULL || channel->our_intents[i].size != size) {
+		channel->our_intents[i].data = kalloc_data(size, Z_WAITOK | Z_ZERO);
+	}
+	if (channel->our_intents[i].data == NULL) {
+		return false;
+	}
+	channel->our_intents[i].size = size;
+	channel->our_intents[i].fill = 0;
+	channel->our_intent_count++;
+	glink_say(GLINK_INTENT, channel->ours, 1, words, sizeof(words));
+	return true;
+}
+
+/* Everything the modem has put into its queue, taken out and acted on (Linux's qcom_glink_native_rx()). */
+static void
+glink_pump(void)
+{
+	struct glink_message message;
+	struct glink_channel *channel;
+	uint32_t words[4];
+	char name[33];
+
+	while (glink.up && !glink.broken) {
+		uint32_t waiting = glink_waiting(), length = sizeof(message);
+
+		if (waiting < sizeof(message)) {
+			return;
+		}
+		glink_peek(&message, 0, sizeof(message));
+		if (message.command == GLINK_OPEN) {
+			length += message.param2;
+		} else if (message.command == GLINK_INTENT) {
+			length += 8 * message.param2;
+		} else if (message.command == GLINK_DATA || message.command == GLINK_DATA_MORE) {
+			if (waiting < 16) {
+				return;
+			}
+			glink_peek(words, 8, 8);
+			length = 16 + words[0];
+		}
+		length = (length + 7) & ~7u;
+		if (length > glink.theirs_size - 8) {
+			printf("SWEET MPSS: glink: A MESSAGE OF %u BYTES (%s): not believed\n", length, glink_name(message.command));
+			glink.broken = true;
+			return;
+		}
+		if (waiting < length) {
+			return;
+		}
+		glink.heard++;
+		if (glink.trace > 0 && message.command != GLINK_DATA && message.command != GLINK_DATA_MORE &&
+		    message.command != GLINK_INTENT && message.command != GLINK_DONE_REUSE) {
+			glink.trace--;
+			printf("SWEET MPSS: glink: < %s %u %#x\n", glink_name(message.command), message.param1, message.param2);
+		}
+		switch (message.command) {
+		case GLINK_VERSION:
+			if (message.param1 == GLINK_VERSION_1) {
+				glink.features &= message.param2;
+			}
+			glink_advance(length);
+			glink_say(GLINK_VERSION_ACK, GLINK_VERSION_1, glink.features, NULL, 0);
+			break;
+		case GLINK_VERSION_ACK:
+			glink_advance(length);
+			if (message.param1 == GLINK_VERSION_1 && message.param2 == glink.features) {
+				glink.agreed = true;
+			} else if (message.param1 != 0) {
+				glink.features &= message.param2;
+				glink_say(GLINK_VERSION, GLINK_VERSION_1, glink.features, NULL, 0);
+			}
+			break;
+		case GLINK_OPEN:
+			bzero(name, sizeof(name));
+			glink_peek(name, sizeof(message), message.param2 < sizeof(name) - 1 ? message.param2 : sizeof(name) - 1);
+			glink_advance(length);
+			channel = NULL;
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (strcmp(name, glink.channel[c].name) == 0) {
+					channel = &glink.channel[c];
+				}
+			}
+			if (channel == NULL) {
+				printf("SWEET MPSS: glink: the modem opens \"%s\" (its channel %u): nobody here speaks it\n", name,
+				    message.param1);
+				for (unsigned i = 0; i < 4; i++) {
+					if (glink.others[i][0] == 0) {
+						strlcpy(glink.others[i], name, sizeof(glink.others[i]));
+						break;
+					}
+				}
+				break;
+			}
+			printf("SWEET MPSS: glink: the modem opens \"%s\" (its channel %u): acknowledged, opened from our side as %u\n",
+			    name, message.param1, channel->ours);
+			channel->theirs = message.param1;
+			glink_say(GLINK_OPEN_ACK, channel->theirs, 0, NULL, 0);
+			if (!channel->asked) {
+				uint32_t size = (uint32_t)strlen(channel->name) + 1;
+
+				bzero(name, sizeof(name));
+				strlcpy(name, channel->name, sizeof(name));
+				glink_say(GLINK_OPEN, channel->ours, size, name, (size + 7) & ~7u);
+				channel->asked = true;
+			}
+			break;
+		case GLINK_OPEN_ACK:
+			glink_advance(length);
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (message.param1 == glink.channel[c].ours) {
+					glink.channel[c].acknowledged = true;
+				}
+			}
+			break;
+		case GLINK_INTENT:
+			channel = glink_theirs(message.param1);
+			for (uint32_t i = 0; channel != NULL && i < message.param2; i++) {
+				glink_peek(words, 8 + 8 * i, 8);
+				for (unsigned n = 0; n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+					if (!channel->their_intents[n].there || channel->their_intents[n].id == words[1]) {
+						channel->their_intents[n].there = true;
+						channel->their_intents[n].in_use = false;
+						channel->their_intents[n].size = words[0];
+						channel->their_intents[n].id = words[1];
+						break;
+					}
+				}
+			}
+			glink_advance(length);
+			break;
+		case GLINK_DONE:
+		case GLINK_DONE_REUSE:
+			channel = glink_theirs(message.param1);
+			for (unsigned n = 0; channel != NULL && n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+				if (channel->their_intents[n].there && channel->their_intents[n].id == message.param2) {
+					channel->their_intents[n].in_use = false;
+					channel->their_intents[n].there = message.command == GLINK_DONE_REUSE;
+				}
+			}
+			glink_advance(length);
+			break;
+		case GLINK_INTENT_REQUEST:
+			glink_advance(length);
+			if ((channel = glink_theirs(message.param1)) != NULL) {
+				bool granted = glink_offer(channel, message.param2);
+
+				glink_say(GLINK_INTENT_REQUEST_ACK, channel->ours, granted, NULL, 0);
+			}
+			break;
+		case GLINK_INTENT_REQUEST_ACK:
+			glink_advance(length);
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (message.param1 == glink.channel[c].theirs || message.param1 == glink.channel[c].ours) {
+					glink.channel[c].request_answered = true;
+					glink.channel[c].request_granted = message.param2 != 0;
+				}
+			}
+			break;
+		case GLINK_DATA:
+		case GLINK_DATA_MORE: {
+			uint32_t intent = message.param2 - 1;
+
+			channel = glink_theirs(message.param1);
+			if (channel == NULL || intent >= channel->our_intent_count ||
+			    words[0] > channel->our_intents[intent].size - channel->our_intents[intent].fill) {
+				printf("SWEET MPSS: glink: < data of %u on channel %u intent %u: NOT OURS OR TOO MUCH\n", words[0],
+				    message.param1, message.param2);
+				glink_advance(length);
+				break;
+			}
+			glink_peek(channel->our_intents[intent].data + channel->our_intents[intent].fill, 16, words[0]);
+			channel->our_intents[intent].fill += words[0];
+			glink_advance(length);
+			if (words[1] == 0) {
+				struct glink_packet *packet = kalloc_data(sizeof(*packet) + channel->our_intents[intent].fill, Z_WAITOK);
+
+				if (packet != NULL) {
+					packet->next = NULL;
+					packet->length = channel->our_intents[intent].fill;
+					memcpy(packet->data, channel->our_intents[intent].data, packet->length);
+					if (channel->last != NULL) {
+						channel->last->next = packet;
+					} else {
+						channel->first = packet;
+					}
+					channel->last = packet;
+				}
+				channel->our_intents[intent].fill = 0;
+				glink_say(GLINK_DONE_REUSE, channel->ours, message.param2, NULL, 0);
+			}
+			break;
+		}
+		case GLINK_READ_NOTIFY:
+			glink_advance(length);
+			ring(RING_GLINK);
+			break;
+		case GLINK_CLOSE:
+			glink_advance(length);
+			glink_say(GLINK_CLOSE_ACK, message.param1, 0, NULL, 0);
+			if ((channel = glink_theirs(message.param1)) != NULL) {
+				printf("SWEET MPSS: glink: THE MODEM CLOSES \"%s\"\n", channel->name);
+				channel->open = false;
+				channel->theirs = 0;
+			}
+			break;
+		case GLINK_CLOSE_ACK:
+		case GLINK_SIGNALS:
+			glink_advance(length);
+			break;
+		default:
+			printf("SWEET MPSS: glink: A MESSAGE THIS DOES NOT KNOW (%u, %u, %#x)\n", message.command, message.param1,
+			    message.param2);
+			glink.broken = true;
+			return;
+		}
+		for (unsigned c = 0; c < CHANNELS; c++) {
+			channel = &glink.channel[c];
+			if (channel->theirs != 0 && channel->acknowledged && !channel->open) {
+				channel->open = true;
+				printf("SWEET MPSS: glink: THE CHANNEL \"%s\" IS OPEN both ways (ours %u, the modem's %u)\n", channel->name,
+				    channel->ours, channel->theirs);
+				for (unsigned i = 0; i < 3; i++) {
+					for (unsigned n = 0; n < channel->intents[i].count; n++) {
+						glink_offer(channel, channel->intents[i].size);
+					}
+				}
+			}
+		}
+	}
+}
+
+/* One whole message to the modem on a channel; waits up to five seconds for an intent of its that it fits. */
+static int
+glink_send(struct glink_channel *channel, const void *data, uint32_t length)
+{
+	struct {
+		struct glink_message message;
+		uint32_t size, left;
+	} header = { { GLINK_DATA, (uint16_t)channel->ours, 0 }, length, 0 };
+	bool asked = false, fits;
+	int found = -1;
+
+	lck_mtx_lock(&glink_lock);
+	if (glink.up && length + sizeof(header) + 8 > glink.ours_size - GLINK_RESERVE) {
+		lck_mtx_unlock(&glink_lock);
+		return EMSGSIZE;
+	}
+	for (unsigned waited = 0;; waited++) {
+		glink_pump();
+		if (!glink.up || !channel->open || glink.broken) {
+			lck_mtx_unlock(&glink_lock);
+			return ENOTCONN;
+		}
+		found = -1;
+		fits = false;
+		for (unsigned n = 0; n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+			if (!channel->their_intents[n].there || channel->their_intents[n].size < length) {
+				continue;
+			}
+			fits = true;
+			if (!channel->their_intents[n].in_use &&
+			    (found < 0 || channel->their_intents[n].size < channel->their_intents[found].size)) {
+				found = (int)n;
+			}
+		}
+		if (found >= 0 && glink_room() >= ((length + sizeof(header) + 7) & ~7u)) {
+			break;
+		}
+		if (!fits && !asked) {
+			channel->request_answered = false;
+			glink_say(GLINK_INTENT_REQUEST, channel->ours, length, NULL, 0);
+			asked = true;
+		}
+		if (waited >= 5000 || (!fits && asked && channel->request_answered && !channel->request_granted)) {
+			lck_mtx_unlock(&glink_lock);
+			return found < 0 ? ENOBUFS : EAGAIN;
+		}
+		lck_mtx_unlock(&glink_lock);
+		sleep_ms(1);
+		lck_mtx_lock(&glink_lock);
+	}
+	channel->their_intents[found].in_use = true;
+	header.message.param2 = channel->their_intents[found].id;
+	glink_put(&header, sizeof(header), data, length);
+	lck_mtx_unlock(&glink_lock);
+	return 0;
+}
+
+/* ---- QRTR: the router's datagrams, and ports of ours ----------------------------------------------- */
+
+#define QRTR_MAX                8192
+#define QRTR_US                 1u
+#define QRTR_CONTROL            0xfffffffeu
+#define QRTR_FIRST_PORT         0x4000u
+enum { QRTR_DATA = 1, QRTR_HELLO = 2, QRTR_BYE = 3, QRTR_NEW_SERVER = 4, QRTR_DEL_SERVER = 5, QRTR_DEL_CLIENT = 6,
+       QRTR_RESUME_TX = 7, QRTR_NEW_LOOKUP = 10, QRTR_DEL_LOOKUP = 11 };
+
+struct qrtr_header {
+	uint32_t version, type, from_node, from_port, confirm, size, to_node, to_port;
+};
+struct qrtr_control {
+	uint32_t command;
+	uint32_t words[4];
+};
+
+typedef void (*qrtr_receive_t)(void *context, uint32_t node, uint32_t port, const void *data, uint32_t length);
+
+struct qrtr_port {
+	uint32_t number;                        /* 0: free */
+	qrtr_receive_t receive;
+	void *context;
+};
+
+static LCK_MTX_DECLARE(qrtr_lock, &mpss_grp);
+static struct qrtr_port qrtr_ports[8];
+static struct {
+	uint32_t service, instance, node, port;
+	bool there;
+} qrtr_servers[64];
+static uint32_t qrtr_peer;
+static uint32_t qrtr_next_port = QRTR_FIRST_PORT, qrtr_in, qrtr_out, qrtr_hellos, qrtr_lookups;
+static thread_t link_thread_is;
+
+/* Our servers, told of on hello and on lookup (rmtfs, tftp, the service registry). */
+static struct {
+	uint32_t service, instance, port;
+} our_servers[4];
+static uint32_t rmtfs_requests, rmtfs_reads, rmtfs_writes, rmtfs_sectors_read, rmtfs_sectors_written, rmtfs_refused;
+static uint32_t tftp_requests, tftp_served, tftp_refused, servreg_requests;
+
+static int
+qrtr_out_packet(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port, const void *data, uint32_t length)
+{
+	uint32_t padded = (length + 3) & ~3u;
+	struct qrtr_header *packet;
+	int error;
+
+	if (length == 0 || length > QRTR_MAX) {
+		return EMSGSIZE;
+	}
+	packet = kalloc_data(sizeof(*packet) + padded, Z_WAITOK | Z_ZERO);
+	if (packet == NULL) {
+		return ENOMEM;
+	}
+	packet->version = 1;
+	packet->type = type;
+	packet->from_node = QRTR_US;
+	packet->from_port = from_port;
+	packet->size = length;
+	packet->to_node = to_node;
+	packet->to_port = to_port;
+	memcpy(packet + 1, data, length);
+	error = glink_send(&glink.channel[CHANNEL_QRTR], packet, (uint32_t)sizeof(*packet) + padded);
+	kfree_data(packet, sizeof(*packet) + padded);
+	qrtr_out += error == 0;
+	return error;
+}
+
+static struct qrtr_port *
+qrtr_open(qrtr_receive_t receive, void *context)
+{
+	struct qrtr_port *port = NULL;
+
+	lck_mtx_lock(&qrtr_lock);
+	for (unsigned p = 0; p < sizeof(qrtr_ports) / sizeof(qrtr_ports[0]) && port == NULL; p++) {
+		if (qrtr_ports[p].number == 0) {
+			port = &qrtr_ports[p];
+			bzero(port, sizeof(*port));
+			port->number = qrtr_next_port++;
+			port->receive = receive;
+			port->context = context;
+		}
+	}
+	lck_mtx_unlock(&qrtr_lock);
+	return port;
+}
+
+static int
+qrtr_send(struct qrtr_port *port, uint32_t node, uint32_t to, const void *data, uint32_t length)
+{
+	if (port == NULL || port->number == 0 || length > QRTR_MAX) {
+		return EINVAL;
+	}
+	return qrtr_out_packet(QRTR_DATA, port->number, node, to, data, length);
+}
+
+static void
+qrtr_close(struct qrtr_port *port)
+{
+	struct qrtr_control gone = { .command = QRTR_DEL_CLIENT, .words = { QRTR_US, port ? port->number : 0 } };
+
+	if (port == NULL || port->number == 0) {
+		return;
+	}
+	lck_mtx_lock(&qrtr_lock);
+	port->number = 0;
+	lck_mtx_unlock(&qrtr_lock);
+	if (qrtr_peer != 0 && glink.channel[CHANNEL_QRTR].open) {
+		qrtr_out_packet(QRTR_DEL_CLIENT, gone.words[1], qrtr_peer, QRTR_CONTROL, &gone, sizeof(gone));
+	}
+}
+
+/* Our service announced to a node: a "new server", or the empty one that ends an answer to a lookup. */
+static void
+qrtr_announce(uint32_t node, unsigned server, bool end)
+{
+	struct qrtr_control packet = { .command = QRTR_NEW_SERVER };
+
+	if (!end) {
+		packet.words[0] = our_servers[server].service;
+		packet.words[1] = our_servers[server].instance;
+		packet.words[2] = QRTR_US;
+		packet.words[3] = our_servers[server].port;
+	}
+	qrtr_out_packet(QRTR_NEW_SERVER, QRTR_CONTROL, node, QRTR_CONTROL, &packet, sizeof(packet));
+}
+
+static void
+qrtr_announce_all(uint32_t node)
+{
+	for (unsigned i = 0; i < sizeof(our_servers) / sizeof(our_servers[0]); i++) {
+		if (our_servers[i].port != 0) {
+			qrtr_announce(node, i, false);
+		}
+	}
+}
+
+static void
+qrtr_control_in(const struct qrtr_header *header, const struct qrtr_control *control)
+{
+	struct qrtr_control hello = { .command = QRTR_HELLO };
+	int found = -1, error;
+
+	switch (control->command) {
+	case QRTR_HELLO:
+		if (qrtr_hellos++ != 0) {
+			break;
+		}
+		error = qrtr_out_packet(QRTR_HELLO, QRTR_CONTROL, header->from_node, QRTR_CONTROL, &hello, sizeof(hello));
+		printf("SWEET MPSS: qrtr: HELLO FROM NODE %u; ours to it: %s\n", header->from_node, error == 0 ? "SENT" : "NOT SENT");
+		qrtr_announce_all(header->from_node);
+		break;
+	case QRTR_NEW_SERVER:
+		lck_mtx_lock(&qrtr_lock);
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			if (qrtr_servers[i].there && qrtr_servers[i].node == control->words[2] && qrtr_servers[i].port == control->words[3]) {
+				found = (int)i;
+				break;
+			}
+			if (!qrtr_servers[i].there && found < 0) {
+				found = (int)i;
+			}
+		}
+		if (found >= 0) {
+			qrtr_servers[found].there = true;
+			qrtr_servers[found].service = control->words[0];
+			qrtr_servers[found].instance = control->words[1];
+			qrtr_servers[found].node = control->words[2];
+			qrtr_servers[found].port = control->words[3];
+		}
+		lck_mtx_unlock(&qrtr_lock);
+		printf("SWEET MPSS: qrtr: a service: %u (%#x), version %u, instance %u, node %u port %u\n", control->words[0],
+		    control->words[0], control->words[1] & 0xff, control->words[1] >> 8, control->words[2], control->words[3]);
+		break;
+	case QRTR_DEL_SERVER:
+	case QRTR_BYE:
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			bool gone;
+
+			lck_mtx_lock(&qrtr_lock);
+			gone = qrtr_servers[i].there && (control->command == QRTR_BYE ? qrtr_servers[i].node == header->from_node :
+			    qrtr_servers[i].node == control->words[2] && qrtr_servers[i].port == control->words[3]);
+			qrtr_servers[i].there = qrtr_servers[i].there && !gone;
+			lck_mtx_unlock(&qrtr_lock);
+			if (gone) {
+				printf("SWEET MPSS: qrtr: service %u at node %u port %u has gone\n", qrtr_servers[i].service,
+				    qrtr_servers[i].node, qrtr_servers[i].port);
+			}
+		}
+		break;
+	case QRTR_NEW_LOOKUP: {
+		unsigned matches = 0;
+
+		for (unsigned i = 0; i < sizeof(our_servers) / sizeof(our_servers[0]); i++) {
+			if (our_servers[i].port != 0 && (control->words[0] == 0 || our_servers[i].service == control->words[0]) &&
+			    (control->words[1] == 0 || our_servers[i].instance == control->words[1])) {
+				qrtr_announce(header->from_node, i, false);
+				matches++;
+			}
+		}
+		qrtr_announce(header->from_node, 0, true);
+		if (qrtr_lookups++ < 16) {
+			printf("SWEET MPSS: qrtr: the modem looks for service %u (%#x) instance %u: %u of ours\n", control->words[0],
+			    control->words[0], control->words[1], matches);
+		}
+		break;
+	}
+	default:
+		break;
+	}
+}
+
+static void
+qrtr_input(const uint8_t *data, uint32_t length)
+{
+	struct qrtr_header header;
+	qrtr_receive_t receive = NULL;
+	void *context = NULL;
+	uint32_t at;
+
+	if (length >= sizeof(header) && data[0] == 1) {
+		memcpy(&header, data, sizeof(header));
+		at = sizeof(header);
+	} else if (length >= 16 && data[0] == 3) {
+		bzero(&header, sizeof(header));
+		header.type = data[1];
+		header.confirm = data[2] & 1;
+		memcpy(&header.size, data + 4, 4);
+		header.from_node = (uint32_t)(data[8] | data[9] << 8);
+		header.from_port = (uint32_t)(data[10] | data[11] << 8);
+		header.to_node = (uint32_t)(data[12] | data[13] << 8);
+		header.to_port = (uint32_t)(data[14] | data[15] << 8);
+		header.from_port = header.from_port == 0xfffe ? QRTR_CONTROL : header.from_port;
+		header.to_port = header.to_port == 0xfffe ? QRTR_CONTROL : header.to_port;
+		at = 16 + data[3];
+	} else {
+		printf("SWEET MPSS: qrtr: %u bytes that are no datagram\n", length);
+		return;
+	}
+	if (header.size == 0 || at + header.size > length) {
+		printf("SWEET MPSS: qrtr: a datagram of %u in a message of %u: dropped\n", header.size, length);
+		return;
+	}
+	qrtr_in++;
+	if (qrtr_peer == 0) {
+		qrtr_peer = header.from_node;
+	}
+	if (header.type == QRTR_RESUME_TX) {
+		return;
+	}
+	if (header.confirm) {
+		struct qrtr_control resume = { .command = QRTR_RESUME_TX, .words = { header.to_node, header.to_port } };
+
+		qrtr_out_packet(QRTR_RESUME_TX, header.to_port, header.from_node, header.from_port, &resume, sizeof(resume));
+	}
+	if (header.to_port == QRTR_CONTROL || header.type == QRTR_HELLO || header.type == QRTR_BYE ||
+	    header.type == QRTR_NEW_SERVER || header.type == QRTR_DEL_SERVER || header.type == QRTR_NEW_LOOKUP) {
+		struct qrtr_control control = { 0 };
+
+		memcpy(&control, data + at, header.size < sizeof(control) ? header.size : sizeof(control));
+		qrtr_control_in(&header, &control);
+		return;
+	}
+	lck_mtx_lock(&qrtr_lock);
+	for (unsigned p = 0; p < sizeof(qrtr_ports) / sizeof(qrtr_ports[0]); p++) {
+		if (qrtr_ports[p].number == header.to_port && header.type == QRTR_DATA) {
+			receive = qrtr_ports[p].receive;
+			context = qrtr_ports[p].context;
+		}
+	}
+	lck_mtx_unlock(&qrtr_lock);
+	if (receive != NULL) {
+		receive(context, header.from_node, header.from_port, data + at, header.size);
+	} else if (qrtr_in <= 64) {
+		printf("SWEET MPSS: qrtr: a datagram from node %u port %u to our port %u: nobody listens there\n", header.from_node,
+		    header.from_port, header.to_port);
+	}
+}
+
+/* ---- the link's thread ----------------------------------------------------------------------------- */
+
+static volatile bool link_wanted, link_runs;
+
+static void
+link_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	struct smp2p words, last;
+	struct glink_packet *packet;
+	bool gave_up = false;
+
+	bzero(&last, sizeof(last));
+	dsp_words(&last);
+	while (link_wanted) {
+		sleep_ms(1);
+		if (dsp_words(&words) && memcmp(&words, &last, sizeof(words)) != 0) {
+			last = words;
+			dsp_listen(&words);
+			if ((dsp_state(&words) & DSP_FATAL) && !gave_up) {
+				gave_up = true;
+				printf("SWEET MPSS: link: THE MODEM SAYS IT HAS GIVEN UP (%#x)\n", dsp_state(&words));
+				show_crash_reason();
+			}
+		}
+		for (;;) {
+			struct glink_channel *channel = &glink.channel[CHANNEL_QRTR];
+
+			lck_mtx_lock(&glink_lock);
+			glink_pump();
+			packet = channel->first;
+			if (packet != NULL) {
+				channel->first = packet->next;
+				channel->last = channel->first == NULL ? NULL : channel->last;
+			}
+			lck_mtx_unlock(&glink_lock);
+			if (packet == NULL) {
+				break;
+			}
+			qrtr_input(packet->data, packet->length);
+			kfree_data(packet, sizeof(*packet) + packet->length);
+		}
+	}
+	link_runs = false;
+	thread_terminate(current_thread());
+}
+
+static void
+link_stop(void)
+{
+	struct glink_packet *packet;
+
+	if (link_runs) {
+		link_wanted = false;
+		for (unsigned ms = 0; ms < 2000 && link_runs; ms++) {
+			sleep_ms(1);
+		}
+		printf("SWEET MPSS: link: %s; GLINK said %u heard %u, QRTR sent %u received %u; rmtfs: %u requests, %u reads (%u "
+		    "sectors), %u writes (%u sectors), %u refused; tftp: %u requests, %u served, %u refused; registry: %u questions\n",
+		    link_runs ? "THE THREAD DOES NOT END" : "down", glink.said, glink.heard, qrtr_out, qrtr_in, rmtfs_requests,
+		    rmtfs_reads, rmtfs_sectors_read, rmtfs_writes, rmtfs_sectors_written, rmtfs_refused, tftp_requests, tftp_served,
+		    tftp_refused, servreg_requests);
+	}
+	lck_mtx_lock(&glink_lock);
+	glink.up = false;
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		struct glink_channel *channel = &glink.channel[c];
+
+		channel->open = false;
+		while ((packet = channel->first) != NULL) {
+			channel->first = packet->next;
+			kfree_data(packet, sizeof(*packet) + packet->length);
+		}
+		channel->last = NULL;
+	}
+	lck_mtx_unlock(&glink_lock);
+	lck_mtx_lock(&qrtr_lock);
+	bzero(qrtr_servers, sizeof(qrtr_servers));
+	qrtr_peer = 0;
+	lck_mtx_unlock(&qrtr_lock);
+}
+
+/* ---- the modem's file systems: RMTFS, a service of ours on QRTR ------------------------------------- */
+
+#define RMTFS_SERVICE           14
+#define RMTFS_VERSION           1
+#define RMTFS_INSTANCE          0
+#define RMTFS_SECTOR            512
+#define RMTFS_BUFFER_SIZE       0x00300000u     /* dt: reg size of qcom,rmtfs_sharedmem@0 (3 MB) */
+#define RMTFS_OPEN              1
+#define RMTFS_CLOSE             2
+#define RMTFS_RW_IOVEC          3
+#define RMTFS_ALLOC_BUFF        4
+#define RMTFS_GET_DEV_ERROR     5
+#define QMI_REQUEST             0
+#define QMI_RESPONSE            2
+#define QMI_RESULT_FAILURE      1
+#define QMI_ERR_INTERNAL        1
+#define QMI_ERR_MALFORMED       2
+#define VMID_HLOS               3
+#define VMID_MSS_MSA            15
+#define VMID_WLAN               0x18
+#define VMID_WLAN_CE            0x19
+#define VM_PERM_RW              6
+#define WLFW_SERVICE            0x45    /* the Wi-Fi firmware's QMI service (Linux ath10k qmi_wlfw_v01.h) */
+
+/*
+ * The buffer: the modem's addresses are 32 bits, so it must be below 4 GB and in one piece of 3 MB.
+ * HakiOS put it at the compute DSP's reservation 0x9c700000, but that is this phone's splash screen
+ * (cont_splash 0x9c000000-0x9e400000); here it is the compute DSP's region (cdsp_regions 0x99100000,
+ * no-map, the CDSP never started here). modem_buffer=ADDRESS chooses another.
+ */
+static uint64_t rmtfs_buffer_pa = 0x99100000ull;
+static volatile uint8_t *rmtfs_window;
+static bool rmtfs_shared;
+
+static struct {
+	const char *path, *partition;
+	uint8_t *data;
+	uint64_t size;
+	bool open;
+} rmtfs_files[4] = {
+	{ .path = "/boot/modem_fs1", .partition = "modemst1" }, { .path = "/boot/modem_fs2", .partition = "modemst2" },
+	{ .path = "/boot/modem_fsc", .partition = "fsc" },
+	{ .path = "/boot/modem_fsg", .partition = "fsg" },
+};
+static struct qrtr_port *rmtfs_port;
+
+static unsigned
+rmtfs_load(void)
+{
+	unsigned loaded = 0;
+
+	for (unsigned f = 0; f < 4; f++) {
+		uint64_t size = 0;
+		int error = sweet_ufs_read_partition(rmtfs_files[f].partition, 1, 0, NULL, 0, &size);   /* LUN hint 1: not the root's */
+
+		if (error != 0 || size == 0 || size > (64u << 20)) {
+			printf("SWEET MPSS: %u: the partition %s: not read (%d)\n", step, rmtfs_files[f].partition, error);
+			continue;
+		}
+		if (rmtfs_files[f].data == NULL || rmtfs_files[f].size != size) {
+			if (rmtfs_files[f].data != NULL) {
+				kfree_data(rmtfs_files[f].data, rmtfs_files[f].size);
+			}
+			rmtfs_files[f].data = kalloc_data(size, Z_WAITOK | Z_ZERO);
+			rmtfs_files[f].size = rmtfs_files[f].data == NULL ? 0 : size;
+		}
+		if (rmtfs_files[f].data == NULL) {
+			printf("SWEET MPSS: %u: no memory for %s (%llu bytes)\n", step, rmtfs_files[f].partition, size);
+			continue;
+		}
+		error = sweet_ufs_read_partition(rmtfs_files[f].partition, 1, 0, rmtfs_files[f].data, size, NULL);
+		if (error != 0) {
+			printf("SWEET MPSS: %u: the partition %s: read error %d\n", step, rmtfs_files[f].partition, error);
+			continue;
+		}
+		printf("SWEET MPSS: %u: %s (%s): %llu bytes read into memory of ours\n", step, rmtfs_files[f].partition,
+		    rmtfs_files[f].path, size);
+		loaded++;
+	}
+	return loaded;
+}
+
+static bool
+rmtfs_buffer_make(void)
+{
+	if (rmtfs_window != NULL) {
+		return true;
+	}
+	PE_parse_boot_argn("modem_buffer", &rmtfs_buffer_pa, sizeof(rmtfs_buffer_pa));
+	rmtfs_window = (volatile uint8_t *)ml_io_map_unmappable((vm_offset_t)rmtfs_buffer_pa, RMTFS_BUFFER_SIZE, VM_WIMG_WCOMB);
+	if (rmtfs_window == NULL) {
+		printf("SWEET MPSS: %u: the modem's buffer at %#llx cannot be mapped\n", step, rmtfs_buffer_pa);
+		return false;
+	}
+	for (uint32_t i = 0; i < RMTFS_BUFFER_SIZE; i += 8) {
+		*(volatile uint64_t *)(rmtfs_window + i) = 0;
+	}
+	settle();
+	printf("SWEET MPSS: %u: the modem's buffer: %u bytes at %#llx\n", step, RMTFS_BUFFER_SIZE, rmtfs_buffer_pa);
+	return true;
+}
+
+/*
+ * TrustZone asked to let the modem into the buffer (Linux's qcom_scm_assign_mem()), or out again.
+ * vayu's rmtfs has no qcom,vm-nav-path, so only HLOS (3) and MSS_MSA (15) are named, no NAV.
+ */
+static bool
+rmtfs_share(bool in)
+{
+	struct {
+		uint64_t address, size;
+		uint64_t pad0[6];
+		uint32_t sources[3];
+		uint32_t pad1[13];
+		struct {
+			uint32_t vmid, permission;
+			uint64_t context;
+			uint32_t context_size, unused;
+		} destinations[3];
+		uint8_t pad2[40];
+		uint64_t more[7];
+	} *page;
+	vm_offset_t memory = 0;
+	uint64_t answer = ~0ull, pa;
+	unsigned sources, destinations;
+	int32_t result;
+
+	if (in && !rmtfs_buffer_make()) {
+		return false;
+	}
+	if (rmtfs_window == NULL || rmtfs_shared == in) {
+		return rmtfs_window != NULL;
+	}
+	if (kmem_alloc(kernel_map, &memory, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	page = (void *)memory;
+	page->address = rmtfs_buffer_pa;
+	page->size = RMTFS_BUFFER_SIZE;
+	if (in) {
+		page->sources[0] = VMID_HLOS;
+		sources = 1;
+		page->destinations[0].vmid = VMID_HLOS;
+		page->destinations[0].permission = VM_PERM_RW;
+		page->destinations[1].vmid = VMID_MSS_MSA;
+		page->destinations[1].permission = VM_PERM_RW;
+		destinations = 2;
+	} else {
+		page->sources[0] = VMID_HLOS;
+		page->sources[1] = VMID_MSS_MSA;
+		sources = 2;
+		page->destinations[0].vmid = VMID_HLOS;
+		page->destinations[0].permission = VM_PERM_RW;
+		destinations = 1;
+	}
+	pa = kvtophys(memory);
+	page->more[0] = sources * 4;
+	page->more[1] = pa + 128;
+	page->more[2] = destinations * sizeof(page->destinations[0]);
+	page->more[3] = 0;
+	for (vm_offset_t line = memory; line < memory + PAGE_SIZE; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	settle();
+	result = scm(SCM_MP_ASSIGN, SCM_ASSIGN_ARGUMENTS, pa, 16, pa + 64, pa + 240, &answer);
+	kmem_free(kernel_map, memory, PAGE_SIZE);
+	if (result != 0 || answer != 0) {
+		printf("SWEET MPSS: %u: TRUSTZONE DOES NOT %s THE BUFFER (ret %d, answer %#llx)\n", step, in ? "SHARE" : "TAKE BACK",
+		    result, answer);
+		return false;
+	}
+	rmtfs_shared = in;
+	printf("SWEET MPSS: %u: %s\n", step, in ? "THE MODEM MAY USE THE BUFFER" : "the buffer is ours alone again");
+	return true;
+}
+
+static const uint8_t *
+qmi_tlv(const uint8_t *m, size_t length, uint8_t type, uint16_t *size)
+{
+	for (size_t at = 7; at + 3 <= length;) {
+		uint16_t n = (uint16_t)(m[at + 1] | m[at + 2] << 8);
+
+		if (at + 3 + n > length) {
+			return NULL;
+		}
+		if (m[at] == type) {
+			*size = n;
+			return m + at + 3;
+		}
+		at += 3 + n;
+	}
+	return NULL;
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)(p[0] | p[1] << 8 | p[2] << 16 | p[3] << 24);
+}
+
+static void
+rmtfs_receive(__unused void *context, uint32_t node, uint32_t port, const void *data, uint32_t length)
+{
+	const uint8_t *m = data, *value;
+	uint8_t answer[64], *tlv;
+	uint16_t message, size = 0, result = 0, error = 0, extra = 0;
+	unsigned file = 4;
+
+	if (length < 7 || m[0] != QMI_REQUEST) {
+		return;
+	}
+	message = (uint16_t)(m[3] | m[4] << 8);
+	rmtfs_requests++;
+	bzero(answer, sizeof(answer));
+	answer[0] = QMI_RESPONSE;
+	answer[1] = m[1];
+	answer[2] = m[2];
+	answer[3] = m[3];
+	answer[4] = m[4];
+	tlv = answer + 7 + 7;
+	switch (message) {
+	case RMTFS_OPEN:
+		value = qmi_tlv(m, length, 1, &size);
+		for (unsigned f = 0; value != NULL && f < 4; f++) {
+			if (size == strlen(rmtfs_files[f].path) && memcmp(value, rmtfs_files[f].path, size) == 0) {
+				file = f;
+			}
+		}
+		if (file == 4 || rmtfs_files[file].data == NULL) {
+			result = QMI_RESULT_FAILURE;
+			error = QMI_ERR_INTERNAL;
+			rmtfs_refused++;
+			break;
+		}
+		rmtfs_files[file].open = true;
+		printf("SWEET MPSS: rmtfs: the modem opens %s (%llu bytes): caller %u\n", rmtfs_files[file].path, rmtfs_files[file].size,
+		    file + 1);
+		tlv[0] = 0x10;
+		tlv[1] = 4;
+		tlv[2] = 0;
+		tlv[3] = (uint8_t)(file + 1);
+		extra = 7;
+		break;
+	case RMTFS_CLOSE:
+		value = qmi_tlv(m, length, 1, &size);
+		file = value != NULL && size == 4 && le32(value) >= 1 && le32(value) <= 4 ? le32(value) - 1 : 4;
+		if (file < 4) {
+			rmtfs_files[file].open = false;
+		}
+		break;
+	case RMTFS_ALLOC_BUFF:
+		value = qmi_tlv(m, length, 2, &size);
+		if (value == NULL || size != 4 || le32(value) > RMTFS_BUFFER_SIZE || rmtfs_window == NULL || !rmtfs_shared) {
+			result = QMI_RESULT_FAILURE;
+			error = QMI_ERR_INTERNAL;
+			rmtfs_refused++;
+			break;
+		}
+		printf("SWEET MPSS: rmtfs: the modem asks for a buffer of %u bytes: given ours at %#llx\n", le32(value), rmtfs_buffer_pa);
+		tlv[0] = 0x10;
+		tlv[1] = 8;
+		tlv[2] = 0;
+		for (unsigned b = 0; b < 8; b++) {
+			tlv[3 + b] = (uint8_t)(rmtfs_buffer_pa >> (8 * b));
+		}
+		extra = 11;
+		break;
+	case RMTFS_RW_IOVEC: {
+		const uint8_t *direction = qmi_tlv(m, length, 2, &size), *entries;
+		uint16_t direction_size = size, entries_size = 0;
+		bool write;
+		unsigned count;
+
+		value = qmi_tlv(m, length, 1, &size);
+		entries = qmi_tlv(m, length, 3, &entries_size);
+		file = value != NULL && size == 4 && le32(value) >= 1 && le32(value) <= 4 ? le32(value) - 1 : 4;
+		if (file == 4 || !rmtfs_files[file].open || direction == NULL || direction_size != 1 || entries == NULL ||
+		    entries_size < 1 || entries_size != 1 + 12 * entries[0] || rmtfs_window == NULL) {
+			result = QMI_RESULT_FAILURE;
+			error = QMI_ERR_MALFORMED;
+			rmtfs_refused++;
+			break;
+		}
+		write = direction[0] != 0;
+		count = entries[0];
+		for (unsigned e = 0; e < count && result == 0; e++) {
+			uint64_t sector = le32(entries + 1 + 12 * e), physical = le32(entries + 5 + 12 * e);
+			uint64_t sectors = le32(entries + 9 + 12 * e), bytes = sectors * RMTFS_SECTOR;
+
+			if (physical < rmtfs_buffer_pa || physical - rmtfs_buffer_pa + bytes > RMTFS_BUFFER_SIZE ||
+			    sector * RMTFS_SECTOR + bytes > rmtfs_files[file].size) {
+				printf("SWEET MPSS: rmtfs: %s %llu sectors from %llu of %s: OUTSIDE THE FILE OR THE BUFFER\n", write ?
+				    "write" : "read", sectors, sector, rmtfs_files[file].partition);
+				result = QMI_RESULT_FAILURE;
+				error = QMI_ERR_MALFORMED;
+				rmtfs_refused++;
+				break;
+			}
+			if (write) {
+				for (uint64_t i = 0; i < bytes; i++) {
+					rmtfs_files[file].data[sector * RMTFS_SECTOR + i] = rmtfs_window[physical - rmtfs_buffer_pa + i];
+				}
+				rmtfs_sectors_written += sectors;
+			} else {
+				for (uint64_t i = 0; i < bytes; i++) {
+					rmtfs_window[physical - rmtfs_buffer_pa + i] = rmtfs_files[file].data[sector * RMTFS_SECTOR + i];
+				}
+				rmtfs_sectors_read += sectors;
+			}
+		}
+		settle();
+		rmtfs_reads += !write;
+		rmtfs_writes += write;
+		if (rmtfs_reads + rmtfs_writes <= 12) {
+			printf("SWEET MPSS: rmtfs: the modem %s %u pieces of %s%s: served\n", write ? "writes" : "reads", count,
+			    rmtfs_files[file].partition, write ? " (kept in memory, not on the storage)" : "");
+		}
+		break;
+	}
+	case RMTFS_GET_DEV_ERROR:
+		tlv[0] = 0x10;
+		tlv[1] = 1;
+		tlv[2] = 0;
+		tlv[3] = 0;
+		extra = 4;
+		break;
+	default:
+		printf("SWEET MPSS: rmtfs: a request this does not know (%#x)\n", message);
+		result = QMI_RESULT_FAILURE;
+		error = QMI_ERR_MALFORMED;
+		break;
+	}
+	answer[5] = (uint8_t)(7 + extra);
+	answer[6] = (uint8_t)((7 + extra) >> 8);
+	answer[7] = 2;
+	answer[8] = 4;
+	answer[9] = 0;
+	answer[10] = (uint8_t)result;
+	answer[11] = (uint8_t)(result >> 8);
+	answer[12] = (uint8_t)error;
+	answer[13] = (uint8_t)(error >> 8);
+	if (rmtfs_port != NULL) {
+		int sent = qrtr_send(rmtfs_port, node, port, answer, 7 + 7 + extra);
+
+		if (sent != 0) {
+			printf("SWEET MPSS: rmtfs: the answer to %#x is NOT SENT (%d)\n", message, sent);
+		}
+	}
+}
+
+/* ---- TFTP (the modem reads wlanmdsp.mbn and the rest from /fw/image over this; Linux's tqftpserv) --- */
+
+#define TFTP_SERVICE            4096
+#define TFTP_INSTANCE           1
+#define TFTP_RRQ                1
+#define TFTP_WRQ                2
+#define TFTP_DATA               3
+#define TFTP_ACK                4
+#define TFTP_ERROR              5
+#define TFTP_OACK               6
+#define TFTP_ENOENT             1
+#define TFTP_EBADOP             4
+#define TFTP_MAX_BLOCK          (QRTR_MAX - 4)  /* a DATA packet in one QRTR datagram */
+
+static struct qrtr_port *tftp_port;
+
+/* The modem's TFTP paths (/readonly/firmware/image/NAME) map to /fw/image/NAME on the root. */
+static const char *
+tftp_file_of(const char *path)
+{
+	static const char *const prefix = "/readonly/firmware/image/";
+
+	if (strncmp(path, prefix, strlen(prefix)) != 0) {
+		return NULL;
+	}
+	return path + strlen(prefix);
+}
+
+/*
+ * The modem's writes (/readwrite/NAME: tqftpserv keeps them in /data/vendor/tombstones/rfs/modem) are taken and
+ * thrown away: nothing is written to the storage. The modem checks that the server takes writes before it reads
+ * (Linux's tqftpserv: /readwrite/server_check.txt); refused, it retries without end and never reads wlanmdsp.mbn.
+ */
+static bool
+tftp_writable(const char *path)
+{
+	static const char *const prefix = "/readwrite/";
+
+	return strncmp(path, prefix, strlen(prefix)) == 0 && path[strlen(prefix)] != 0;
+}
+
+static uint32_t tftp_writes, tftp_written_bytes;
+
+struct tftp_transfer {
+	struct qrtr_port *port;                 /* the port of this transfer; NULL: free */
+	uint32_t node, peer;
+	uint8_t *data;                          /* a read: the file, whole, in memory of ours */
+	uint64_t size, sent;
+	uint64_t start, limit;                  /* a read: the bytes sent are data[start .. start + limit) */
+	uint32_t block, blksize, wsize;         /* block: the last one acknowledged */
+	uint32_t highest, last;                 /* the highest block sent; the last block of the read (once done) */
+	bool done;
+	bool write;                             /* a write: blocks are acknowledged and dropped */
+	uint64_t received;
+};
+static struct tftp_transfer tftp_transfers[4];
+
+static void
+tftp_error(struct qrtr_port *from, uint32_t node, uint32_t port, uint16_t code, const char *text)
+{
+	uint8_t packet[64];
+	unsigned at = 4;
+
+	packet[0] = 0;
+	packet[1] = TFTP_ERROR;
+	packet[2] = (uint8_t)(code >> 8);
+	packet[3] = (uint8_t)code;
+	at += (unsigned)strlcpy((char *)packet + at, text, sizeof(packet) - at) + 1;
+	qrtr_send(from, node, port, packet, at);
+}
+
+static void
+tftp_transfer_end(struct tftp_transfer *t)
+{
+	if (t->data != NULL) {
+		kfree_data(t->data, t->size);
+	}
+	if (t->port != NULL) {
+		qrtr_close(t->port);
+	}
+	bzero(t, sizeof(*t));
+}
+
+/*
+ * Block number (1-based, 32 bits of ours; the wire has the low 16) of a read: from start (the "seek" option), at most
+ * limit bytes (the "rsize" option, else the rest of the file). A block shorter than blksize - empty if the bytes end
+ * on a block boundary - is the last.
+ */
+static void
+tftp_send_block(struct tftp_transfer *t, uint32_t number)
+{
+	uint8_t *packet;
+	uint64_t at = (uint64_t)(number - 1) * t->blksize;
+	uint32_t length = (uint32_t)(at >= t->limit ? 0 : (t->limit - at < t->blksize ? t->limit - at : t->blksize));
+
+	packet = kalloc_data(4 + length, Z_WAITOK);
+	if (packet == NULL) {
+		return;
+	}
+	packet[0] = 0;
+	packet[1] = TFTP_DATA;
+	packet[2] = (uint8_t)(number >> 8);
+	packet[3] = (uint8_t)number;
+	memcpy(packet + 4, t->data + t->start + at, length);
+	qrtr_send(t->port, t->node, t->peer, packet, 4 + length);
+	kfree_data(packet, 4 + length);
+	if (number > t->highest) {
+		t->highest = number;
+		t->sent = at + length;
+	}
+	if (length < t->blksize) {
+		t->done = true;
+		t->last = number;
+	}
+}
+
+/*
+ * The window (the "wsize" option, else one block) after the last block acknowledged: from the first block not yet
+ * sent, or - again - from the first after the ack when it repeats (a block lost).
+ */
+static void
+tftp_send_window(struct tftp_transfer *t, bool again)
+{
+	uint32_t first = again || t->highest < t->block + 1 ? t->block + 1 : t->highest + 1;
+
+	for (uint32_t n = first; n <= t->block + t->wsize && !(t->done && n > t->last); n++) {
+		tftp_send_block(t, n);
+	}
+}
+
+static void
+tftp_ack(struct tftp_transfer *t, uint16_t block)
+{
+	uint8_t packet[4] = { 0, TFTP_ACK, (uint8_t)(block >> 8), (uint8_t)block };
+
+	qrtr_send(t->port, t->node, t->peer, packet, sizeof(packet));
+}
+
+static void
+tftp_transfer_receive(void *context, uint32_t node, uint32_t port, const void *data, uint32_t length)
+{
+	struct tftp_transfer *t = context;
+	const uint8_t *m = data;
+	uint16_t op, block;
+
+	if (length < 4) {
+		return;
+	}
+	op = (uint16_t)(m[0] << 8 | m[1]);
+	block = (uint16_t)(m[2] << 8 | m[3]);
+	if (op == TFTP_ERROR) {
+		tftp_transfer_end(t);
+		return;
+	}
+	if (t->write) {
+		if (op != TFTP_DATA) {
+			tftp_error(t->port, node, port, TFTP_EBADOP, "expected DATA");
+			tftp_transfer_end(t);
+			return;
+		}
+		if (block == (uint16_t)(t->block + 1)) {
+			t->block = block;
+			t->received += length - 4;
+			tftp_written_bytes += length - 4;
+			t->done = length - 4 < t->blksize;
+		}
+		tftp_ack(t, t->block);          /* a duplicate block: the last one taken acknowledged again */
+		if (t->done) {
+			tftp_writes++;
+			tftp_transfer_end(t);
+		}
+		return;
+	}
+	if (op != TFTP_ACK) {
+		tftp_error(t->port, node, port, TFTP_EBADOP, "expected ACK");
+		tftp_transfer_end(t);
+		return;
+	}
+	/* the ack names the last block taken (0: the OACK); its 16 bits are matched against what is in flight */
+	uint32_t ahead = (uint16_t)(block - (uint16_t)t->block);
+
+	if (ahead > t->highest - t->block) {
+		return;                         /* stale or out of sequence: ignored */
+	}
+	t->block += ahead;
+	if (t->done && t->block >= t->last) {
+		tftp_served++;
+		tftp_transfer_end(t);
+		return;
+	}
+	tftp_send_window(t, ahead == 0);        /* the same ack again: what was sent after it goes again */
+}
+
+/* A write request: taken on a port of its own if under /readwrite/; its blocks are acknowledged and dropped. */
+static void
+tftp_write_start(uint32_t node, uint32_t port, const uint8_t *m, uint32_t length)
+{
+	const char *name = (const char *)m + 2, *options;
+	struct tftp_transfer *t = NULL;
+	uint32_t blksize = 512, at = 2;
+	bool asked = false;
+	uint8_t oack[64];
+
+	if (!tftp_writable(name)) {
+		if (tftp_refused < 20) {
+			printf("SWEET MPSS: tftp: the modem writes \"%s\": NOT A PATH TAKEN HERE\n", name);
+		}
+		tftp_error(tftp_port, node, port, TFTP_ENOENT, "file not found");
+		tftp_refused++;
+		return;
+	}
+	/* after the name its mode, then option and value pairs */
+	for (options = name + strlen(name) + 1 + strlen(name + strlen(name) + 1) + 1; options < (const char *)m + length;) {
+		const char *key = options + strlen(options) + 1;
+
+		if (key >= (const char *)m + length) {
+			break;
+		}
+		if (strcmp(options, "blksize") == 0) {
+			uint32_t b = (uint32_t)strtoul(key, NULL, 10);
+
+			blksize = b >= 8 && b <= TFTP_MAX_BLOCK ? b : TFTP_MAX_BLOCK;
+			asked = true;
+		}
+		options = key + strlen(key) + 1;
+	}
+	for (unsigned i = 0; i < sizeof(tftp_transfers) / sizeof(tftp_transfers[0]) && t == NULL; i++) {
+		if (tftp_transfers[i].port == NULL) {
+			t = &tftp_transfers[i];
+		}
+	}
+	if (t == NULL) {
+		tftp_error(tftp_port, node, port, TFTP_ENOENT, "busy");
+		tftp_refused++;
+		return;
+	}
+	bzero(t, sizeof(*t));
+	t->port = qrtr_open(tftp_transfer_receive, t);
+	if (t->port == NULL) {
+		tftp_error(tftp_port, node, port, TFTP_ENOENT, "no port");
+		tftp_refused++;
+		return;
+	}
+	t->node = node;
+	t->peer = port;
+	t->blksize = blksize;
+	t->write = true;
+	if (tftp_writes < 20) {
+		printf("SWEET MPSS: tftp: the modem writes \"%s\" (blocks of %u): taken, kept nowhere\n", name, blksize);
+	}
+	if (!asked) {
+		tftp_ack(t, 0);
+		return;
+	}
+	oack[0] = 0;
+	oack[1] = TFTP_OACK;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "blksize") + 1;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%u", blksize) + 1;
+	qrtr_send(t->port, node, port, oack, at);
+}
+
+static void
+tftp_receive(__unused void *context, uint32_t node, uint32_t port, const void *data, uint32_t length)
+{
+	const uint8_t *m = data;
+	const char *name, *file, *options;
+	uint8_t oack[128];
+	struct tftp_transfer *t = NULL;
+	uint64_t size = 0;
+	uint8_t *contents;
+	uint32_t blksize = 512, wsize = 1, at = 2;
+	uint64_t rsize = 0, seek = 0;
+	bool want_blksize = false, want_tsize = false, want_wsize = false, want_rsize = false, want_seek = false;
+	unsigned left;
+
+	if (length < 4) {
+		return;
+	}
+	tftp_requests++;
+	name = (const char *)m + 2;
+	for (left = 2; left < length && m[left] != 0; left++) {
+		;
+	}
+	if (left >= length || ((m[0] << 8 | m[1]) != TFTP_RRQ && (m[0] << 8 | m[1]) != TFTP_WRQ)) {
+		if (tftp_refused < 20) {
+			printf("SWEET MPSS: tftp: the modem's request %u: not understood, refused\n", m[0] << 8 | m[1]);
+		}
+		tftp_error(tftp_port, node, port, TFTP_EBADOP, "bad request");
+		tftp_refused++;
+		return;
+	}
+	if ((m[0] << 8 | m[1]) == TFTP_WRQ) {
+		tftp_write_start(node, port, m, length);
+		return;
+	}
+	file = tftp_file_of(name);
+	if (file == NULL || *file == 0) {
+		printf("SWEET MPSS: tftp: the modem reads \"%s\": NOT A PATH SERVED HERE\n", name);
+		tftp_error(tftp_port, node, port, TFTP_ENOENT, "file not found");
+		tftp_refused++;
+		return;
+	}
+	contents = root_file(file, &size);
+	if (contents == NULL) {
+		printf("SWEET MPSS: tftp: the modem reads \"%s\" (/fw/image/%s): NOT HERE\n", name, file);
+		tftp_error(tftp_port, node, port, TFTP_ENOENT, "file not found");
+		tftp_refused++;
+		return;
+	}
+	/*
+	 * The options after the name and its mode (both NUL-terminated), as tqftpserv takes them: blksize, tsize, wsize
+	 * (blocks per ack), rsize (bytes to read) and seek (where to start) - the modem reads big files piece by piece.
+	 */
+	char seen[96] = "";
+	for (options = name + strlen(name) + 1 + strlen(name + strlen(name) + 1) + 1; options < (const char *)m + length;) {
+		const char *key = options + strlen(options) + 1;
+		uint64_t v;
+
+		if (key >= (const char *)m + length) {
+			break;
+		}
+		v = strtouq(key, NULL, 10);
+		if (strcmp(options, "blksize") == 0) {
+			blksize = v >= 8 && v <= TFTP_MAX_BLOCK ? (uint32_t)v : TFTP_MAX_BLOCK;
+			want_blksize = true;
+		} else if (strcmp(options, "tsize") == 0) {
+			want_tsize = true;
+		} else if (strcmp(options, "wsize") == 0) {
+			wsize = v >= 1 && v <= 64 ? (uint32_t)v : (v > 64 ? 64 : 1);
+			want_wsize = true;
+		} else if (strcmp(options, "rsize") == 0) {
+			rsize = v;
+			want_rsize = true;
+		} else if (strcmp(options, "seek") == 0) {
+			seek = v;
+			want_seek = true;
+		}
+		snprintf(seen + strlen(seen), sizeof(seen) - strlen(seen), " %s=%s", options, key);
+		options = key + strlen(key) + 1;
+	}
+	if (seek > size) {
+		printf("SWEET MPSS: tftp: the modem reads \"%s\" from %llu: past its end (%llu bytes)\n", name, seek, size);
+		kfree_data(contents, size);
+		tftp_error(tftp_port, node, port, TFTP_ENOENT, "seek past end");
+		tftp_refused++;
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(tftp_transfers) / sizeof(tftp_transfers[0]) && t == NULL; i++) {
+		if (tftp_transfers[i].port == NULL) {
+			t = &tftp_transfers[i];
+		}
+	}
+	if (t == NULL) {
+		kfree_data(contents, size);
+		tftp_error(tftp_port, node, port, TFTP_ENOENT, "busy");
+		tftp_refused++;
+		return;
+	}
+	bzero(t, sizeof(*t));
+	t->port = qrtr_open(tftp_transfer_receive, t);
+	if (t->port == NULL) {
+		kfree_data(contents, size);
+		tftp_error(tftp_port, node, port, TFTP_ENOENT, "no port");
+		tftp_refused++;
+		return;
+	}
+	t->node = node;
+	t->peer = port;
+	t->data = contents;
+	t->size = size;
+	t->start = seek;
+	t->limit = want_rsize && rsize < size - seek ? rsize : size - seek;
+	t->blksize = blksize;
+	t->wsize = wsize;
+	t->block = 0;
+	if (tftp_requests <= 60) {
+		printf("SWEET MPSS: tftp: the modem reads \"%s\" (/fw/image/%s, %llu bytes):%s -> %llu bytes from %llu, blocks of %u, window %u\n",
+		    name, file, size, seen, t->limit, t->start, blksize, wsize);
+	}
+	if (!want_blksize && !want_tsize && !want_wsize && !want_rsize && !want_seek) {
+		tftp_send_window(t, false);     /* no options: block 1 is the answer */
+		return;
+	}
+	/* OACK: the options asked for, echoed as taken; the data follows on its ack (block 0) */
+	oack[0] = 0;
+	oack[1] = TFTP_OACK;
+#define OACK_PUT(key, format, value) do { \
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%s", key) + 1; \
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, format, value) + 1; \
+} while (0)
+	if (want_blksize) {
+		OACK_PUT("blksize", "%u", blksize);
+	}
+	if (want_tsize) {
+		OACK_PUT("tsize", "%llu", size);
+	}
+	if (want_wsize) {
+		OACK_PUT("wsize", "%u", wsize);
+	}
+	if (want_rsize) {
+		OACK_PUT("rsize", "%llu", t->limit);
+	}
+	if (want_seek) {
+		OACK_PUT("seek", "%llu", seek);
+	}
+#undef OACK_PUT
+	qrtr_send(t->port, node, port, oack, at);
+}
+
+/* ---- the service registry's locator (pd-mapper): the *.jsn beside the firmware --------------------- */
+
+#define SERVREG_SERVICE         64
+#define SERVREG_INSTANCE        257
+#define SERVREG_GET_DOMAIN_LIST 0x21
+#define SERVREG_PFR             0x24
+
+static struct qrtr_port *servreg_port;
+static struct {
+	char service[48];
+	char domain[48];
+	uint32_t instance;
+} servreg_map[32];
+static unsigned servreg_maps;
+
+static const char *
+jsn_string(const char *from, const char *end, const char *key, char *out, size_t out_size)
+{
+	char quoted[48];
+	const char *at;
+
+	snprintf(quoted, sizeof(quoted), "\"%s\"", key);
+	at = strnstr(from, quoted, (size_t)(end - from));
+	if (at == NULL) {
+		return NULL;
+	}
+	at += strlen(quoted);
+	while (at < end && (*at == ':' || *at == ' ' || *at == '\t' || *at == '\n' || *at == '\r')) {
+		at++;
+	}
+	if (at >= end) {
+		return NULL;
+	}
+	if (*at == '"') {
+		const char *close = at + 1;
+
+		while (close < end && *close != '"') {
+			close++;
+		}
+		if (close >= end) {
+			return NULL;
+		}
+		snprintf(out, out_size, "%.*s", (int)(close - at - 1), at + 1);
+		return close + 1;
+	}
+	{
+		const char *close = at;
+
+		while (close < end && ((*close >= '0' && *close <= '9') || *close == '-')) {
+			close++;
+		}
+		snprintf(out, out_size, "%.*s", (int)(close - at), at);
+		return close;
+	}
+}
+
+static void
+servreg_load(void)
+{
+	static const char *const files[] = { "modemr.jsn", "modemuw.jsn", "adspr.jsn", "adspua.jsn", "cdspr.jsn", "slpir.jsn" };
+
+	servreg_maps = 0;
+	for (unsigned f = 0; f < sizeof(files) / sizeof(files[0]); f++) {
+		char soc[24], domain[24], subdomain[24], instance[16], provider[24], service[24], full[48];
+		uint64_t size = 0;
+		uint8_t *data;
+		const char *text, *end, *at;
+
+		data = root_file(files[f], &size);
+		if (data == NULL) {
+			continue;
+		}
+		text = (const char *)data;
+		end = text + size;
+		if (jsn_string(text, end, "soc", soc, sizeof(soc)) == NULL || jsn_string(text, end, "domain", domain, sizeof(domain)) == NULL ||
+		    jsn_string(text, end, "subdomain", subdomain, sizeof(subdomain)) == NULL ||
+		    jsn_string(text, end, "qmi_instance_id", instance, sizeof(instance)) == NULL) {
+			printf("SWEET MPSS: servreg: fw/image/%s: not of the shape this reads\n", files[f]);
+			kfree_data(data, size);
+			continue;
+		}
+		snprintf(full, sizeof(full), "%s/%s/%s", soc, domain, subdomain);
+		at = text;
+		while (servreg_maps < sizeof(servreg_map) / sizeof(servreg_map[0]) &&
+		    (at = jsn_string(at, end, "provider", provider, sizeof(provider))) != NULL &&
+		    jsn_string(at, end, "service", service, sizeof(service)) != NULL) {
+			snprintf(servreg_map[servreg_maps].service, sizeof(servreg_map[0].service), "%s/%s", provider, service);
+			strlcpy(servreg_map[servreg_maps].domain, full, sizeof(servreg_map[0].domain));
+			servreg_map[servreg_maps].instance = (uint32_t)strtoul(instance, NULL, 10);
+			servreg_maps++;
+		}
+		kfree_data(data, size);
+	}
+	printf("SWEET MPSS: %u: the service registry: %u services of %u files\n", step, servreg_maps,
+	    (unsigned)(sizeof(files) / sizeof(files[0])));
+	for (unsigned i = 0; i < servreg_maps; i++) {
+		printf("SWEET MPSS: %u:   %s at %s, instance %u\n", step, servreg_map[i].service, servreg_map[i].domain,
+		    servreg_map[i].instance);
+	}
+}
+
+static void
+servreg_receive(__unused void *context, uint32_t node, uint32_t port, const void *data, uint32_t length)
+{
+	const uint8_t *m = data, *value;
+	uint8_t answer[512];
+	uint16_t message, size = 0;
+	unsigned at = 7 + 7, found = 0;
+	char wanted[64] = "";
+
+	if (length < 7 || m[0] != QMI_REQUEST) {
+		return;
+	}
+	message = (uint16_t)(m[3] | m[4] << 8);
+	servreg_requests++;
+	bzero(answer, sizeof(answer));
+	answer[0] = QMI_RESPONSE;
+	answer[1] = m[1];
+	answer[2] = m[2];
+	answer[3] = m[3];
+	answer[4] = m[4];
+	answer[7] = 2;
+	answer[8] = 4;
+	if (message == SERVREG_GET_DOMAIN_LIST) {
+		value = qmi_tlv(m, length, 1, &size);
+		if (value != NULL) {
+			snprintf(wanted, sizeof(wanted), "%.*s", (int)(size < 63 ? size : 63), (const char *)value);
+		}
+		for (unsigned i = 0; i < servreg_maps; i++) {
+			found += strcmp(servreg_map[i].service, wanted) == 0;
+		}
+		answer[at++] = 0x10;
+		answer[at++] = 2;
+		answer[at++] = 0;
+		answer[at++] = (uint8_t)found;
+		answer[at++] = (uint8_t)(found >> 8);
+		answer[at++] = 0x11;
+		answer[at++] = 2;
+		answer[at++] = 0;
+		answer[at++] = 1;
+		answer[at++] = 0;
+		if (found != 0) {
+			unsigned list = at;
+
+			answer[at++] = 0x12;
+			at += 2;
+			answer[at++] = (uint8_t)found;
+			for (unsigned i = 0; i < servreg_maps && at + 64 < sizeof(answer); i++) {
+				if (strcmp(servreg_map[i].service, wanted) != 0) {
+					continue;
+				}
+				answer[at++] = (uint8_t)strlen(servreg_map[i].domain);
+				memcpy(answer + at, servreg_map[i].domain, strlen(servreg_map[i].domain));
+				at += (unsigned)strlen(servreg_map[i].domain);
+				for (unsigned b = 0; b < 4; b++) {
+					answer[at++] = (uint8_t)(servreg_map[i].instance >> (8 * b));
+				}
+				answer[at++] = 0;
+				at += 4;
+			}
+			answer[list + 1] = (uint8_t)(at - list - 3);
+			answer[list + 2] = (uint8_t)((at - list - 3) >> 8);
+		}
+		printf("SWEET MPSS: servreg: the modem asks where \"%s\" is: %u domain%s\n", wanted, found, found == 1 ? "" : "s");
+	} else if (message == SERVREG_PFR) {
+		uint16_t why_size = 0;
+		const uint8_t *why = qmi_tlv(m, length, 2, &why_size);  /* the reason, as the modem words it */
+
+		value = qmi_tlv(m, length, 1, &size);
+		printf("SWEET MPSS: servreg: the modem reports a failure of \"%.*s\": \"%.*s\"\n", value ? (int)(size < 63 ? size : 63) : 0,
+		    value ? (const char *)value : "", why ? (int)(why_size < 200 ? why_size : 200) : 0, why ? (const char *)why : "");
+	} else {
+		printf("SWEET MPSS: servreg: a request this does not know (%#x)\n", message);
+		answer[10] = QMI_RESULT_FAILURE;
+		answer[12] = QMI_ERR_MALFORMED;
+	}
+	answer[5] = (uint8_t)(at - 7);
+	answer[6] = (uint8_t)((at - 7) >> 8);
+	qrtr_send(servreg_port, node, port, answer, at);
+}
+
+/* The ports, and the services on them. */
+static bool
+services_start(void)
+{
+	if (rmtfs_port == NULL) {
+		rmtfs_port = qrtr_open(rmtfs_receive, NULL);
+	}
+	if (rmtfs_port == NULL) {
+		return false;
+	}
+	our_servers[0].service = RMTFS_SERVICE;
+	our_servers[0].instance = RMTFS_VERSION | RMTFS_INSTANCE << 8;
+	our_servers[0].port = rmtfs_port->number;
+	if (tftp_port == NULL) {
+		tftp_port = qrtr_open(tftp_receive, NULL);
+	}
+	if (tftp_port != NULL) {
+		our_servers[1].service = TFTP_SERVICE;
+		our_servers[1].instance = TFTP_INSTANCE;
+		our_servers[1].port = tftp_port->number;
+	}
+	if (servreg_port == NULL) {
+		servreg_port = qrtr_open(servreg_receive, NULL);
+	}
+	if (servreg_port != NULL) {
+		our_servers[2].service = SERVREG_SERVICE;
+		our_servers[2].instance = SERVREG_INSTANCE;
+		our_servers[2].port = servreg_port->number;
+	}
+	return true;
+}
+
+/* ---- step 7: GLINK, and the link's thread ---------------------------------------------------------- */
+
+static bool
+step_link(void)
+{
+	thread_t thread;
+	uint64_t began;
+
+	if (!dsp_started) {
+		return false;
+	}
+	if (!glink_find()) {
+		printf("SWEET MPSS: %u: GLINK's queues (items 478-480) are not there\n", step);
+		return false;
+	}
+	announce("take up GLINK with the modem (our version, the channel IPCRTR); a thread of ours listens from here, every ms");
+	if (!services_start()) {
+		printf("SWEET MPSS: %u: no port for the modem's file services\n", step);
+	}
+	lck_mtx_lock(&glink_lock);
+	glink.features = GLINK_INTENT_REUSE;
+	glink.agreed = glink.broken = false;
+	glink.said = glink.heard = 0;
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		struct glink_channel *channel = &glink.channel[c];
+
+		channel->asked = channel->acknowledged = channel->open = false;
+		channel->theirs = channel->our_intent_count = 0;
+		bzero(channel->their_intents, sizeof(channel->their_intents));
+	}
+	bzero(glink.others, sizeof(glink.others));
+	glink.trace = 60;
+	glink.up = true;
+	qrtr_hellos = qrtr_in = qrtr_out = qrtr_lookups = 0;
+	began = now_us();
+	glink_say(GLINK_VERSION, GLINK_VERSION_1, glink.features, NULL, 0);
+	lck_mtx_unlock(&glink_lock);
+	link_wanted = link_runs = true;
+	if (kernel_thread_start(link_thread, NULL, &thread) != KERN_SUCCESS) {
+		link_wanted = link_runs = false;
+		printf("SWEET MPSS: %u: no thread\n", step);
+		return false;
+	}
+	link_thread_is = thread;
+	thread_deallocate(thread);
+	for (unsigned ms = 0; ms < 5000 && !glink.channel[CHANNEL_QRTR].open && !glink.broken; ms++) {
+		sleep_ms(1);
+	}
+	sleep_ms(50);
+	printf("SWEET MPSS: %u: %llu ms after our version: versions %s (features %#x); IPCRTR is %s; the modem also opened "
+	    "\"%s\" \"%s\" \"%s\" \"%s\"\n", step, (now_us() - began) / 1000, glink.agreed ? "agreed" : "NOT AGREED", glink.features,
+	    glink.channel[CHANNEL_QRTR].open ? "OPEN" : "NOT OPEN", glink.others[0], glink.others[1], glink.others[2], glink.others[3]);
+	return glink.channel[CHANNEL_QRTR].open;
+}
+
+/* ---- step 8: QRTR ---------------------------------------------------------------------------------- */
+
+static uint32_t listen_seconds = 5;
+
+static bool
+step_qrtr(void)
+{
+	unsigned services = 0, wlfw = 0;
+
+	if (!glink.channel[CHANNEL_QRTR].open) {
+		return false;
+	}
+	PE_parse_boot_argn("modem_listen", &listen_seconds, sizeof(listen_seconds));
+	announce("listen to QRTR: the modem's hello (answered from the link's thread) and the services it tells of (WLFW wanted)");
+	for (unsigned ms = 0; ms < listen_seconds * 1000; ms++) {
+		sleep_ms(1);
+	}
+	lck_mtx_lock(&qrtr_lock);
+	for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+		services += qrtr_servers[i].there;
+		wlfw += qrtr_servers[i].there && qrtr_servers[i].service == WLFW_SERVICE;
+	}
+	lck_mtx_unlock(&qrtr_lock);
+	printf("SWEET MPSS: %u: after %u s: %s; the modem is node %u, told of %u services (WLFW %s); it looked for %u of ours; QRTR "
+	    "received %u and sent %u datagrams\n", step, listen_seconds, qrtr_hellos ? "HELLO BOTH WAYS" : "NO HELLO FROM THE MODEM",
+	    qrtr_peer, services, wlfw ? "PRESENT - the Wi-Fi firmware service is up" : "not yet", qrtr_lookups, qrtr_in, qrtr_out);
+	return qrtr_hellos != 0;
+}
+
+/*
+ * ---- step 9: the Wi-Fi firmware's service (WLFW), as Linux's ath10k/qmi.c speaks to it -----------------
+ *
+ * The WLAN PD the modem started (WCN3998's firmware, wlanmdsp.mbn) offers QMI service 0x45. Before the radio is
+ * touched the driver: registers for its indications (fw ready, MSA ready), says what the host can do (host cap),
+ * tells it where the MSA memory is (dt: qcom,icnss@18800000 qcom,wlan-msa-fixed-region = pil_wlan_fw_region
+ * 0x8bc00000, qcom,wlan-msa-memory 0x100000) and has TrustZone give the regions it names to the modem and the
+ * WLAN (no qcom,msa-fixed-perm), says MSA ready, asks the capabilities (chip, board, SoC, firmware version),
+ * then, on the MSA-ready indication, downloads the board data (bdwlan.bNN by board id, else bdwlan.bin, from
+ * /fw/image) and sends the calibration report; the firmware answers with "fw ready". The radio's mode (wlan-cfg,
+ * wlan-mode) and its copy engines are for the steps after this one. Its four supplies are switched on first.
+ */
+
+#define WLFW_IND_REGISTER       0x0020
+#define WLFW_FW_READY_IND       0x0021
+#define WLFW_CAP                0x0024
+#define WLFW_BDF_DOWNLOAD       0x0025
+#define WLFW_CAL_REPORT         0x0026
+#define WLFW_MSA_READY_IND      0x002b
+#define WLFW_PIN_CONNECT_IND    0x002c
+#define WLFW_MSA_INFO           0x002d
+#define WLFW_MSA_READY          0x002e
+#define WLFW_HOST_CAP           0x0034
+#define WLFW_CLIENT_ID          0x4b4e454cu     /* ath10k's ATH10K_QMI_CLIENT_ID */
+#define WLFW_MSA_PA             0x8bc00000ull
+#define WLFW_MSA_SIZE           0x100000u
+#define WLFW_BDF_PIECE          6144u           /* QMI_WLFW_MAX_DATA_SIZE_V01 */
+#define QMI_INDICATION          4
+
+static struct qrtr_port *wlfw_port;
+static uint32_t wlfw_node, wlfw_peer;
+static uint16_t wlfw_txn;
+static struct {
+	uint16_t txn;                           /* the request waited for */
+	bool answered;
+	uint8_t answer[1024];
+	uint32_t length;
+	bool msa_ready, fw_ready;               /* indications seen */
+	uint32_t indications;
+} wlfw;
+static LCK_MTX_DECLARE(wlfw_lock, &mpss_grp);
+
+static void
+wlfw_receive(__unused void *context, uint32_t node, uint32_t port, const void *data, uint32_t length)
+{
+	const uint8_t *m = data;
+	uint16_t txn, id;
+
+	if (length < 7 || node != wlfw_node || port != wlfw_peer) {
+		return;
+	}
+	txn = (uint16_t)(m[1] | m[2] << 8);
+	id = (uint16_t)(m[3] | m[4] << 8);
+	lck_mtx_lock(&wlfw_lock);
+	if (m[0] == QMI_RESPONSE && txn == wlfw.txn && !wlfw.answered) {
+		wlfw.length = length < sizeof(wlfw.answer) ? length : (uint32_t)sizeof(wlfw.answer);
+		memcpy(wlfw.answer, m, wlfw.length);
+		wlfw.answered = true;
+	} else if (m[0] == QMI_INDICATION) {
+		wlfw.indications++;
+		wlfw.msa_ready |= id == WLFW_MSA_READY_IND;
+		wlfw.fw_ready |= id == WLFW_FW_READY_IND;
+	}
+	lck_mtx_unlock(&wlfw_lock);
+	if (m[0] == QMI_INDICATION) {
+		printf("SWEET MPSS: wlfw: indication 0x%04x (%s), %u bytes\n", id, id == WLFW_MSA_READY_IND ? "MSA ready" :
+		    id == WLFW_FW_READY_IND ? "FIRMWARE READY" : id == WLFW_PIN_CONNECT_IND ? "pin connect result" : "other",
+		    length);
+	}
+}
+
+static void
+tlv_put(uint8_t *m, uint32_t *at, uint8_t type, const void *value, uint16_t size)
+{
+	m[*at] = type;
+	m[*at + 1] = (uint8_t)size;
+	m[*at + 2] = (uint8_t)(size >> 8);
+	memcpy(m + *at + 3, value, size);
+	*at += 3u + size;
+}
+
+static void
+tlv_u8(uint8_t *m, uint32_t *at, uint8_t type, uint8_t value)
+{
+	tlv_put(m, at, type, &value, 1);
+}
+
+static void
+tlv_u32(uint8_t *m, uint32_t *at, uint8_t type, uint32_t value)
+{
+	uint8_t v[4] = { (uint8_t)value, (uint8_t)(value >> 8), (uint8_t)(value >> 16), (uint8_t)(value >> 24) };
+
+	tlv_put(m, at, type, v, 4);
+}
+
+/*
+ * A request of the TLVs in m[7 .. at) and its answer, waited for up to ms: 0 and the QMI result (TLV 2) in
+ * result and error, or an errno. The answer stays in wlfw.answer for the caller to read.
+ */
+static int
+wlfw_call(uint16_t id, uint8_t *m, uint32_t at, uint32_t ms, uint16_t *result, uint16_t *error)
+{
+	const uint8_t *r;
+	uint16_t size = 0, txn;
+	bool answered = false;
+
+	txn = ++wlfw_txn == 0 ? ++wlfw_txn : wlfw_txn;
+	m[0] = QMI_REQUEST;
+	m[1] = (uint8_t)txn;
+	m[2] = (uint8_t)(txn >> 8);
+	m[3] = (uint8_t)id;
+	m[4] = (uint8_t)(id >> 8);
+	m[5] = (uint8_t)(at - 7);
+	m[6] = (uint8_t)((at - 7) >> 8);
+	lck_mtx_lock(&wlfw_lock);
+	wlfw.txn = txn;
+	wlfw.answered = false;
+	lck_mtx_unlock(&wlfw_lock);
+	if (qrtr_send(wlfw_port, wlfw_node, wlfw_peer, m, at) != 0) {
+		return EIO;
+	}
+	for (uint32_t waited = 0; waited < ms && !answered; waited++) {
+		sleep_ms(1);
+		lck_mtx_lock(&wlfw_lock);
+		answered = wlfw.answered;
+		lck_mtx_unlock(&wlfw_lock);
+	}
+	if (!answered) {
+		return ETIMEDOUT;
+	}
+	r = qmi_tlv(wlfw.answer, wlfw.length, 2, &size);
+	if (r == NULL || size < 4) {
+		return EBADMSG;
+	}
+	*result = (uint16_t)(r[0] | r[1] << 8);
+	*error = (uint16_t)(r[2] | r[3] << 8);
+	return 0;
+}
+
+/* The MSA regions the firmware named, given by TrustZone from us to the modem and the WLAN (ath10k's map). */
+static bool
+wlfw_assign(uint64_t pa, uint32_t size, bool secure)
+{
+	struct {
+		uint64_t address, size;
+		uint64_t pad0[6];
+		uint32_t sources[3];
+		uint32_t pad1[13];
+		struct {
+			uint32_t vmid, permission;
+			uint64_t context;
+			uint32_t context_size, unused;
+		} destinations[3];
+		uint8_t pad2[40];
+		uint64_t more[7];
+	} *page;
+	vm_offset_t memory = 0;
+	uint64_t answer = ~0ull, at;
+	unsigned destinations = secure ? 2 : 3;
+	int32_t result;
+
+	if (kmem_alloc(kernel_map, &memory, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	page = (void *)memory;
+	page->address = pa;
+	page->size = size;
+	page->sources[0] = VMID_HLOS;
+	page->destinations[0].vmid = VMID_MSS_MSA;
+	page->destinations[0].permission = VM_PERM_RW;
+	page->destinations[1].vmid = VMID_WLAN;
+	page->destinations[1].permission = VM_PERM_RW;
+	page->destinations[2].vmid = VMID_WLAN_CE;
+	page->destinations[2].permission = VM_PERM_RW;
+	at = kvtophys(memory);
+	page->more[0] = 4;
+	page->more[1] = at + 128;
+	page->more[2] = destinations * sizeof(page->destinations[0]);
+	page->more[3] = 0;
+	for (vm_offset_t line = memory; line < memory + PAGE_SIZE; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	settle();
+	result = scm(SCM_MP_ASSIGN, SCM_ASSIGN_ARGUMENTS, at, 16, at + 64, at + 240, &answer);
+	kmem_free(kernel_map, memory, PAGE_SIZE);
+	printf("SWEET MPSS: %u: MSA %#llx + %#x to the modem and the WLAN%s: %s (ret %d, answer %#llx)\n", step, pa, size,
+	    secure ? "" : " and its copy engines", result == 0 && answer == 0 ? "GIVEN" : "REFUSED", result, answer);
+	return result == 0 && answer == 0;
+}
+
+/* The board data, in pieces of 6144 bytes; the last one with "end", which makes the firmware check it. */
+static bool
+wlfw_board_data(uint32_t board_id)
+{
+	char name[24];
+	uint8_t *data, *m;
+	uint64_t size = 0;
+	uint16_t result = 0, error = 0;
+	bool ok = true;
+
+	snprintf(name, sizeof(name), "bdwlan.b%02x", board_id & 0xff);
+	data = board_id < 0xff ? root_file(name, &size) : NULL;
+	if (data == NULL) {
+		strlcpy(name, "bdwlan.bin", sizeof(name));
+		data = root_file(name, &size);
+	}
+	if (data == NULL || size == 0 || size > (1u << 20)) {
+		printf("SWEET MPSS: %u: no board data (/fw/image/bdwlan.*) for board %#x\n", step, board_id);
+		if (data != NULL) {
+			kfree_data(data, size);
+		}
+		return false;
+	}
+	m = kalloc_data(7 + 64 + WLFW_BDF_PIECE, Z_WAITOK | Z_ZERO);
+	if (m == NULL) {
+		kfree_data(data, size);
+		return false;
+	}
+	for (uint32_t seg = 0, done = 0; ok && done < size; seg++) {
+		uint32_t piece = (uint32_t)MIN(size - done, (uint64_t)WLFW_BDF_PIECE), at = 7;
+		uint8_t end = done + piece == size;
+		uint8_t v[2] = { (uint8_t)piece, (uint8_t)(piece >> 8) };
+		int e;
+
+		tlv_u8(m, &at, 0x01, 1);                        /* valid */
+		tlv_u32(m, &at, 0x10, 0);                       /* file id */
+		tlv_u32(m, &at, 0x11, (uint32_t)size);          /* total size */
+		tlv_u32(m, &at, 0x12, seg);                     /* segment */
+		m[at] = 0x13;                                   /* data: u16 length, then the bytes */
+		m[at + 1] = (uint8_t)(piece + 2);
+		m[at + 2] = (uint8_t)((piece + 2) >> 8);
+		memcpy(m + at + 3, v, 2);
+		memcpy(m + at + 5, data + done, piece);
+		at += 5 + piece;
+		tlv_u8(m, &at, 0x14, end);
+		e = wlfw_call(WLFW_BDF_DOWNLOAD, m, at, 5000, &result, &error);
+		/* a failed check on the last piece is not fatal (ath10k): released BDFs often fail it */
+		ok = e == 0 && (result == 0 || end);
+		if (!ok || end) {
+			printf("SWEET MPSS: %u: board data %s (%llu bytes), piece %u: %s (errno %d, result %u, error %u)\n", step, name,
+			    size, seg, ok ? "TAKEN" : "REFUSED", e, result, error);
+		}
+		done += piece;
+	}
+	kfree_data(m, 7 + 64 + WLFW_BDF_PIECE);
+	kfree_data(data, size);
+	return ok;
+}
+
+static bool
+step_wlfw(void)
+{
+	uint8_t m[128];
+	uint32_t at, board_id = 0xff;
+	uint16_t result = 0, error = 0, size = 0;
+	const uint8_t *v;
+	int e;
+
+	announce("find the Wi-Fi firmware's service (WLFW, QMI 0x45) and do what ath10k does before the radio: indications, "
+	    "host capabilities, MSA, capabilities, board data, calibration report; then wait for \"fw ready\"");
+	for (unsigned ms = 0; ms < 20000 && wlfw_peer == 0; ms += 10) {
+		lck_mtx_lock(&qrtr_lock);
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			if (qrtr_servers[i].there && qrtr_servers[i].service == WLFW_SERVICE) {
+				wlfw_node = qrtr_servers[i].node;
+				wlfw_peer = qrtr_servers[i].port;
+			}
+		}
+		lck_mtx_unlock(&qrtr_lock);
+		if (wlfw_peer == 0) {
+			sleep_ms(10);
+		}
+	}
+	if (wlfw_peer == 0) {
+		printf("SWEET MPSS: %u: no WLFW within 20 s\n", step);
+		return false;
+	}
+	wlfw_port = qrtr_open(wlfw_receive, NULL);
+	if (wlfw_port == NULL) {
+		return false;
+	}
+	printf("SWEET MPSS: %u: WLFW at node %u port %u\n", step, wlfw_node, wlfw_peer);
+
+	/*
+	 * The radio's supplies on first, as the vendor's icnss does when the service arrives (without them the WLAN
+	 * PD failed right after the calibration report): vdd-cx-mx, vdd-1.8-xo, vdd-1.3-rfa, vdd-3.3-ch0 in that
+	 * order. sweetwlfwpower=0 leaves them as the boot chain left them.
+	 */
+	{
+		static const struct {
+			const char *res;
+			unsigned mv;
+		} supplies[] = { { "ldoa1", 752 }, { "ldoa7", 1800 }, { "ldoc2", 1304 }, { "ldoc11", 3300 }, { "rfclka2", 0 } };
+		uint32_t power = 1;
+
+		PE_parse_boot_argn("sweetwlfwpower", &power, sizeof(power));
+		for (unsigned i = 0; power && i < sizeof(supplies) / sizeof(supplies[0]); i++) {
+			int pe = sweet_rpmh_wifi_ldo(supplies[i].res, supplies[i].mv, true);
+
+			printf("SWEET MPSS: %u: the radio's supply %s at %u mV: %s (%d)\n", step, supplies[i].res, supplies[i].mv,
+			    pe == 0 ? "on" : "FAILED", pe);
+			if (pe != 0) {
+				return false;
+			}
+			sleep_ms(1);
+		}
+		/* the second clock of mainline's wifi node: "qdss", which qcom_aoss turns on with a message to the AOP */
+		if (power) {
+			bool qdss = mailbox_send("{class: clock, res: qdss, val: 1}");
+
+			printf("SWEET MPSS: %u: the always-on processor %s \"qdss on\"\n", step, qdss ? "has taken" : "DID NOT TAKE");
+		}
+	}
+
+	at = 7;
+	tlv_u8(m, &at, 0x10, 1);                                /* fw ready */
+	tlv_u8(m, &at, 0x13, 1);                                /* MSA ready */
+	tlv_u8(m, &at, 0x14, 1);                                /* pin connect result */
+	tlv_u32(m, &at, 0x15, WLFW_CLIENT_ID);
+	e = wlfw_call(WLFW_IND_REGISTER, m, at, 5000, &result, &error);
+	v = e == 0 ? qmi_tlv(wlfw.answer, wlfw.length, 0x10, &size) : NULL;
+	printf("SWEET MPSS: %u: indications registered: errno %d, result %u, error %u; firmware status %#llx\n", step, e, result,
+	    error, v != NULL && size >= 8 ? (uint64_t)le32(v) | (uint64_t)le32(v + 4) << 32 : 0ull);
+	if (e != 0 || result != 0) {
+		return false;
+	}
+
+	at = 7;
+	tlv_u32(m, &at, 0x10, 0);                               /* daemon support: none */
+	e = wlfw_call(WLFW_HOST_CAP, m, at, 5000, &result, &error);
+	if (e == 0 && result != 0 && error != 0x5e) {           /* QMI_ERR_NOT_SUPPORTED: older firmware */
+		at = 7;
+		tlv_u8(m, &at, 0x10, 0);                        /* the 8-bit form (ath10k's host-cap quirk) */
+		e = wlfw_call(WLFW_HOST_CAP, m, at, 5000, &result, &error);
+	}
+	printf("SWEET MPSS: %u: host capabilities: errno %d, result %u, error %u\n", step, e, result, error);
+	if (e != 0) {
+		return false;
+	}
+
+	at = 7;
+	{
+		uint8_t pa[8];
+
+		for (unsigned b = 0; b < 8; b++) {
+			pa[b] = (uint8_t)(WLFW_MSA_PA >> (8 * b));
+		}
+		tlv_put(m, &at, 0x01, pa, 8);
+	}
+	tlv_u32(m, &at, 0x02, WLFW_MSA_SIZE);
+	e = wlfw_call(WLFW_MSA_INFO, m, at, 5000, &result, &error);
+	v = e == 0 && result == 0 ? qmi_tlv(wlfw.answer, wlfw.length, 0x03, &size) : NULL;
+	printf("SWEET MPSS: %u: MSA %#llx + %#x: errno %d, result %u, error %u, %u regions\n", step, WLFW_MSA_PA, WLFW_MSA_SIZE,
+	    e, result, error, v != NULL && size >= 1 ? v[0] : 0);
+	if (v == NULL || size < 1 || v[0] > 2 || size < 1u + 13u * v[0]) {
+		return false;
+	}
+	for (unsigned r = 0, n = v[0]; r < n; r++) {
+		const uint8_t *region = v + 1 + 13 * r;
+		uint64_t pa = (uint64_t)le32(region) | (uint64_t)le32(region + 4) << 32;
+		uint32_t bytes = le32(region + 8);
+
+		printf("SWEET MPSS: %u:   region %u: %#llx + %#x, %s\n", step, r, pa, bytes, region[12] ? "secure" : "not secure");
+		if (pa < WLFW_MSA_PA || bytes > WLFW_MSA_SIZE || pa + bytes > WLFW_MSA_PA + WLFW_MSA_SIZE) {
+			printf("SWEET MPSS: %u: OUTSIDE THE MSA: not given\n", step);
+			return false;
+		}
+		/* ath10k waits a little between the answer and the XPU change (SDM845 crashed without) */
+		sleep_ms(20);
+		if (!wlfw_assign(pa, bytes, region[12] != 0)) {
+			return false;
+		}
+	}
+
+	at = 7;
+	e = wlfw_call(WLFW_MSA_READY, m, at, 5000, &result, &error);
+	printf("SWEET MPSS: %u: MSA ready: errno %d, result %u, error %u\n", step, e, result, error);
+	if (e != 0 || result != 0) {
+		return false;
+	}
+
+	at = 7;
+	e = wlfw_call(WLFW_CAP, m, at, 5000, &result, &error);
+	if (e == 0 && result == 0) {
+		uint32_t chip = 0, family = 0, soc = 0, fw = 0;
+		char build[130] = "";
+
+		if ((v = qmi_tlv(wlfw.answer, wlfw.length, 0x10, &size)) != NULL && size >= 8) {
+			chip = le32(v);
+			family = le32(v + 4);
+		}
+		if ((v = qmi_tlv(wlfw.answer, wlfw.length, 0x11, &size)) != NULL && size >= 4) {
+			board_id = le32(v);
+		}
+		if ((v = qmi_tlv(wlfw.answer, wlfw.length, 0x12, &size)) != NULL && size >= 4) {
+			soc = le32(v);
+		}
+		if ((v = qmi_tlv(wlfw.answer, wlfw.length, 0x13, &size)) != NULL && size >= 4) {
+			fw = le32(v);
+		}
+		if ((v = qmi_tlv(wlfw.answer, wlfw.length, 0x14, &size)) != NULL) {
+			memcpy(build, v, MIN((size_t)size, sizeof(build) - 1));
+		}
+		printf("SWEET MPSS: %u: THE WI-FI FIRMWARE: chip %#x family %#x board %#x SoC %#x, firmware %#x, build \"%s\"\n", step,
+		    chip, family, board_id, soc, fw, build);
+	} else {
+		printf("SWEET MPSS: %u: capabilities: errno %d, result %u, error %u\n", step, e, result, error);
+		return false;
+	}
+
+	for (unsigned ms = 0; ms < 5000 && !wlfw.msa_ready; ms++) {
+		sleep_ms(1);
+	}
+	printf("SWEET MPSS: %u: MSA-ready indication: %s\n", step, wlfw.msa_ready ? "came" : "NOT IN 5 s (going on)");
+	if (!wlfw_board_data(board_id)) {
+		return false;
+	}
+	at = 7;
+	tlv_u8(m, &at, 0x01, 0);                                /* no calibration data of ours */
+	e = wlfw_call(WLFW_CAL_REPORT, m, at, 5000, &result, &error);
+	printf("SWEET MPSS: %u: calibration report: errno %d, result %u, error %u\n", step, e, result, error);
+	if (e != 0 || result != 0) {
+		return false;
+	}
+	for (unsigned ms = 0; ms < 15000 && !wlfw.fw_ready; ms++) {
+		sleep_ms(1);
+	}
+	printf("SWEET MPSS: %u: %s (%u indications in all)\n", step, wlfw.fw_ready ? "THE WI-FI FIRMWARE IS READY" :
+	    "no \"fw ready\" within 15 s", wlfw.indications);
+	return wlfw.fw_ready;
+}
+
+/*
+ * ---- step 10: the radio's configuration and mode, as ath10k/snoc.c's ath10k_snoc_wlan_enable() ---------
+ *
+ * The firmware is told the copy engines (CE) as the host will use them: the target's pipe table, the HTC
+ * services' pipes, and the shadow registers of the write indices (ath10k snoc.c target_ce_config_wlan,
+ * target_service_to_ce_map_wlan, target_shadow_reg_cfg_map, unchanged), then the mode MISSION. After that, the
+ * radio's registers (membase 0x18800000, dt qcom,icnss) are there: a few of the copy engines' are read
+ * (sweetwlanread=0: not). Nothing is written to them: the rings in host memory, behind the SMMU, are the next step.
+ */
+
+#define WLFW_WLAN_MODE          0x0022
+#define WLFW_WLAN_CFG           0x0023
+#define WLAN_MEMBASE            0x18800000u
+#define WLAN_CE0                0x240000u       /* ath10k hw.c wcn3990_regs: CE n at 0x240000 + 0x1000 n */
+#define WLAN_CE_WRAPPER         0x24c000u
+
+static bool wlan_smmu_open;                     /* the SMMU step let the radio's stream through */
+
+/* The copy engines' registers (CE0 .. CE11 and the wrapper), mapped once: ml_io_map() may not be unmapped. */
+static volatile uint32_t *
+wlan_ce_map(void)
+{
+	static volatile uint32_t *map;
+
+	if (map == NULL) {
+		map = (volatile uint32_t *)ml_io_map(WLAN_MEMBASE + WLAN_CE0, WLAN_CE_WRAPPER - WLAN_CE0 + 0x1000);
+	}
+	return map;
+}
+
+static const uint32_t wlan_ce_pipes[12][5] = {  /* pipe, direction (1 in, 2 out, 3 both), entries, bytes, flags */
+	{ 0, 2, 32, 2048, 0 }, { 1, 1, 32, 2048, 0 }, { 2, 1, 64, 2048, 0 }, { 3, 2, 32, 2048, 0 },
+	{ 4, 2, 256, 256, 8 }, { 5, 2, 1024, 64, 8 }, { 6, 3, 32, 16384, 0 }, { 7, 4, 0, 0, 8 },
+	{ 8, 1, 32, 2048, 0 }, { 9, 1, 32, 2048, 0 }, { 10, 1, 32, 2048, 0 }, { 11, 1, 32, 2048, 0 },
+};
+static const uint32_t wlan_ce_services[21][3] = {       /* HTC service, direction, pipe; the zero row is sent too */
+	{ 0x104, 2, 3 }, { 0x104, 1, 2 }, { 0x102, 2, 3 }, { 0x102, 1, 2 }, { 0x101, 2, 3 }, { 0x101, 1, 2 },
+	{ 0x103, 2, 3 }, { 0x103, 1, 2 }, { 0x100, 2, 3 }, { 0x100, 1, 2 }, { 0x001, 2, 0 }, { 0x001, 1, 2 },
+	{ 0xfe00, 2, 0 }, { 0xfe00, 1, 2 }, { 0x300, 2, 4 }, { 0x300, 1, 1 }, { 0xfe00, 2, 5 }, { 0x301, 1, 9 },
+	{ 0x302, 1, 10 }, { 0x600, 1, 11 }, { 0, 0, 0 },
+};
+static const uint16_t wlan_shadow[12][2] = {    /* CE, register (0x3c source write index, 0x40 destination) */
+	{ 0, 0x3c }, { 3, 0x3c }, { 4, 0x3c }, { 5, 0x3c }, { 7, 0x3c }, { 1, 0x40 },
+	{ 2, 0x40 }, { 7, 0x40 }, { 8, 0x40 }, { 9, 0x40 }, { 10, 0x40 }, { 11, 0x40 },
+};
+
+static void
+put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+	p[2] = (uint8_t)(v >> 16);
+	p[3] = (uint8_t)(v >> 24);
+}
+
+static bool
+step_wlan(void)
+{
+	uint8_t *m;
+	uint32_t at = 7, n, read;
+	/*
+	 * ios-mpss16: with the radio's stream faulting in the SMMU even ctrl1 right after MISSION stalled once: the
+	 * registers are read by default only once the SMMU step has let the stream through.
+	 */
+	read = wlan_smmu_open ? 1 : 0;
+	uint16_t result = 0, error = 0;
+	int e;
+
+	if (!wlfw.fw_ready || wlfw_port == NULL) {
+		return false;
+	}
+	announce("tell the Wi-Fi firmware the copy engines (pipes, services, shadow registers) and put it in MISSION mode");
+	sleep_ms(3000);                                         /* the log reaches the storage first (see below) */
+	m = kalloc_data(1024, Z_WAITOK | Z_ZERO);
+	if (m == NULL) {
+		return false;
+	}
+	n = sizeof(wlan_ce_pipes) / sizeof(wlan_ce_pipes[0]);
+	m[at] = 0x11;
+	m[at + 1] = (uint8_t)(1 + 20 * n);
+	m[at + 2] = (uint8_t)((1 + 20 * n) >> 8);
+	m[at + 3] = (uint8_t)n;
+	at += 4;
+	for (uint32_t i = 0; i < n; i++, at += 20) {
+		for (unsigned w = 0; w < 5; w++) {
+			put32(m + at + 4 * w, wlan_ce_pipes[i][w]);
+		}
+	}
+	n = sizeof(wlan_ce_services) / sizeof(wlan_ce_services[0]);
+	m[at] = 0x12;
+	m[at + 1] = (uint8_t)(1 + 12 * n);
+	m[at + 2] = (uint8_t)((1 + 12 * n) >> 8);
+	m[at + 3] = (uint8_t)n;
+	at += 4;
+	for (uint32_t i = 0; i < n; i++, at += 12) {
+		for (unsigned w = 0; w < 3; w++) {
+			put32(m + at + 4 * w, wlan_ce_services[i][w]);
+		}
+	}
+	n = sizeof(wlan_shadow) / sizeof(wlan_shadow[0]);
+	m[at] = 0x13;
+	m[at + 1] = (uint8_t)(1 + 4 * n);
+	m[at + 2] = (uint8_t)((1 + 4 * n) >> 8);
+	m[at + 3] = (uint8_t)n;
+	at += 4;
+	for (uint32_t i = 0; i < n; i++, at += 4) {
+		m[at] = (uint8_t)wlan_shadow[i][0];
+		m[at + 1] = (uint8_t)(wlan_shadow[i][0] >> 8);
+		m[at + 2] = (uint8_t)wlan_shadow[i][1];
+		m[at + 3] = (uint8_t)(wlan_shadow[i][1] >> 8);
+	}
+	e = wlfw_call(WLFW_WLAN_CFG, m, at, 5000, &result, &error);
+	printf("SWEET MPSS: %u: the copy engines (%u bytes): errno %d, result %u, error %u\n", step, at - 7, e, result, error);
+	if (e != 0 || result != 0) {
+		kfree_data(m, 1024);
+		return false;
+	}
+	/*
+	 * ios-mpss13: the phone panicked within the last two seconds of the log after the calibration report - the
+	 * log goes to the storage every two seconds, so what came after was lost. Each access that may end the
+	 * kernel is now announced and waited 3 s for, so that the log says which one it was.
+	 */
+	/*
+	 * ios-mpss14 (3 s between all of this): the wrapper and all of CE0 read, then the core stalled for good on
+	 * CE1 - no panic, the read never came back, ~9 s after MISSION. Linux reads ctrl1 (0x18) of all twelve
+	 * right after the mode (ath10k_ce_alloc_rri). So now: ctrl1 of all twelve at once after the mode, as Linux;
+	 * then, 3 s later, CE1's ctrl1 again (does the block go to sleep when the host is idle?); then, 3 s later,
+	 * CE1's source-ring base (CE1 has no source ring: is that the register that stalls?).
+	 */
+	PE_parse_boot_argn("sweetwlanread", &read, sizeof(read));
+	printf("SWEET MPSS: %u: the copy engines are taken; in 3 s MISSION mode, then %s\n", step,
+	    read ? "at once ctrl1 (0x18) of the twelve copy engines, as ath10k" : "no register read (sweetwlanread=0)");
+	sleep_ms(3000);
+	volatile uint32_t *ce = NULL;
+	if (read) {
+		ce = wlan_ce_map();
+		if (ce == NULL) {
+			kfree_data(m, 1024);
+			return false;
+		}
+	}
+	at = 7;
+	tlv_u32(m, &at, 0x01, 0);                               /* QMI_WLFW_MISSION_V01 */
+	e = wlfw_call(WLFW_WLAN_MODE, m, at, 5000, &result, &error);
+	kfree_data(m, 1024);
+	if (e == 0 && result == 0 && ce != NULL) {
+		uint32_t ctrl1[12];
+
+		for (unsigned c = 0; c < 12; c++) {
+			ctrl1[c] = ce[(c * 0x1000 + 0x18) / 4];
+		}
+		printf("SWEET MPSS: %u: mode MISSION taken; ctrl1 at once: %#x %#x %#x %#x %#x %#x %#x %#x %#x %#x %#x %#x\n", step,
+		    ctrl1[0], ctrl1[1], ctrl1[2], ctrl1[3], ctrl1[4], ctrl1[5], ctrl1[6], ctrl1[7], ctrl1[8], ctrl1[9], ctrl1[10],
+		    ctrl1[11]);
+	}
+	printf("SWEET MPSS: %u: mode MISSION: errno %d, result %u, error %u\n", step, e, result, error);
+	if (e != 0 || result != 0) {
+		return false;
+	}
+	/*
+	 * ios-mpss15: ctrl1 of all twelve read at once and CE1's again 3 s later (the block does not go to sleep);
+	 * CE1's source-ring base stalled the core for good. A copy engine's ring registers are there only for the
+	 * directions it has (ath10k touches only those): source registers for CE0, 3, 4, 7, destination registers
+	 * for CE1, 2, 5, 7, 8, 9, 10, 11 (host_ce_config_wlan); ctrl1, host IE and misc IE for all.
+	 */
+	if (ce != NULL) {
+		static const uint16_t has_src = 0x099, has_dst = 0xfa6;     /* bit n: CE n */
+
+		for (unsigned c = 0; c < 12; c++) {
+			volatile uint32_t *r = ce + c * 0x1000 / 4;
+			char line[160];
+			int at2 = snprintf(line, sizeof(line), "ctrl1 %#x ie %#x misc %#x", r[0x18 / 4], r[0x2c / 4], r[0x34 / 4]);
+
+			if (has_src & (1u << c)) {
+				at2 += snprintf(line + at2, sizeof(line) - (size_t)at2, ", source ring %#x size %u write %u read %u",
+				    r[0x00 / 4], r[0x08 / 4], r[0x3c / 4], r[0x44 / 4]);
+			}
+			if (has_dst & (1u << c)) {
+				snprintf(line + at2, sizeof(line) - (size_t)at2, ", destination ring %#x size %u write %u read %u",
+				    r[0x0c / 4], r[0x14 / 4], r[0x40 / 4], r[0x48 / 4]);
+			}
+			printf("SWEET MPSS: %u:   CE%u: %s\n", step, c, line);
+		}
+	}
+	printf("SWEET MPSS: %u: THE RADIO IS IN MISSION MODE\n", step);
+	return true;
+}
+
+/*
+ * ---- step 11: how the boot chain left the SMMU for the radio (read only) ---------------------------------
+ *
+ * The copy engines' rings are in host memory, which the radio reaches through apps-smmu@0x15000000 (dt: qcom,
+ * qsmmu-v500, qcom,skip-init) as stream 0x640 (mask 0x1, dt iommus of qcom,icnss). Before anything is given to
+ * it: the global configuration (sCR0: client port disable, unmatched stream fault), the stream match registers
+ * that take 0x640 or 0x641, what they route to (translate / bypass / fault, context bank) and that bank's state.
+ * Only reads; with no matching entry, unmatched streams go by sCR0.
+ */
+
+#define APPS_SMMU               0x15000000u
+#define APPS_SMMU_SIZE          0x100000u
+#define WLAN_STREAM             0x640u
+#define WLAN_STREAM_MASK        0x1u
+
+static volatile uint32_t *wlan_smmu;            /* apps-smmu's registers */
+static uint32_t wlan_smmu_cb;                   /* byte offset of the bank the radio's stream goes through; 0: none */
+
+static bool
+step_smmu(void)
+{
+	volatile uint32_t *s;
+	uint32_t cr0, idr0, idr1, groups, banks, page, half, found = 0;
+
+	announce("read how the boot chain left the SMMU for the radio's stream 0x640 (apps-smmu@0x15000000; nothing written)");
+	if (wlan_smmu == NULL) {                /* ml_io_map() is permanent: mapped once, never unmapped */
+		wlan_smmu = (volatile uint32_t *)ml_io_map(APPS_SMMU, APPS_SMMU_SIZE);
+	}
+	s = wlan_smmu;
+	if (s == NULL) {
+		return false;
+	}
+	cr0 = s[0x000 / 4];
+	idr0 = s[0x020 / 4];
+	idr1 = s[0x024 / 4];
+	groups = idr0 & 0xff;
+	banks = idr1 & 0xff;
+	page = (idr1 & (1u << 31)) ? 0x10000 : 0x1000;
+	half = page << (((idr1 >> 28) & 7) + 1);                /* NUMPAGENDXB: the global half, then the banks */
+	printf("SWEET MPSS: %u: sCR0 %#x (client port %s, unmatched streams %s), IDR0 %#x (%u stream match groups), IDR1 %#x "
+	    "(%u context banks, pages of %u KiB, banks from %#x)\n", step, cr0, (cr0 & 1) ? "DISABLED" : "on",
+	    (cr0 & (1u << 10)) ? "FAULT" : "bypass", idr0, groups, idr1, banks, page >> 10, half);
+	for (uint32_t g = 0; g < groups && g < 256; g++) {
+		uint32_t smr = s[(0x800 + 4 * g) / 4], id = smr & 0xffff, mask = (smr >> 16) & 0x7fff, s2cr, type, cb;
+
+		if (!(smr & (1u << 31)) || ((id ^ WLAN_STREAM) & ~(mask | WLAN_STREAM_MASK) & 0x7fff) != 0) {
+			continue;
+		}
+		found++;
+		s2cr = s[(0xc00 + 4 * g) / 4];
+		type = (s2cr >> 16) & 3;
+		cb = s2cr & 0xff;
+		printf("SWEET MPSS: %u:   SMR%u %#x (stream %#x mask %#x) -> S2CR %#x: %s", step, g, smr, id, mask, s2cr,
+		    type == 0 ? "TRANSLATE" : type == 1 ? "BYPASS" : "FAULT");
+		if (type == 0 && cb < banks && half + (cb + 1) * page <= APPS_SMMU_SIZE) {
+			volatile uint32_t *b = s + (half + cb * page) / 4;
+
+			printf(", bank %u: CBAR %#x, SCTLR %#x, TCR %#x, TTBR0 %#x%08x, FSR %#x\n", cb, s[(page + 4 * cb) / 4],
+			    b[0x00 / 4], b[0x30 / 4], b[0x24 / 4], b[0x20 / 4], b[0x58 / 4]);
+		} else {
+			printf("\n");
+		}
+	}
+	printf("SWEET MPSS: %u: %u stream match entr%s take the radio's stream\n", step, found, found == 1 ? "y" : "ies");
+
+	/*
+	 * ios-mpss18: no entry takes 0x640, and sCR0 faults unmatched streams - the radio's engines can reach no
+	 * memory at all (after MISSION, reads of its registers stalled now and then). So, as Linux's arm-smmu-qcom
+	 * does for a device it lets through untranslated: in a stream match group nobody uses, the radio's stream
+	 * (0x640, mask 0x1) routed to bypass; where the hypervisor turns a bypass S2CR into a fault (it reads back so),
+	 * routed instead to a context bank nobody uses, made "stage 1 translate, stage 2 bypass" with translation off
+	 * (SCTLR 0: Linux's bypass_cbndx). Only that group and that bank are written; the match register last.
+	 * sweetwlansmmu=0: nothing written.
+	 */
+	uint32_t write = 1, group = groups, bank = banks;
+
+	PE_parse_boot_argn("sweetwlansmmu", &write, sizeof(write));
+	if (found != 0 || !write) {
+		return true;
+	}
+	for (uint32_t g = groups; g-- > 0 && group == groups;) {
+		if (!(s[(0x800 + 4 * g) / 4] & (1u << 31))) {
+			group = g;
+		}
+	}
+	for (uint32_t cb = banks; cb-- > 0 && bank == banks;) {
+		bool used = (s[(half + cb * page) / 4] & 1) != 0;  /* SCTLR.M: translating for someone */
+
+		for (uint32_t g = 0; g < groups && !used; g++) {
+			uint32_t s2cr = s[(0xc00 + 4 * g) / 4];
+
+			used = (s[(0x800 + 4 * g) / 4] & (1u << 31)) && ((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) == cb;
+		}
+		if (!used && s[(page + 4 * cb) / 4] == 0) {
+			bank = cb;
+		}
+	}
+	if (group == groups) {
+		printf("SWEET MPSS: %u: NO FREE STREAM MATCH GROUP: the radio's stream is left as it is\n", step);
+		return false;
+	}
+	s[(0xc00 + 4 * group) / 4] = 1u << 16;                 /* S2CR: bypass */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t s2cr = s[(0xc00 + 4 * group) / 4];
+	bool bypass = ((s2cr >> 16) & 3) == 1;
+
+	printf("SWEET MPSS: %u: group %u S2CR bypass written, reads back %#x: %s\n", step, group, s2cr,
+	    bypass ? "BYPASS TAKEN" : "not taken (the hypervisor's), a context bank with translation off instead");
+	if (!bypass) {
+		if (bank == banks || half + (bank + 1) * page > APPS_SMMU_SIZE) {
+			printf("SWEET MPSS: %u: NO FREE CONTEXT BANK: the radio's stream is left faulting\n", step);
+			s[(0xc00 + 4 * group) / 4] = s2cr;
+			return false;
+		}
+		volatile uint32_t *b = s + (half + bank * page) / 4;
+
+		s[(page + 4 * bank) / 4] = (1u << 16) | (0xfu << 12) | (3u << 8);    /* CBAR: S1 trans S2 bypass, WB, NSH */
+		b[0x00 / 4] = 0;                                /* SCTLR: translation off */
+		wlan_smmu_cb = half + bank * page;
+		s[(0xc00 + 4 * group) / 4] = bank;              /* S2CR: translate through that bank */
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("SWEET MPSS: %u: bank %u: CBAR %#x SCTLR %#x; group %u S2CR %#x\n", step, bank, s[(page + 4 * bank) / 4],
+		    b[0x00 / 4], group, s[(0xc00 + 4 * group) / 4]);
+	}
+	s[(0x800 + 4 * group) / 4] = (1u << 31) | (WLAN_STREAM_MASK << 16) | WLAN_STREAM;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wlan_smmu_open = true;
+	printf("SWEET MPSS: %u: group %u SMR %#x: THE RADIO'S STREAM GOES THROUGH UNTRANSLATED (%s)\n", step, group,
+	    s[(0x800 + 4 * group) / 4], bypass ? "bypass" : "bank with translation off");
+	return true;
+}
+
+/*
+ * ---- step 12: the copy engines' rings, and the Wi-Fi firmware's first HTC message ----------------------
+ *
+ * As ath10k's ath10k_ce_alloc_rri(), ath10k_ce_init_pipe() and ath10k_snoc_rx_post() (wcn3990, 64-bit
+ * descriptors): a page of read indices the engines keep up to date (RRI: its address in the wrapper at
+ * 0x24c004/0x24c008, bit 19 of each engine's ctrl1); the rings of the engines HTC needs - CE0 (host to target,
+ * HTC control: 16), CE1 (target to host, HTT + HTC: 512), CE2 (target to host, WMI and HTC control: 64), CE3 (host
+ * to target, WMI: 32) - each in a page of its own, their base, size, dmax, byte swap off and watermarks written;
+ * then receive buffers of 2048 bytes posted to CE1 and CE2. The radio's stream goes through the SMMU untranslated
+ * (step 10), so the engines are given physical addresses. The firmware then sends HTC READY (ath10k:
+ * ath10k_htc_wait_target) on its own; nothing is sent to it here. The descriptors are polled (no interrupts).
+ */
+
+#define CE_DESC                 16u             /* struct ce_desc_64: u64 addr, u16 nbytes, u16 flags, u32 hash */
+#define CE_RX_BUF               2048u
+#define WLAN_RX_POSTED          24u             /* receive buffers posted to CE1 and to CE2 each */
+
+struct wlan_page {
+	vm_offset_t va;
+	uint64_t pa;
+};
+
+static struct wlan_page wlan_rri, wlan_ring[4], wlan_rx_page[2][(WLAN_RX_POSTED * CE_RX_BUF + 0x3fff) / 0x4000 + 1];
+static uint32_t wlan_rx_write[4], wlan_rx_read[4];
+
+static void
+wlan_flush(vm_offset_t va, size_t length)
+{
+	for (vm_offset_t line = va & ~(vm_offset_t)63; line < va + length; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+wlan_page_get(struct wlan_page *p)
+{
+	if (p->va != 0) {
+		return true;
+	}
+	/*
+	 * ios-mpss20: in pages above 4 GiB (0x11afc8000 ...) CE2 took a buffer (read index 1) but nothing arrived in
+	 * memory, not even the read indices: below 4 GiB now, in case the radio's writes go no higher.
+	 */
+	if (kmem_alloc_contig(kernel_map, &p->va, PAGE_SIZE, 0, (ppnum_t)((0x100000000ull >> PAGE_SHIFT) - 1), 0,
+	    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		p->va = 0;
+		printf("SWEET MPSS: %u: no page below 4 GiB\n", step);
+		return false;
+	}
+	p->pa = kvtophys(p->va);
+	wlan_flush(p->va, PAGE_SIZE);
+	return p->pa != 0;
+}
+
+/* A receive buffer of CE1 (k 0) or CE2 (k 1): n-th of WLAN_RX_POSTED, physical and virtual. */
+static uint64_t
+wlan_rx_buffer(unsigned k, uint32_t n, vm_offset_t *va)
+{
+	uint32_t per_page = PAGE_SIZE / CE_RX_BUF;
+	struct wlan_page *p = &wlan_rx_page[k][n / per_page];
+
+	*va = p->va + (n % per_page) * CE_RX_BUF;
+	return p->pa + (n % per_page) * CE_RX_BUF;
+}
+
+static void
+wlan_ring_src(volatile uint32_t *ce, unsigned c, struct wlan_page *ring, uint32_t entries, uint32_t dmax)
+{
+	volatile uint32_t *r = ce + c * 0x1000 / 4;
+
+	r[0x00 / 4] = (uint32_t)ring->pa;
+	r[0x04 / 4] = (uint32_t)(ring->pa >> 32) & 0x1f;
+	r[0x08 / 4] = entries;
+	r[0x18 / 4] = (r[0x18 / 4] & ~0xffffu & ~(1u << 17)) | dmax;    /* dmax, source byte swap off */
+	r[0x4c / 4] = (0u << 16) | entries;                              /* low watermark 0, high = entries */
+}
+
+static void
+wlan_ring_dst(volatile uint32_t *ce, unsigned c, struct wlan_page *ring, uint32_t entries)
+{
+	volatile uint32_t *r = ce + c * 0x1000 / 4;
+
+	r[0x0c / 4] = (uint32_t)ring->pa;
+	r[0x10 / 4] = (uint32_t)(ring->pa >> 32) & 0x1f;
+	r[0x14 / 4] = entries;
+	r[0x18 / 4] = r[0x18 / 4] & ~(1u << 18);                         /* destination byte swap off */
+	r[0x50 / 4] = (0u << 16) | entries;
+}
+
+/* Receive buffers into CE c's ring (k: their pool), from its write index on; the write index written last. */
+static void
+wlan_rx_post(volatile uint32_t *ce, unsigned c, unsigned k, uint32_t entries, uint32_t count)
+{
+	volatile uint32_t *r = ce + c * 0x1000 / 4;
+	uint8_t *ring = (uint8_t *)wlan_ring[c].va;
+	uint32_t write = r[0x40 / 4] & (entries - 1);
+
+	wlan_rx_read[c] = write;
+	for (uint32_t n = 0; n < count; n++) {
+		vm_offset_t va;
+		uint64_t pa = wlan_rx_buffer(k, n, &va);
+		uint8_t *d = ring + ((write + n) & (entries - 1)) * CE_DESC;
+
+		bzero((void *)va, CE_RX_BUF);
+		wlan_flush(va, CE_RX_BUF);
+		for (unsigned b = 0; b < 8; b++) {
+			d[b] = (uint8_t)(pa >> (8 * b));
+		}
+		d[8] = d[9] = 0;                                /* nbytes 0: the engine fills it */
+	}
+	wlan_flush(wlan_ring[c].va, entries * CE_DESC);
+	wlan_rx_write[c] = (write + count) & (entries - 1);
+	r[0x40 / 4] = wlan_rx_write[c];
+}
+
+static void
+wlan_htc_show(unsigned c, const uint8_t *b, uint32_t n)
+{
+	char hex[3 * 32 + 1];
+	uint32_t shown = n < 32 ? n : 32;
+
+	for (uint32_t i = 0; i < shown; i++) {
+		snprintf(hex + 3 * i, sizeof(hex) - 3 * i, " %02x", b[i]);
+	}
+	hex[3 * shown] = 0;
+	printf("SWEET MPSS: %u: CE%u: %u bytes:%s\n", step, c, n, hex);
+	if (n >= 10) {
+		uint16_t length = (uint16_t)(b[2] | b[3] << 8), id = (uint16_t)(b[8] | b[9] << 8);
+
+		printf("SWEET MPSS: %u:   HTC endpoint %u flags %#x length %u trailer %u seq %u; message %u%s\n", step, b[0], b[1],
+		    length, b[4], b[5], id, b[0] == 0 && id == 1 ? " = READY" : "");
+		if (b[0] == 0 && id == 1 && n >= 16) {
+			printf("SWEET MPSS: %u: HTC READY: %u credits of %u bytes, %u endpoints\n", step, b[10] | b[11] << 8,
+			    b[12] | b[13] << 8, b[14]);
+		}
+	}
+}
+
+static bool
+step_htc(void)
+{
+	volatile uint32_t *ce = wlan_ce_map();
+	static const struct {
+		unsigned c;
+		bool src;
+		uint32_t entries;
+	} rings[] = { { 0, true, 16 }, { 1, false, 512 }, { 2, false, 64 }, { 3, true, 32 } };
+	unsigned seen = 0;
+	bool ready = false;
+
+	if (ce == NULL || !wlan_smmu_open || PAGE_SIZE < 0x4000) {     /* the pools are sized for 16 KiB pages */
+		printf("SWEET MPSS: %u: the radio's stream is not let through the SMMU: no rings\n", step);
+		return false;
+	}
+	announce("give the copy engines their rings (CE0 16, CE1 512, CE2 64, CE3 32) and the read-index page, post receive "
+	    "buffers to CE1 and CE2, and wait 10 s for the Wi-Fi firmware's HTC READY");
+	if (!wlan_page_get(&wlan_rri)) {
+		return false;
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		if (!wlan_page_get(&wlan_ring[rings[i].c])) {
+			return false;
+		}
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		for (unsigned p = 0; p * (PAGE_SIZE / CE_RX_BUF) < WLAN_RX_POSTED; p++) {
+			if (!wlan_page_get(&wlan_rx_page[k][p])) {
+				return false;
+			}
+		}
+	}
+	/* ath10k_ce_alloc_rri: the page's address, then "update the read index in memory" in every engine */
+	ce[(WLAN_CE_WRAPPER - WLAN_CE0 + 4) / 4] = (uint32_t)wlan_rri.pa;
+	ce[(WLAN_CE_WRAPPER - WLAN_CE0 + 8) / 4] = (uint32_t)(wlan_rri.pa >> 32) & 0x1f;
+	for (unsigned c = 0; c < 12; c++) {
+		ce[(c * 0x1000 + 0x18) / 4] |= 1u << 19;
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		if (rings[i].src) {
+			wlan_ring_src(ce, rings[i].c, &wlan_ring[rings[i].c], rings[i].entries, 2048);
+		} else {
+			wlan_ring_dst(ce, rings[i].c, &wlan_ring[rings[i].c], rings[i].entries);
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wlan_rx_post(ce, 1, 0, 512, WLAN_RX_POSTED);
+	wlan_rx_post(ce, 2, 1, 64, WLAN_RX_POSTED);
+	for (unsigned i = 0; i < 4; i++) {
+		volatile uint32_t *r = ce + rings[i].c * 0x1000 / 4;
+
+		if (rings[i].src) {
+			printf("SWEET MPSS: %u: CE%u source ring %#x%08x size %u ctrl1 %#x write %u read %u\n", step, rings[i].c,
+			    r[0x04 / 4], r[0x00 / 4], r[0x08 / 4], r[0x18 / 4], r[0x3c / 4], r[0x44 / 4]);
+		} else {
+			printf("SWEET MPSS: %u: CE%u destination ring %#x%08x size %u ctrl1 %#x write %u read %u\n", step, rings[i].c,
+			    r[0x10 / 4], r[0x0c / 4], r[0x14 / 4], r[0x18 / 4], r[0x40 / 4], r[0x48 / 4]);
+		}
+	}
+	printf("SWEET MPSS: %u: read-index page %#llx; waiting for the firmware\n", step, wlan_rri.pa);
+
+	for (unsigned ms = 0; ms < 10000 && seen < 8; ms++) {
+		for (unsigned c = 1; c <= 2 && seen < 8; c++) {
+			uint32_t entries = c == 1 ? 512 : 64;
+			uint8_t *d = (uint8_t *)wlan_ring[c].va + wlan_rx_read[c] * CE_DESC;
+			uint16_t nbytes;
+
+			wlan_flush((vm_offset_t)d, CE_DESC);
+			nbytes = (uint16_t)(d[8] | d[9] << 8);
+			if (nbytes == 0) {
+				continue;
+			}
+			uint64_t pa = 0;
+			for (unsigned b = 0; b < 8; b++) {
+				pa |= (uint64_t)d[b] << (8 * b);
+			}
+			/* the buffer is ours by its physical address: find it in the pool */
+			for (uint32_t n = 0; n < WLAN_RX_POSTED; n++) {
+				vm_offset_t va;
+
+				if ((wlan_rx_buffer(c - 1, n, &va) & 0x7ffffffffull) == (pa & 0x7ffffffffull)) {
+					wlan_flush(va, CE_RX_BUF);
+					wlan_htc_show(c, (const uint8_t *)va, nbytes);
+					ready |= ((const uint8_t *)va)[0] == 0 && nbytes >= 10 &&
+					    (((const uint8_t *)va)[8] | ((const uint8_t *)va)[9] << 8) == 1;
+					break;
+				}
+			}
+			seen++;
+			d[8] = d[9] = 0;
+			wlan_flush((vm_offset_t)d, CE_DESC);
+			wlan_rx_read[c] = (wlan_rx_read[c] + 1) & (entries - 1);
+		}
+		if ((ms % 2000) == 0) {
+			volatile uint32_t *rri = (volatile uint32_t *)wlan_rri.va;
+
+			wlan_flush(wlan_rri.va, 64);
+			printf("SWEET MPSS: %u: %u ms: read indices in memory %#x %#x %#x %#x; CE1 DR read %u, CE2 DR read %u; "
+			    "host IS %#x %#x, misc IS %#x %#x\n", step, ms, rri[0], rri[1], rri[2], rri[3], ce[(0x1000 + 0x48) / 4],
+			    ce[(0x2000 + 0x48) / 4], ce[(0x1000 + 0x30) / 4], ce[(0x2000 + 0x30) / 4], ce[(0x1000 + 0x38) / 4],
+			    ce[(0x2000 + 0x38) / 4]);
+			if (wlan_smmu != NULL && wlan_smmu_cb != 0) {
+				volatile uint32_t *b = wlan_smmu + wlan_smmu_cb / 4;
+
+				printf("SWEET MPSS: %u:   SMMU: sGFSR %#x; the radio's bank FSR %#x FAR %#x%08x FSYNR0 %#x\n", step,
+				    wlan_smmu[0x48 / 4], b[0x58 / 4], b[0x64 / 4], b[0x60 / 4], b[0x68 / 4]);
+			}
+		}
+		sleep_ms(1);
+	}
+	printf("SWEET MPSS: %u: %u messages from the firmware; %s\n", step, seen, ready ? "HTC READY CAME" : "no HTC READY");
+	return ready;
+}
+
+/*
+ * ---- step 13: HTC services connected, and the Wi-Fi firmware's first WMI events ------------------------
+ *
+ * As ath10k_core_start() after HTC READY: the WMI control service connected (ath10k_wmi_connect: all the target's
+ * credits to it, credit flow on), then HTT data (credit flow off), then HTC SETUP COMPLETE EX
+ * (ath10k_htc_start); then the firmware sends WMI SERVICE READY on the WMI endpoint. HTC messages to the target
+ * go on CE0 (RSVD_CTRL) in a source descriptor - address, length, the endpoint in the meta data - and the write
+ * index through CE0's shadow register (membase + 0x32000, ath10k ce.c shadow_sr_wr_ind_addr). Received buffers
+ * are given back to their ring as they are read.
+ */
+
+#define WLAN_SHADOW             0x32000u        /* membase + this: the shadow write-index registers */
+#define HTC_HDR                 8u
+
+static struct wlan_page wlan_tx;                /* messages to the target, CE_RX_BUF bytes each */
+static uint8_t wlan_svc_rdy[1024];              /* WMI SERVICE READY as it came (HTC header included) */
+static uint32_t wlan_svc_rdy_len;
+static uint8_t wlan_wmi_eid;
+static uint32_t wlan_tx_write[4], wlan_tx_slot;
+static uint8_t wlan_htc_seq[8];
+static uint32_t wlan_credits[8];                /* HTC send credits per endpoint (only WMI's are counted) */
+
+static volatile uint32_t *
+wlan_shadow_map(void)
+{
+	static volatile uint32_t *map;
+
+	if (map == NULL) {
+		map = (volatile uint32_t *)ml_io_map(WLAN_MEMBASE + WLAN_SHADOW, 0x1000);
+	}
+	return map;
+}
+
+/* An HTC message to endpoint eid on source ring c (CE0: 16 entries); false if the ring is full. */
+static bool
+wlan_htc_send(volatile uint32_t *ce, unsigned c, uint32_t entries, uint8_t eid, const void *payload, uint16_t length)
+{
+	volatile uint32_t *shadow = wlan_shadow_map();
+	volatile uint32_t *rri = (volatile uint32_t *)wlan_rri.va;
+	uint32_t slot = wlan_tx_slot++ % (PAGE_SIZE / CE_RX_BUF), read, write = wlan_tx_write[c];
+	uint8_t *m = (uint8_t *)wlan_tx.va + slot * CE_RX_BUF, *d;
+	uint64_t pa = wlan_tx.pa + slot * CE_RX_BUF;
+
+	wlan_flush(wlan_rri.va, 64);
+	read = rri[c] & 0xffff;
+	if (shadow == NULL || ((write + 1) & (entries - 1)) == (read & (entries - 1)) || HTC_HDR + length > CE_RX_BUF) {
+		return false;
+	}
+	bzero(m, HTC_HDR);
+	m[0] = eid;
+	m[2] = (uint8_t)length;
+	m[3] = (uint8_t)(length >> 8);
+	m[5] = wlan_htc_seq[eid & 7]++;
+	memcpy(m + HTC_HDR, payload, length);
+	wlan_flush((vm_offset_t)m, HTC_HDR + length);
+	d = (uint8_t *)wlan_ring[c].va + write * CE_DESC;
+	for (unsigned b = 0; b < 4; b++) {
+		d[b] = (uint8_t)(pa >> (8 * b));
+	}
+	d[4] = (uint8_t)((pa >> 32) & 0x1f);
+	d[5] = d[6] = d[7] = 0;
+	d[8] = (uint8_t)(HTC_HDR + length);
+	d[9] = (uint8_t)((HTC_HDR + length) >> 8);
+	d[10] = (uint8_t)(eid << 4);                    /* meta data (the endpoint), bits 15:4 */
+	d[11] = (uint8_t)(eid >> 4);
+	d[12] = d[13] = d[14] = d[15] = 0;
+	wlan_flush((vm_offset_t)d, CE_DESC);
+	wlan_tx_write[c] = (write + 1) & (entries - 1);
+	shadow[(c * 4) / 4] = wlan_tx_write[c];         /* CE0 0x32000, CE3 0x3200c: 4 bytes per engine */
+	(void)ce;
+	return true;
+}
+
+/*
+ * The next message on destination ring c, if any: its bytes copied into out (at most size), its length
+ * returned; the buffer given back to the ring at once. 0: nothing.
+ */
+static uint32_t
+wlan_htc_receive(volatile uint32_t *ce, unsigned c, uint32_t entries, uint8_t *out, uint32_t size)
+{
+	uint8_t *d = (uint8_t *)wlan_ring[c].va + wlan_rx_read[c] * CE_DESC, *w;
+	uint16_t nbytes;
+	uint64_t pa = 0;
+	uint32_t got = 0;
+
+	wlan_flush((vm_offset_t)d, CE_DESC);
+	nbytes = (uint16_t)(d[8] | d[9] << 8);
+	if (nbytes == 0) {
+		return 0;
+	}
+	for (unsigned b = 0; b < 8; b++) {
+		pa |= (uint64_t)d[b] << (8 * b);
+	}
+	pa &= 0x7ffffffffull;
+	for (uint32_t n = 0; n < WLAN_RX_POSTED; n++) {
+		vm_offset_t va;
+
+		if (wlan_rx_buffer(c - 1, n, &va) == pa) {
+			const uint8_t *h = (const uint8_t *)va;
+
+			got = nbytes < size ? nbytes : size;
+			wlan_flush(va, CE_RX_BUF);
+			memcpy(out, (const void *)va, got);
+			/*
+			 * The credits the target gives back ride in the HTC trailer (flag 0x2, trailer_len at byte 4, the
+			 * last bytes of the payload): records of u8 id, u8 length; id 1 - credit report: (endpoint, credits)
+			 * pairs (ath10k_htc_process_trailer / ath10k_htc_process_credit_report).
+			 */
+			uint32_t plen = (uint32_t)(h[2] | h[3] << 8), tlen = h[4];
+
+			if ((h[1] & 0x2) && tlen != 0 && tlen <= plen && HTC_HDR + plen <= CE_RX_BUF) {
+				for (uint32_t t = HTC_HDR + plen - tlen; t + 2 <= HTC_HDR + plen;) {
+					uint8_t rid = h[t], rlen = h[t + 1];
+
+					if (t + 2 + rlen > HTC_HDR + plen) {
+						break;
+					}
+					for (uint32_t r = 0; rid == 1 && r + 2 <= rlen; r += 2) {
+						wlan_credits[h[t + 2 + r] & 7] += h[t + 3 + r];
+					}
+					t += 2 + rlen;
+				}
+			}
+			bzero((void *)va, CE_RX_BUF);
+			wlan_flush(va, CE_RX_BUF);
+			break;
+		}
+	}
+	d[8] = d[9] = 0;
+	wlan_flush((vm_offset_t)d, CE_DESC);
+	wlan_rx_read[c] = (wlan_rx_read[c] + 1) & (entries - 1);
+	/* the same buffer, back at the write index */
+	w = (uint8_t *)wlan_ring[c].va + wlan_rx_write[c] * CE_DESC;
+	for (unsigned b = 0; b < 8; b++) {
+		w[b] = (uint8_t)(pa >> (8 * b));
+	}
+	w[8] = w[9] = 0;
+	wlan_flush((vm_offset_t)w, CE_DESC);
+	wlan_rx_write[c] = (wlan_rx_write[c] + 1) & (entries - 1);
+	ce[(c * 0x1000 + 0x40) / 4] = wlan_rx_write[c];
+	return got ? got : nbytes;
+}
+
+/* Waits up to ms for an HTC message on CE1 or CE2; its length, the bytes in out; 0 if none came. */
+static uint32_t
+wlan_htc_wait(volatile uint32_t *ce, uint8_t *out, uint32_t size, uint32_t ms, unsigned *from)
+{
+	for (uint32_t t = 0; t <= ms; t++) {
+		for (unsigned c = 2; c >= 1; c--) {
+			uint32_t n = wlan_htc_receive(ce, c, c == 1 ? 512 : 64, out, size);
+
+			if (n != 0) {
+				*from = c;
+				return n;
+			}
+		}
+		sleep_ms(1);
+	}
+	return 0;
+}
+
+static bool
+wlan_htc_connect(volatile uint32_t *ce, uint16_t service, uint16_t flags, uint8_t *eid)
+{
+	uint8_t msg[8] = { 2, 0, (uint8_t)service, (uint8_t)(service >> 8), (uint8_t)flags, (uint8_t)(flags >> 8), 0, 0 };
+	uint8_t in[256];
+	unsigned from = 0;
+
+	if (!wlan_htc_send(ce, 0, 16, 0, msg, sizeof(msg))) {
+		printf("SWEET MPSS: %u: HTC connect %#x: CE0 full\n", step, service);
+		return false;
+	}
+	for (unsigned tries = 0; tries < 8; tries++) {
+		uint32_t n = wlan_htc_wait(ce, in, sizeof(in), 3000, &from);
+
+		if (n == 0) {
+			break;
+		}
+		if (n >= HTC_HDR + 8 && in[0] == 0 && (in[8] | in[9] << 8) == 3) {
+			*eid = in[13];
+			printf("SWEET MPSS: %u: HTC service %#x: status %u, endpoint %u, max message %u bytes\n", step,
+			    in[10] | in[11] << 8, in[12], in[13], in[14] | in[15] << 8);
+			return in[12] == 0;
+		}
+		wlan_htc_show(from, in, n);
+	}
+	printf("SWEET MPSS: %u: HTC service %#x: no answer\n", step, service);
+	return false;
+}
+
+static bool
+step_wmi(void)
+{
+	volatile uint32_t *ce = wlan_ce_map();
+	uint8_t wmi_eid = 0, htt_eid = 0, in[512];
+	uint8_t setup[12] = { 5, 0 };     /* SETUP COMPLETE EX: id, 2 pad, flags 0, bundling 0, 3 pad */
+	unsigned events = 0, from = 0;
+
+	if (ce == NULL || wlan_shadow_map() == NULL || !wlan_page_get(&wlan_tx)) {
+		return false;
+	}
+	announce("connect the HTC services WMI control (all credits) and HTT data, say SETUP COMPLETE, and listen 10 s for "
+	    "the Wi-Fi firmware's WMI events (SERVICE READY)");
+	if (!wlan_htc_connect(ce, 0x100, 2u << 8, &wmi_eid)) {
+		return false;
+	}
+	if (!wlan_htc_connect(ce, 0x300, 1u << 3, &htt_eid)) {
+		return false;
+	}
+	if (!wlan_htc_send(ce, 0, 16, 0, setup, sizeof(setup))) {
+		return false;
+	}
+	wlan_wmi_eid = wmi_eid;
+	wlan_credits[wmi_eid & 7] = 2;                 /* ath10k: all the target's credits (READY: 2) to WMI */
+	printf("SWEET MPSS: %u: SETUP COMPLETE sent; WMI is endpoint %u, HTT %u\n", step, wmi_eid, htt_eid);
+	for (unsigned waited = 0; waited < 10 && events < 6; waited++) {
+		uint32_t n = wlan_htc_wait(ce, in, sizeof(in), 1000, &from);
+
+		if (n == 0) {
+			continue;
+		}
+		events++;
+		if (n >= HTC_HDR + 4 && in[0] == wmi_eid) {
+			uint32_t id = (uint32_t)(in[8] | in[9] << 8 | in[10] << 16 | in[11] << 24);
+
+			/* ids of ath10k wmi-tlv.h enum wmi_tlv_event_id (ios-mpss22: 0x3, 0x1, 0x4009 came) */
+			printf("SWEET MPSS: %u: WMI event %#x (%u bytes)%s\n", step, id & 0xffffff, n - HTC_HDR,
+			    (id & 0xffffff) == 1 ? " = SERVICE READY" : (id & 0xffffff) == 2 ? " = READY" :
+			    (id & 0xffffff) == 3 ? " = SERVICE AVAILABLE" : "");
+			if ((id & 0xffffff) == 1) {
+				wlan_svc_rdy_len = n < sizeof(wlan_svc_rdy) ? n : (uint32_t)sizeof(wlan_svc_rdy);
+				memcpy(wlan_svc_rdy, in, wlan_svc_rdy_len);
+			}
+		}
+		wlan_htc_show(from, in, n);
+	}
+	printf("SWEET MPSS: %u: %u messages after SETUP COMPLETE\n", step, events);
+	return events != 0;
+}
+
+/*
+ * ---- step 14: WMI INIT, and the firmware's READY (with the radio's MAC address) -------------------------
+ *
+ * As ath10k_wmi_tlv_op_gen_init(): the host memory the firmware asked for in SERVICE READY (TLV array of
+ * wlan_host_mem_req: req_id, unit_size, num_unit_info, num_units) given to it in chunks below 4 GiB, and the
+ * INIT command - TLV init_cmd (ABI 1.0 / 53, "QCA_ML"), TLV resource_config with ath10k's values for a
+ * wcn3990 (TARGET_TLV_* and the hw_params of "wcn3990 hw1.0"), the TLV array of host memory chunks - sent on
+ * the WMI endpoint, which goes to the target on CE3 (shadow register 0x3200c). READY (event 2) carries the MAC.
+ */
+
+#define WMI_TLV_INIT            0x1u
+
+static void
+tlv_hdr(uint8_t *p, uint16_t tag, uint16_t len)
+{
+	p[0] = (uint8_t)len;
+	p[1] = (uint8_t)(len >> 8);
+	p[2] = (uint8_t)tag;
+	p[3] = (uint8_t)(tag >> 8);
+}
+
+static bool
+step_init(void)
+{
+	volatile uint32_t *ce = wlan_ce_map();
+	static const uint32_t resource[44] = {
+		4, 33, 0, 0, 2, 66, 16, 7, 7, 100, 100, 100, 40, 1, 4, 4, 4, 8, 0, 0, 0, 0x400, 2, 0, 0, 0, 0, 2, 1056, 2, 1,
+		0x20, 2, 5, 22, 6, 0, 1, 1, 0, 0, 0, 0, 0x200,
+	};
+	struct {
+		uint32_t req_id, size;
+		uint64_t pa;
+	} chunk[8];
+	unsigned chunks = 0, from = 0;
+	uint8_t *m, in[512];
+	uint32_t at, n;
+	bool ready = false;
+
+	if (ce == NULL || wlan_svc_rdy_len < HTC_HDR + 4 || wlan_wmi_eid == 0) {
+		printf("SWEET MPSS: %u: no SERVICE READY to answer\n", step);
+		return false;
+	}
+	announce("give the Wi-Fi firmware the memory it asked for and send WMI INIT (ath10k's resource configuration for a "
+	    "wcn3990); wait for READY and the radio's MAC address");
+	/* SERVICE READY: top-level TLVs after the 4-byte WMI header; the memory requests in an array of structs */
+	for (at = HTC_HDR + 4; at + 4 <= wlan_svc_rdy_len;) {
+		uint16_t len = (uint16_t)(wlan_svc_rdy[at] | wlan_svc_rdy[at + 1] << 8);
+		uint16_t tag = (uint16_t)(wlan_svc_rdy[at + 2] | wlan_svc_rdy[at + 3] << 8);
+		uint32_t end = at + 4 + len;
+
+		if (end > wlan_svc_rdy_len) {
+			break;
+		}
+		if (tag == 0x12) {                              /* WMI_TLV_TAG_ARRAY_STRUCT */
+			for (uint32_t in_at = at + 4; in_at + 4 <= end;) {
+				uint16_t l2 = (uint16_t)(wlan_svc_rdy[in_at] | wlan_svc_rdy[in_at + 1] << 8);
+				uint16_t t2 = (uint16_t)(wlan_svc_rdy[in_at + 2] | wlan_svc_rdy[in_at + 3] << 8);
+				const uint8_t *r = wlan_svc_rdy + in_at + 4;
+
+				if (t2 == 0x22 && l2 >= 16 && chunks < 8) {     /* WLAN_HOST_MEM_REQ */
+					uint32_t id = le32(r), unit = le32(r + 4), info = le32(r + 8), units = le32(r + 12);
+
+					if (info & 6) {                             /* num_units: peers (ath10k: max peers + 1) */
+						units = 33 + 1;
+					} else if (info & 1) {                      /* vdevs */
+						units = 4 + 1;
+					}
+					printf("SWEET MPSS: %u: the firmware asks for memory: request %u, %u units of %u bytes (info %#x)\n",
+					    step, id, units, unit, info);
+					chunk[chunks].req_id = id;
+					chunk[chunks].size = unit * units;
+					chunks++;
+				}
+				in_at += 4 + l2;
+			}
+		}
+		at = end;
+	}
+	for (unsigned i = 0; i < chunks; i++) {
+		vm_offset_t va = 0;
+		vm_size_t size = round_page(chunk[i].size);
+
+		if (chunk[i].size == 0 || chunk[i].size > (8u << 20) ||
+		    kmem_alloc_contig(kernel_map, &va, size, 0, (ppnum_t)((0x100000000ull >> PAGE_SHIFT) - 1), 0,
+		    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("SWEET MPSS: %u: no %u bytes below 4 GiB for request %u\n", step, chunk[i].size, chunk[i].req_id);
+			return false;
+		}
+		wlan_flush(va, size);
+		chunk[i].pa = kvtophys(va);
+		printf("SWEET MPSS: %u:   request %u: %u bytes at %#llx\n", step, chunk[i].req_id, chunk[i].size, chunk[i].pa);
+	}
+	m = kalloc_data(1024, Z_WAITOK | Z_ZERO);
+	if (m == NULL) {
+		return false;
+	}
+	at = 0;
+	put32(m + at, WMI_TLV_INIT);                    /* the WMI header: the command id */
+	at += 4;
+	tlv_hdr(m + at, 0x4a, 28);                      /* INIT_CMD: ABI version, number of chunks */
+	put32(m + at + 4, 0x01000000);
+	put32(m + at + 8, 53);
+	put32(m + at + 12, 0x5f414351);
+	put32(m + at + 16, 0x00004c4d);
+	put32(m + at + 20, 0);
+	put32(m + at + 24, 0);
+	put32(m + at + 28, chunks);
+	at += 4 + 28;
+	tlv_hdr(m + at, 0x4b, sizeof(resource));        /* RESOURCE_CONFIG */
+	for (unsigned i = 0; i < 44; i++) {
+		put32(m + at + 4 + 4 * i, resource[i]);
+	}
+	at += 4 + sizeof(resource);
+	tlv_hdr(m + at, 0x12, (uint16_t)(chunks * 20));     /* ARRAY_STRUCT of WLAN_HOST_MEMORY_CHUNK */
+	at += 4;
+	for (unsigned i = 0; i < chunks; i++, at += 20) {
+		tlv_hdr(m + at, 0x4c, 16);
+		put32(m + at + 4, chunk[i].req_id);
+		put32(m + at + 8, (uint32_t)chunk[i].pa);
+		put32(m + at + 12, chunk[i].size);
+		put32(m + at + 16, (uint32_t)(chunk[i].pa >> 32));
+	}
+	if (!wlan_htc_send(ce, 3, 32, wlan_wmi_eid, m, (uint16_t)at)) {
+		kfree_data(m, 1024);
+		printf("SWEET MPSS: %u: WMI INIT could not be sent (CE3)\n", step);
+		return false;
+	}
+	kfree_data(m, 1024);
+	wlan_credits[wlan_wmi_eid & 7] -= wlan_credits[wlan_wmi_eid & 7] != 0;
+	printf("SWEET MPSS: %u: WMI INIT sent (%u bytes, %u memory chunks)\n", step, at, chunks);
+	for (unsigned waited = 0; waited < 10 && !ready; waited++) {
+		n = wlan_htc_wait(ce, in, sizeof(in), 1000, &from);
+		if (n < HTC_HDR + 4) {
+			continue;
+		}
+		uint32_t id = le32(in + HTC_HDR) & 0xffffff;
+
+		printf("SWEET MPSS: %u: WMI event %#x (%u bytes) on endpoint %u\n", step, id, n - HTC_HDR, in[0]);
+		if (in[0] != wlan_wmi_eid || id != 2) {
+			wlan_htc_show(from, in, n);
+			continue;
+		}
+		for (at = HTC_HDR + 4; at + 4 <= n;) {
+			uint16_t len = (uint16_t)(in[at] | in[at + 1] << 8), tag = (uint16_t)(in[at + 2] | in[at + 3] << 8);
+
+			if (tag == 0x23 && len >= 36 && at + 4 + 36 <= n) {         /* READY_EVENT: abi, mac (8), status */
+				const uint8_t *mac = in + at + 4 + 24;
+
+				printf("SWEET MPSS: %u: THE WI-FI FIRMWARE IS READY: MAC %02x:%02x:%02x:%02x:%02x:%02x, status %u\n",
+				    step, mac[0], mac[1], mac[2], mac[3], mac[4], mac[5], le32(in + at + 4 + 32));
+				ready = true;
+			}
+			at += 4 + len;
+		}
+	}
+	if (!ready) {
+		printf("SWEET MPSS: %u: no READY within 10 s\n", step);
+	}
+	return ready;
+}
+
+/*
+ * ---- step 15: a passive scan, and the beacons the radio hears -----------------------------------------
+ *
+ * The three commands ath10k always relies on before a scan (mac.c: ath10k_regd_update, add_interface,
+ * ath10k_hw_scan; byte layouts from wmi-tlv.c): SCAN CHAN LIST (0x3003: TLV 0x4f count, ARRAY_STRUCT of TLV 0x50
+ * wmi_channel - mhz, center, 0, mode | flags, powers in 0.5 dBm), VDEV CREATE (0x5001: TLV 0x56 vdev 0, STA 2,
+ * subtype 0, MAC), START SCAN (0x3001: TLV 0x4d of 100 bytes with ath10k's defaults, passive (0x31), then the
+ * channels (ARRAY_UINT32 of MHz), no SSIDs, the broadcast BSSID, no IEs). Then SCAN events (0x3001: type, reason,
+ * MHz) and MGMT RX (0x7001: TLV 0x2c channel, snr, rate, phy mode, length, status, rssi[4]; ARRAY_BYTE the frame):
+ * beacons (0x80) and probe responses (0x50), their BSSID and SSID logged once each. The radio only listens.
+ * Each WMI command takes a credit; the target returns them in HTC trailers.
+ */
+
+#define WMI_SCAN_CHAN_LIST      0x3003u
+#define WMI_VDEV_CREATE         0x5001u
+#define WMI_START_SCAN          0x3001u
+#define WMI_EV_SCAN             0x3001u
+#define WMI_EV_MGMT_RX          0x7001u
+
+static const uint16_t wlan_scan_mhz[] = {
+	2412, 2417, 2422, 2427, 2432, 2437, 2442, 2447, 2452, 2457, 2462, 2467, 2472,
+	5180, 5200, 5220, 5240, 5745, 5765, 5785, 5805, 5825,
+};
+static uint8_t wlan_seen[48][6];
+static unsigned wlan_seen_count, wlan_beacons;
+static bool wlan_scan_done;
+
+/* One message from the target: scan events and beacons shown, the rest named. */
+static void
+wlan_wmi_event(const uint8_t *in, uint32_t n)
+{
+	uint32_t id, at;
+	const uint8_t *hdr = NULL, *frame = NULL;
+	uint32_t frame_len = 0;
+
+	if (n < HTC_HDR + 4 || in[0] != wlan_wmi_eid) {
+		return;
+	}
+	id = le32(in + HTC_HDR) & 0xffffff;
+	if (id == 0x4002) {
+		return;                                 /* CHAN INFO, one per channel visited: not shown */
+	}
+	if (id != WMI_EV_SCAN && id != WMI_EV_MGMT_RX) {
+		printf("SWEET MPSS: %u: WMI event %#x (%u bytes)\n", step, id, n - HTC_HDR);
+		return;
+	}
+	for (at = HTC_HDR + 4; at + 4 <= n;) {
+		uint16_t len = (uint16_t)(in[at] | in[at + 1] << 8), tag = (uint16_t)(in[at + 2] | in[at + 3] << 8);
+
+		if (at + 4 + len > n) {
+			break;
+		}
+		if ((tag == 0x24 && len >= 24) || (tag == 0x2c && len >= 0x18)) {
+			hdr = in + at + 4;
+		} else if (tag == 0x11) {
+			frame = in + at + 4;
+			frame_len = len;
+		}
+		at += 4 + len;
+	}
+	if (hdr == NULL) {
+		return;
+	}
+	if (id == WMI_EV_SCAN) {
+		uint32_t type = le32(hdr), reason = le32(hdr + 4);
+
+		printf("SWEET MPSS: %u: scan event %s (%#x), reason %u, %u MHz\n", step, type == 1 ? "STARTED" : type == 2 ?
+		    "COMPLETED" : type == 4 ? "BSS CHANNEL" : type == 8 ? "FOREIGN CHANNEL" : type == 0x40 ? "START FAILED" :
+		    type == 0x100 ? "FOREIGN CHANNEL EXIT" : "other", type, reason, le32(hdr + 8));
+		wlan_scan_done |= type == 2 || type == 0x40;
+		return;
+	}
+	uint32_t channel = le32(hdr), snr = le32(hdr + 4), buf_len = le32(hdr + 0x10);
+
+	if (frame == NULL || buf_len > frame_len) {
+		return;
+	}
+	wlan_beacons++;
+	if (buf_len < 36 || (frame[0] != 0x80 && frame[0] != 0x50)) {
+		return;
+	}
+	const uint8_t *bssid = frame + 16;
+
+	for (unsigned i = 0; i < wlan_seen_count; i++) {
+		if (memcmp(wlan_seen[i], bssid, 6) == 0) {
+			return;
+		}
+	}
+	if (wlan_seen_count < sizeof(wlan_seen) / sizeof(wlan_seen[0])) {
+		memcpy(wlan_seen[wlan_seen_count++], bssid, 6);
+	}
+	char ssid[33] = "";
+	for (uint32_t ie = 36; ie + 2 <= buf_len;) {
+		uint8_t eid = frame[ie], elen = frame[ie + 1];
+
+		if (ie + 2 + elen > buf_len) {
+			break;
+		}
+		if (eid == 0) {
+			uint32_t l = elen < 32 ? elen : 32;
+
+			for (uint32_t k = 0; k < l; k++) {
+				ssid[k] = frame[ie + 2 + k] >= 0x20 && frame[ie + 2 + k] < 0x7f ? (char)frame[ie + 2 + k] : '?';
+			}
+			ssid[l] = 0;
+			break;
+		}
+		ie += 2 + elen;
+	}
+	printf("SWEET MPSS: %u: A NETWORK: \"%s\" bssid %02x:%02x:%02x:%02x:%02x:%02x, channel %u, signal %d dBm (%s)\n", step,
+	    ssid[0] ? ssid : "(hidden)", bssid[0], bssid[1], bssid[2], bssid[3], bssid[4], bssid[5], channel, (int)snr - 95,
+	    frame[0] == 0x80 ? "beacon" : "probe response");
+}
+
+/* A WMI command: waits (handling what comes) for a credit, then sends it on the WMI endpoint through CE3. */
+static bool
+wlan_wmi_send(volatile uint32_t *ce, uint32_t cmd, uint8_t *m, uint32_t length)
+{
+	static uint8_t in[2048];                        /* (not on the kernel stack) */
+	unsigned from = 0;
+
+	put32(m, cmd);
+	for (unsigned waited = 0; wlan_credits[wlan_wmi_eid & 7] == 0 && waited < 3000; waited++) {
+		uint32_t n = wlan_htc_wait(ce, in, sizeof(in), 1, &from);
+
+		if (n != 0) {
+			wlan_wmi_event(in, n);
+		}
+	}
+	if (wlan_credits[wlan_wmi_eid & 7] == 0) {
+		printf("SWEET MPSS: %u: no WMI credit for command %#x within 3 s\n", step, cmd);
+		return false;
+	}
+	if (!wlan_htc_send(ce, 3, 32, wlan_wmi_eid, m, (uint16_t)length)) {
+		printf("SWEET MPSS: %u: command %#x could not be sent (CE3)\n", step, cmd);
+		return false;
+	}
+	wlan_credits[wlan_wmi_eid & 7]--;
+	return true;
+}
+
+static bool
+step_scan(void)
+{
+	volatile uint32_t *ce = wlan_ce_map();
+	const unsigned channels = sizeof(wlan_scan_mhz) / sizeof(wlan_scan_mhz[0]);
+	static uint8_t in[2048];
+	uint8_t *m;
+	uint32_t at;
+	unsigned from = 0;
+
+	if (ce == NULL || wlan_wmi_eid == 0) {
+		return false;
+	}
+	announce("a passive scan: the channel list, a station interface (vdev 0), START SCAN; 20 s of what the radio hears");
+	m = kalloc_data(2048, Z_WAITOK | Z_ZERO);
+	if (m == NULL) {
+		return false;
+	}
+	/* SCAN CHAN LIST */
+	at = 4;
+	tlv_hdr(m + at, 0x4f, 4);
+	put32(m + at + 4, channels);
+	at += 8;
+	tlv_hdr(m + at, 0x12, (uint16_t)(channels * (4 + 0x18)));
+	at += 4;
+	for (unsigned i = 0; i < channels; i++, at += 4 + 0x18) {
+		uint8_t *c = m + at + 4;
+
+		tlv_hdr(m + at, 0x50, 0x18);
+		bzero(c, 0x18);
+		put32(c + 0x00, wlan_scan_mhz[i]);
+		put32(c + 0x04, wlan_scan_mhz[i]);
+		put32(c + 0x0c, wlan_scan_mhz[i] < 5000 ? 0x1941 : 0x1940);     /* 11G / 11A, HT, VHT, HT40+, ad hoc */
+		c[0x11] = c[0x12] = c[0x15] = 0x28;                             /* 20 dBm, in 0.5 dBm */
+	}
+	if (!wlan_wmi_send(ce, WMI_SCAN_CHAN_LIST, m, at)) {
+		kfree_data(m, 2048);
+		return false;
+	}
+	printf("SWEET MPSS: %u: SCAN CHAN LIST sent (%u channels)\n", step, channels);
+	/* VDEV CREATE: a station, with a locally administered address (READY gave none) */
+	bzero(m, 2048);
+	at = 4;
+	tlv_hdr(m + at, 0x56, 0x14);
+	put32(m + at + 4, 0);
+	put32(m + at + 8, 2);
+	put32(m + at + 12, 0);
+	static const uint8_t mac[6] = { 0x02, 0x50, 0x43, 0x4f, 0x01, 0x01 };
+	memcpy(m + at + 16, mac, 6);
+	at += 4 + 0x14;
+	if (!wlan_wmi_send(ce, WMI_VDEV_CREATE, m, at)) {
+		kfree_data(m, 2048);
+		return false;
+	}
+	printf("SWEET MPSS: %u: VDEV CREATE sent (vdev 0, station, 02:50:43:4f:01:01)\n", step);
+	/* START SCAN, passive, on all those channels */
+	bzero(m, 2048);
+	at = 4;
+	tlv_hdr(m + at, 0x4d, 0x64);
+	{
+		uint8_t *s = m + at + 4;
+
+		put32(s + 0x00, 0xa000);                        /* scan id */
+		put32(s + 0x04, 0xa001);                        /* requestor */
+		put32(s + 0x08, 0);                             /* vdev */
+		put32(s + 0x0c, 1);                             /* priority low */
+		put32(s + 0x10, 0x11f);                         /* events: started .. foreign channel exit */
+		put32(s + 0x14, 50);                            /* dwell active */
+		put32(s + 0x18, 150);                           /* dwell passive */
+		put32(s + 0x1c, 50);                            /* min rest */
+		put32(s + 0x20, 500);                           /* max rest */
+		put32(s + 0x30, 20000);                         /* max scan time */
+		put32(s + 0x34, 5);                             /* probe delay */
+		put32(s + 0x38, 0x31);                          /* passive, channel stats, probe requests (TLV inverts) */
+		put32(s + 0x40, channels);
+		put32(s + 0x44, 1);                             /* one BSSID: broadcast */
+		put32(s + 0x50, 3);                             /* probes */
+	}
+	at += 4 + 0x64;
+	tlv_hdr(m + at, 0x10, (uint16_t)(channels * 4));
+	at += 4;
+	for (unsigned i = 0; i < channels; i++, at += 4) {
+		put32(m + at, wlan_scan_mhz[i]);
+	}
+	tlv_hdr(m + at, 0x13, 0);                               /* SSIDs: none */
+	at += 4;
+	tlv_hdr(m + at, 0x13, 8);                               /* BSSIDs: ff:ff:ff:ff:ff:ff */
+	memset(m + at + 4, 0xff, 6);
+	at += 4 + 8;
+	tlv_hdr(m + at, 0x11, 0);                               /* IEs: none */
+	at += 4;
+	if (!wlan_wmi_send(ce, WMI_START_SCAN, m, at)) {
+		kfree_data(m, 2048);
+		return false;
+	}
+	kfree_data(m, 2048);
+	printf("SWEET MPSS: %u: START SCAN sent (passive, %u channels); listening 20 s\n", step, channels);
+	for (uint64_t end = now_us() + 20000000ull; now_us() < end && !wlan_scan_done;) {
+		uint32_t n = wlan_htc_wait(ce, in, sizeof(in), 1, &from);
+
+		if (n != 0) {
+			wlan_wmi_event(in, n);
+		}
+	}
+	printf("SWEET MPSS: %u: %u management frames, %u networks%s\n", step, wlan_beacons, wlan_seen_count,
+	    wlan_scan_done ? "; the scan is over" : "");
+	return wlan_seen_count != 0;
+}
+
+/* ---- step 1: survey -------------------------------------------------------------------------------- */
+
+static bool
+step_survey(void)
+{
+	struct smp2p words;
+	uint32_t size = 0;
+
+	announce("read our partition with the modem in the shared memory, and its items");
+	show_partition();
+	if (dsp_words(&words)) {
+		show_words("the modem's item (435) is there: it has run since the phone was started", &words);
+	} else {
+		printf("SWEET MPSS: %u: the modem's SMP2P item (435) is not there\n", step);
+	}
+	printf("SWEET MPSS: %u: our item (428): %s; GLINK descriptor (478): %s, our queue (479): %s, the modem's (480): %s\n", step,
+	    smem_item(ITEM_SMP2P_OURS, &size) ? "there" : "not there", smem_item(478, &size) ? "there" : "not there",
+	    smem_item(479, &size) ? "there" : "not there", smem_item(480, &size) ? "there" : "not there (the modem makes it)");
+	show_crash_reason();
+	return smem_partition(SMEM_US, SMEM_MPSS, &size, &size) != 0;
+}
+
+/* ---- the steps, and bring-up ----------------------------------------------------------------------- */
+
+#define STEPS                   15
+static bool (*const steps[STEPS])(void) = {
+	step_survey, step_firmware, step_header, step_image, step_our_item, step_start, step_link, step_qrtr, step_wlfw,
+	step_smmu, step_wlan, step_htc, step_wmi, step_init, step_scan,
+};
+
+static bool keep;
+static uint32_t last_step = STEPS;
+
+static void
+run_steps(void)
+{
+	uint32_t done = 0;
+
+	for (step = 1; step <= last_step; step++) {
+		if (!steps[step - 1]()) {
+			printf("SWEET MPSS: step %u: FAILED; the steps after it are not attempted\n", step);
+			break;
+		}
+		printf("SWEET MPSS: step %u: done\n", step);
+		done = step;
+	}
+	step = done;
+	if (dsp_started && !(done == last_step && (keep || last_step == STEPS))) {
+		dsp_shutdown("the steps are over");
+	} else if (dsp_started) {
+		printf("SWEET MPSS: THE MODEM STAYS ON%s\n", link_runs ? ", and the link with it" : "");
+	}
+	printf("SWEET MPSS: over after step %u\n", done);
+}
+
+static void
+mpss_thread(__unused void *arg, __unused wait_result_t result)
+{
+	uint32_t delay_s = 20;
+	unsigned services = 0;
+
+	PE_parse_boot_argn("sweetmpssdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET MPSS: the modem is brought up in %u s (steps up to %u)\n", delay_s, last_step);
+	sleep_ms(delay_s * 1000u);
+	/* the firmware is on the root, which may not be mounted yet: a minute at most */
+	for (unsigned waited = 0; waited < 300 && rootvnode == NULLVP; waited++) {
+		sleep_ms(200);
+	}
+	if (rootvnode == NULLVP) {
+		printf("SWEET MPSS: no root file system within a minute: the modem is not brought up\n");
+	} else {
+		run_steps();
+	}
+	if (step == STEPS && dsp_started) {
+		lck_mtx_lock(&qrtr_lock);
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			services += qrtr_servers[i].there;
+		}
+		lck_mtx_unlock(&qrtr_lock);
+		printf("SWEET MPSS: THE MODEM IS UP AND LINKED: node %u, %u services; it stays on\n", qrtr_peer, services);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_mpss_init(void)
+{
+	static bool started;
+	uint32_t on = 0, want_step = 0;
+	thread_t thread;
+
+	if (started) {
+		return;
+	}
+	PE_parse_boot_argn("sweetmpssstep", &want_step, sizeof(want_step));
+	if (want_step == 0 && (!PE_parse_boot_argn("sweetmpss", &on, sizeof(on)) || on == 0)) {
+		return;
+	}
+	started = true;
+	if (want_step != 0) {
+		last_step = want_step > STEPS ? STEPS : want_step;
+		keep = option("modem_keep");
+	} else {
+		last_step = STEPS;
+		keep = true;
+	}
+	if (kernel_thread_start(mpss_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
