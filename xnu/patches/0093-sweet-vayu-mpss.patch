+/*
+ * Rails (ARC, type 3) at a voltage level or above, one active-only request (sweet_mpss.c: the modem's cx.lvl and
+ * mss.lvl at 385 while it starts - qcom,mss@4080000 in vayu's DT, 384 is HakiOS's SD778G - as the vendor PIL proxy vote;
+ * 0 gives them back). An ARC vote is the index into the rail's level table (cmd-db aux data) of the first level at
+ * least as high as wanted, as the vendor rpmh-regulator picks it.
+ */
+int
+sweet_rpmh_arc_vote(const char *const *names, unsigned count, unsigned level)
+{
+	uint32_t addresses[RH_MAX_CMDS], values[RH_MAX_CMDS];
+	if (count == 0 || count > RH_MAX_CMDS) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_poisoned ? EIO : rh_map();
+	for (unsigned i = 0; !error && i < count; ++i) {
+		uint32_t off = 0, len = 0, n = 0, found = ~0u;
+		error = rh_lookup_aux(names[i], 3, &addresses[i], &off, &len);
+		for (; !error && n < len / 2u && found == ~0u; n++) {
+			uint16_t v = rh_db16(off + 2u * n);
+			if (n > 0 && v == 0) {
+				break;                  /* zero padding: the table has ended */
+			}
+			if (v >= level) {
+				found = n;
+			}
+		}
+		if (!error && found == ~0u) {
+			printf("SWEET RPMH: %s has no level %u\n", names[i], level);
+			error = ERANGE;
+		}
+		values[i] = found;
+	}
+	if (!error) {
+		error = rh_send(addresses, values, count, "ARC");
+	}
+	if (error) {
+		printf("SWEET RPMH: ARC vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
 }
 
