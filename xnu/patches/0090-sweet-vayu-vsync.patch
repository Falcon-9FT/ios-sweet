+#define SWEET_WAKE_MAX_TICKS    60      /* display on: wait this long for a new frame before lighting up */
+#define SWEET_BL_FULL           0xfffu
+#define SWEET_BL_LOWEST         48u     /* readable even if a brightness scale is wrong */
+#define SWEET_INTF_BLOCK_PA     0x0ae6b000u     /* page with INTF_1 at +0x800; INTF_2 is the next page */
+#define SWEET_INTF_TIMING_EN    0x000u
+#define SWEET_INTF_HSYNC_CTL    0x008u
