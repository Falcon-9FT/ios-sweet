+/* Find the DSI interface the ABL left scanning, its frame geometry and refresh; else fIntf stays NULL. */
+void
+AppleCLCD::setupVsync(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetfb_vsync", &on, sizeof(on));
+	vm_offset_t block = on ? ml_io_map(SWEET_INTF_BLOCK_PA, 0x2000) : 0;
+	if (block == 0) {
+		return;
+	}
+	volatile uint32_t *intf = NULL;
+	for (uint32_t off = 0x800; off <= 0x1000 && intf == NULL; off += 0x800) {
+		volatile uint32_t *r = (volatile uint32_t *)(block + off);
+		if (r[SWEET_INTF_TIMING_EN / 4] & 1) {
+			intf = r;
+		}
+	}
+	if (intf == NULL) {
+		IOLog("SWEET FB: no DSI timing engine running: free-running vsync timer\n");
+		return;
+	}
+	/*
+	 * The timing registers are in interface clocks whose relation to lines depends on the DSI
+	 * mode: on the phone HSYNC_CTL gave a period of 12 (DSC/widebus), so VSYNC_PERIOD / HSYNC
+	 * is no line count (98394; iOS/runs/ios-smooth1). Lines per frame come from the line
+	 * counter itself (its largest value over two frames), and the active area keeps the
+	 * proportions of DISPLAY_V_START/END to VSYNC_PERIOD.
+	 */
+	uint32_t hsync = intf[SWEET_INTF_HSYNC_CTL / 4];
+	uint32_t vperiod = intf[SWEET_INTF_VSYNC_PERIOD / 4];
+	uint32_t vstart = intf[SWEET_INTF_V_START / 4], vend = intf[SWEET_INTF_V_END / 4];
+	if (vperiod == 0 || vend <= vstart || vend >= vperiod) {
+		IOLog("SWEET FB: DSI timing registers hsync %#x vsync period %u active %u..%u: free-running vsync timer\n",
+		    hsync, vperiod, vstart, vend);
+		return;
+	}
+	if ((intf[SWEET_INTF_COUNT_EN / 4] & 3) != 3) {
+		intf[SWEET_INTF_COUNT_EN / 4] = 3;      /* sde_hw_intf_enable_timing: frame and line counters */
+		IODelay(50000);
+	}
+	uint32_t f0 = intf[SWEET_INTF_FRAME_COUNT / 4];
+	uint64_t t0 = mach_absolute_time();
+	IOSleep(200);
+	uint32_t f1 = intf[SWEET_INTF_FRAME_COUNT / 4];
+	uint64_t t1 = mach_absolute_time(), ns = 0;
+	uint32_t frames = f1 - f0;
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	uint32_t mhz = frames ? (uint32_t)(frames * 1000000000ull * 1000 / ns) : 0;        /* refresh in mHz */
+	uint32_t vtotal = 0;
+	if (frames != 0) {
+		uint64_t end = mach_absolute_time() + 2 * (t1 - t0) / frames;
+		while (mach_absolute_time() < end) {
+			uint32_t l = intf[SWEET_INTF_LINE_COUNT / 4];
+			vtotal = l > vtotal ? l : vtotal;
+		}
+		vtotal++;
+	}
+	IOLog("SWEET FB: DSI interface at %#x: hsync %#x, vsync period %u, active %u..%u; %u frames in %llu us "
+	    "(%u.%03u Hz), %u lines (line counter maximum + 1)\n", SWEET_INTF_BLOCK_PA + (uint32_t)((vm_offset_t)intf - block),
+	    hsync, vperiod, vstart, vend, frames, ns / 1000, mhz / 1000, mhz % 1000, vtotal);
+	if (vtotal < fHeight || vtotal > 2 * fHeight || mhz < 20000 || mhz > 150000) {
+		IOLog("SWEET FB: implausible timing: free-running vsync timer\n");
+		return;
+	}
+	fVTotal = vtotal;
+	fActStart = (uint32_t)((uint64_t)vstart * vtotal / vperiod);
+	fActEnd = (uint32_t)(((uint64_t)vend + 1) * vtotal / vperiod);
+	fLineAbs = (t1 - t0) / frames / vtotal;
+	fFrameDiv = (mhz + 30000) / 60000;     /* about 60 Hz for CoreAnimation: 124 Hz panel -> every 2nd frame */
+	fFrameDiv = fFrameDiv ? fFrameDiv : 1;
+	IOLog("SWEET FB: vsync on the panel: active lines %u..%u of %u, a tick every %u frame(s)\n", fActStart, fActEnd,
+	    fVTotal, fFrameDiv);
+	fIntf = intf;
+}
+
+/*
+ * True once the scan is in vertical blanking: spins if that is near, false if this tick came
+ * late and the blanking has passed (no waiting through a whole frame; the copy waits a tick).
+ */
+bool
+AppleCLCD::waitBlank(void)
+{
+	uint32_t l = line();
+	uint64_t spin;
+	nanoseconds_to_absolutetime(SWEET_VSYNC_SPIN_US * 1000ull, &spin);
+	if (inBlank(l)) {
+		return true;
+	}
+	if ((uint64_t)(fActEnd - l) * fLineAbs > spin) {
+		return false;
+	}
+	uint64_t end = mach_absolute_time() + spin;
+	while (!inBlank(line())) {
+		if (mach_absolute_time() > end) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* The next tick: at the start of the coming blanking (a little early), else 60 Hz. */
+void
+AppleCLCD::scheduleNext(IOTimerEventSource *sender)
+{
+	if (fIntf == NULL) {
+		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+		return;
+	}
+	uint32_t l = line();
+	uint32_t lines = (fActEnd + fVTotal - l) % fVTotal;
+	uint64_t wait = (uint64_t)lines * fLineAbs, early, minimum;
+	nanoseconds_to_absolutetime(SWEET_VSYNC_EARLY_US * 1000ull, &early);
+	nanoseconds_to_absolutetime(SWEET_VSYNC_SPIN_US * 1000ull, &minimum);
+	if (wait < minimum) {
+		wait += (uint64_t)fVTotal * fLineAbs;   /* this blanking is (nearly) here: aim at the next */
+	}
+	wait += (uint64_t)(fFrameDiv - 1) * fVTotal * fLineAbs;
+	AbsoluteTime interval, leeway;
+	interval = wait - early;
+	nanoseconds_to_absolutetime(100 * 1000ull, &leeway);
+	sender->setTimeout(kIOTimeOptionsWithLeeway, interval, leeway);
+}
