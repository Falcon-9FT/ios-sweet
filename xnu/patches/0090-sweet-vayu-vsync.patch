+/*
+ * The brightness slider: CoreBrightness (CBDisplayContaineriOS, iOS 16.7) drives an LCD's
+ * backlight through the IOService of class AppleARMBacklight - backboardd looks it up by
+ * IOPropertyMatch {backlight-control = true}; without one the slider is inert. It reads
+ * IODisplayParameters {brightness {min, max, value}} and sets the level through
+ * setProperties. Which keys it sends is not known yet: every call is logged (first ones in
+ * full) and a "brightness" number, top level or inside IODisplayParameters (also as
+ * {value}), sets the WLED level in proportion to max.
+ */
+#define SWEET_ARMBL_MAX         65536u
+
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+public:
+	AppleCLCD *fFB;
+	uint32_t   fCalls;
+
+	void publishValue(uint32_t value);
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+void
+AppleARMBacklight::publishValue(uint32_t value)
+{
+	OSDictionary *params = OSDictionary::withCapacity(1);
+	OSDictionary *bright = OSDictionary::withCapacity(3);
+	OSNumber *min = OSNumber::withNumber(0ULL, 32);
+	OSNumber *max = OSNumber::withNumber(SWEET_ARMBL_MAX, 32);
+	OSNumber *val = OSNumber::withNumber(value, 32);
+	if (params != NULL && bright != NULL && min != NULL && max != NULL && val != NULL) {
+		bright->setObject("min", min);
+		bright->setObject("max", max);
+		bright->setObject("value", val);
+		params->setObject("brightness", bright);
+		setProperty("IODisplayParameters", params);
+	}
+	OSSafeReleaseNULL(params);
+	OSSafeReleaseNULL(bright);
+	OSSafeReleaseNULL(min);
+	OSSafeReleaseNULL(max);
+	OSSafeReleaseNULL(val);
+}
+
+/* A number, or the "value" of a {min, max, value} dictionary; false if neither. */
+static bool
+sweet_armbl_number(OSObject *o, uint64_t *out)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, o);
+	if (d != NULL) {
+		o = d->getObject("value");
+	}
+	OSNumber *n = OSDynamicCast(OSNumber, o);
+	if (n == NULL) {
+		return false;
+	}
+	*out = n->unsigned64BitValue();
+	return true;
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	uint32_t call = ++fCalls;
+	if (call <= 12 || (call % 200) == 0) {
+		OSSerialize *s = OSSerialize::withCapacity(512);
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		if (s != NULL && properties->serialize(s)) {
+			IOLog("SWEET BL: %s setProperties #%u %.900s\n", name, call, s->text());
+		}
+		OSSafeReleaseNULL(s);
+	}
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	uint64_t v;
+	OSDictionary *params = OSDynamicCast(OSDictionary, dict->getObject("IODisplayParameters"));
+	bool found = sweet_armbl_number(dict->getObject("brightness"), &v) ||
+	    (params != NULL && sweet_armbl_number(params->getObject("brightness"), &v));
+	if (!found) {
+		return kIOReturnSuccess;
+	}
+	if (v > SWEET_ARMBL_MAX) {
+		v = SWEET_ARMBL_MAX;
+	}
+	uint32_t level = (uint32_t)(v * SWEET_BL_FULL / SWEET_ARMBL_MAX);
+	fFB->setBacklightTarget(level < SWEET_BL_LOWEST ? SWEET_BL_LOWEST : level);
+	publishValue((uint32_t)v);
+	return kIOReturnSuccess;
+}
+
+void
+AppleCLCD::publishBacklight(void)
+{
+	AppleARMBacklight *bl = OSTypeAlloc(AppleARMBacklight);
+	if (bl == NULL || !bl->init()) {
+		OSSafeReleaseNULL(bl);
+		return;
+	}
+	bl->fFB = this;
+	bl->setProperty("backlight-control", true);
+	bl->publishValue(fBlTarget * SWEET_ARMBL_MAX / SWEET_BL_FULL);
+	if (!bl->attach(this)) {
+		bl->release();
+		return;
+	}
+	bl->registerService();
+	bl->release();
+	IOLog("SWEET BL: AppleARMBacklight published, level %u of %u\n", fBlTarget, SWEET_BL_FULL);
+}
+
+void
+AppleCLCD::setBacklightTarget(uint32_t level)
+{
+	IOLockLock(fLock);
+	bool changed = level != fBlTarget;
+	fBlTarget = level;
+	IOLockUnlock(fLock);
+	static uint32_t logged;
+	if (changed && logged < 40) {
+		logged++;
+		IOLog("SWEET BL: slider -> backlight %u of %u\n", level, SWEET_BL_FULL);
+	}
+}
