+/*
+ * vayu: the vsync timer follows the panel. The ABL leaves a DSI video-mode interface running
+ * that reads this framebuffer by itself; a copy at a random moment of its scan shows a tear
+ * (half old, half new frame). Its timing engine (SDE INTF, dt qcom,mdss_mdp@ae00000
+ * qcom,sde-intf-off 0x6b800 / 0x6c000 for the two DSI ports; registers as kernel
+ * sde_hw_intf.c) counts the lines of each frame from the vsync pulse: the active area is
+ * [DISPLAY_V_START, DISPLAY_V_END] in pixel clocks / HSYNC period. The timer is aimed at the
+ * start of vertical blanking and, before a panel copy, waits there by the line counter: the copy
+ * (a few ms) then runs ahead of the scan (16.7 ms at 60 Hz) and the panel never shows a tear.
+ * CoreAnimation's vsync notification is sent at the same moment. Boot-arg sweetfb_vsync=0 keeps
+ * the free-running 60 Hz timer; without a running interface it is kept too.
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+#define SWEET_INTF_BLOCK_PA     0x0ae6b000u     /* page with INTF_1 at +0x800; INTF_2 is the next page */
+#define SWEET_INTF_TIMING_EN    0x000u
+#define SWEET_INTF_HSYNC_CTL    0x008u
+#define SWEET_INTF_VSYNC_PERIOD 0x00cu
+#define SWEET_INTF_V_START      0x01cu
+#define SWEET_INTF_V_END        0x024u
+#define SWEET_INTF_COUNT_EN     0x0a8u
+#define SWEET_INTF_FRAME_COUNT  0x0acu
+#define SWEET_INTF_LINE_COUNT   0x0b0u
+#define SWEET_VSYNC_SPIN_US     1500    /* closer than this to blanking: wait by spinning */
+#define SWEET_VSYNC_EARLY_US    300     /* timer aimed this much before blanking */
+
